  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90a728ace85ca1349a4e4570aaccdea8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::vc_TownStage
  stageId: highschool
  stageTitle: High School
  introLine: You're in high school now, and the town is busier than ever. Look for
    people with a ! - they could use your help.
  completeLine: The whole town knows your name now. The dreams are getting sharper...
    college is next.
  nightDreams:
  - You dream of the town square, but the buildings are leaning, and the river is
    far too high.
  - The shadowy figure is closer tonight. "You're getting stronger," it says. "Keep
    going."
  - In the dream you see your friends, helping each other carry things to higher
    ground.
  questsPerDay: 4
  daysPerStage: 4
  extraRequestsPerDay: 1
  playerSpawn: {fileID: 745351462}
  requestSpot: {fileID: 701958937}
  requestSpacing: 1.6
  questArea: {fileID: 2084402998}
