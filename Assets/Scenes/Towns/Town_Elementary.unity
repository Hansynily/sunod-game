  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::vc_TownStage
  stageId: elementary
  stageTitle: Elementary
  introLine: You're in grade school now. People around the neighborhood need a hand
    - look for anyone with a ! above their head.
  completeLine: You helped the whole neighborhood! The years go by, and high school
    is next.
  nightDreams:
  - You dream of your house again - the roof torn open, the street empty. It feels
    far away... for now.
  - In the dream, the shadowy figure points at the sky. "Learn," it says. "Learn
    everything you can."
  - Tonight the dream is quiet. Just the sound of wind, and a clock ticking somewhere.
  questsPerDay: 4
  daysPerStage: 4
  extraRequestsPerDay: 1
