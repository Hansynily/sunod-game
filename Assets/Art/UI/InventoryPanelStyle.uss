/* =================================================================
   SUNOD — Skill Equip Screen
   Navy + gold palette — matches MainMenu. Dark base, gold accents,
   white text. Pixel-readable throughout.
   ================================================================= */

/* ---------- BACKDROP ---------- */
.overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(4, 8, 20, 0.80);
    align-items: center;
    justify-content: center;
}

/* ---------- OUTER FRAME ---------- */
.panel-root {
    width: 92%;
    max-width: 1100px;
    height: 960px;
    background-color: rgb(10, 14, 30);
    border-color: rgb(201, 151, 59);
    border-width: 4px;
    padding: 4px;
}

/* ---------- INNER WELL ---------- */
.panel-inner {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(14, 20, 42);
    border-color: rgb(30, 42, 80);
    border-width: 2px;
    padding: 12px;
}

/* ---------- TOP BAR ---------- */
.topbar {
    flex-direction: row;
    align-items: center;
    height: 68px;
    flex-shrink: 0;
    background-color: rgb(18, 26, 56);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 8px;
    padding: 0 14px;
    margin-bottom: 10px;
}

.btn-back {
    background-color: rgb(38, 54, 88);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 8px;
    padding: 10px 20px;
    min-width: 100px;
    transition-property: background-color;
    transition-duration: 0.12s;
}
.btn-back:hover { background-color: rgb(52, 72, 112); }
.btn-back:active { background-color: rgb(26, 38, 68); }
.btn-back-label {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 17px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.title-block {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
.panel-title {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 22px;
    color: rgb(245, 168, 35);
    -unity-text-align: middle-center;
    letter-spacing: 6px;
}
.panel-sub {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
    font-size: 13px;
    color: rgb(140, 110, 58);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.btn-cheat {
    background-color: rgb(38, 54, 88);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 8px;
    padding: 10px 16px;
    min-width: 100px;
    transition-property: background-color;
    transition-duration: 0.12s;
}
.btn-cheat:hover { background-color: rgb(52, 72, 112); }
.btn-cheat:active { background-color: rgb(26, 38, 68); }
.btn-cheat-label {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 14px;
    color: rgb(245, 168, 35);
    -unity-text-align: middle-center;
}

/* ---------- SECTION DIVIDER ---------- */
.section-divider {
    height: 2px;
    background-color: rgb(201, 151, 59);
    opacity: 0.35;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

/* ---------- SKILL GRID BODY ---------- */
.body {
    flex-grow: 1;
    flex-direction: column;
    min-height: 280px;
}

.pane-header {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 14px;
    color: rgb(245, 168, 35);
    background-color: rgb(18, 26, 56);
    -unity-text-align: middle-left;
    padding: 8px 14px;
    letter-spacing: 4px;
    border-left-color: rgb(201, 151, 59);
    border-left-width: 4px;
    border-bottom-color: rgb(30, 42, 80);
    border-bottom-width: 2px;
    flex-shrink: 0;
}

.cards-scroll {
    flex-grow: 1;
    padding: 6px;
    background-color: rgb(12, 18, 38);
}

/* Force flex-wrap — descendant selector, content container is nested deep */
.cards-scroll #unity-content-container,
.cards-scroll .unity-scroll-view__content-container {
    flex-wrap: wrap;
    flex-direction: row;
    padding: 4px;
    align-content: flex-start;
}

/* ---------- SKILL CARD (grid item) ---------- */
.skill-row {
    width: 172px;
    margin: 6px;
    height: 132px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(22, 32, 64);
    border-color: rgb(38, 54, 96);
    border-width: 2px;
    border-radius: 6px;
    padding: 8px 6px 6px 6px;
    transition-property: background-color;
    transition-duration: 0.10s;
}
.skill-row:hover {
    background-color: rgb(32, 46, 84);
}
.skill-row.selected {
    background-color: rgb(30, 44, 78);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
}

.row-icon-frame {
    width: 72px;
    height: 72px;
    background-color: rgb(10, 14, 30);
    border-color: rgb(38, 54, 96);
    border-width: 2px;
    border-radius: 4px;
    margin-bottom: 6px;
}
.row-icon {
    position: absolute;
    top: 2px; left: 2px; right: 2px; bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.row-textblock {
    align-items: center;
    flex-direction: column;
    justify-content: center;
}
.row-name {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 12px;
    color: rgb(210, 210, 230);
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
}
.row-meta {
    display: none;
}

/* RIASEC corner badge */
.row-tag {
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 3px;
    right: 3px;
    border-radius: 3px;
}
.row-tag-letter {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 12px;
    color: white;
    -unity-text-align: middle-center;
}

/* RIASEC — vivid against dark navy */
.riasec-r { background-color: rgb(200, 50, 38); }
.riasec-i { background-color: rgb(40, 100, 200); }
.riasec-a { background-color: rgb(140, 50, 200); }
.riasec-s { background-color: rgb(38, 160, 56); }
.riasec-e { background-color: rgb(200, 158, 20); }
.riasec-c { background-color: rgb(28, 165, 165); }

/* ---------- DETAIL PANE (full-width bottom) ---------- */
.detail-pane {
    background-color: rgb(18, 26, 56);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 6px;
    padding: 14px 18px;
    height: 220px;
    flex-shrink: 0;
    flex-direction: column;
}

/* Empty state */
.detail-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    flex-direction: row;
}
.detail-empty-title {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 16px;
    color: rgb(80, 96, 140);
    letter-spacing: 3px;
    margin-right: 16px;
}
.detail-empty-sub {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
    font-size: 15px;
    color: rgb(60, 76, 112);
}

/* Filled state */
.detail-filled {
    flex-grow: 1;
    flex-direction: column;
}

.detail-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.detail-icon-frame {
    width: 72px;
    height: 72px;
    background-color: rgb(10, 14, 30);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 5px;
    margin-right: 16px;
    flex-shrink: 0;
}
.detail-icon {
    position: absolute;
    top: 4px; left: 4px; right: 4px; bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.detail-titlebox {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}
.detail-name {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    white-space: normal;
    margin-bottom: 6px;
}
.detail-meta {
    flex-direction: row;
    align-items: center;
}
.detail-tag {
    flex-direction: row;
    align-items: center;
    padding: 3px 10px 3px 7px;
    margin-right: 10px;
    border-radius: 4px;
}
.detail-tag-letter {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 16px;
    color: white;
    margin-right: 5px;
}
.detail-tag-name {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 11px;
    color: white;
    letter-spacing: 1px;
}
.detail-level {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
    font-size: 15px;
    color: rgb(245, 168, 35);
    background-color: rgb(10, 14, 30);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 4px;
    padding: 3px 10px;
}

.detail-divider {
    height: 1px;
    background-color: rgb(201, 151, 59);
    opacity: 0.4;
    margin-bottom: 10px;
}

/* Two-column row for description + action */
.detail-body-row {
    flex-direction: row;
    flex-grow: 1;
    margin-bottom: 8px;
}
.detail-desc-block {
    flex-grow: 1;
    flex-direction: column;
    margin-right: 14px;
}
.detail-action-block {
    flex-grow: 1;
    flex-direction: column;
}

.detail-section-label {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 11px;
    color: rgb(140, 110, 58);
    letter-spacing: 3px;
    margin-bottom: 4px;
}
.detail-desc {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
    font-size: 14px;
    color: rgb(210, 210, 230);
    white-space: normal;
    overflow: hidden;
}
.detail-action {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
    font-size: 14px;
    color: rgb(210, 210, 230);
    background-color: rgb(12, 18, 38);
    border-left-color: rgb(245, 168, 35);
    border-left-width: 3px;
    border-top-color: rgb(30, 42, 80);
    border-top-width: 2px;
    border-right-color: rgb(30, 42, 80);
    border-right-width: 2px;
    border-bottom-color: rgb(30, 42, 80);
    border-bottom-width: 2px;
    padding: 5px 10px;
    white-space: normal;
    overflow: hidden;
    flex-grow: 1;
}

.detail-hint {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 12px;
    color: rgb(245, 168, 35);
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    border-top-color: rgb(30, 42, 80);
    border-top-width: 2px;
    padding-top: 8px;
    opacity: 0.85;
}

/* ---------- EQUIPPED SECTION (top) ---------- */
.equipped-section {
    background-color: rgb(18, 26, 56);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 6px;
    padding: 10px 16px 18px 16px;
    align-items: center;
    margin-bottom: 0;
    flex-shrink: 0;
}

.equipped-title {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 14px;
    color: rgb(140, 110, 58);
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    margin-bottom: 10px;
}

.slots-row {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

/* Wrapper: column — number badge, diamond container, skill name label */
.slot-wrapper {
    align-items: center;
    justify-content: flex-start;
    flex-direction: column;
    width: 120px;
    margin-left: 16px;
    margin-right: 16px;
}

/* Number badge */
.slot-number {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 14px;
    color: rgb(245, 168, 35);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    background-color: rgb(10, 14, 30);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 4px;
    padding: 3px 10px;
    letter-spacing: 1px;
}

/* Container sized to contain the rotated diamond — 74×√2 ≈ 105px, padded to 110px */
.slot-diamond-container {
    width: 110px;
    height: 110px;
    align-items: center;
    justify-content: center;
}

/* Diamond: 74×74 rotated 45° fits inside 110×110 container */
.slot-frame {
    width: 74px;
    height: 74px;
    rotate: 45deg;
    background-color: rgb(22, 32, 64);
    border-color: rgb(38, 54, 96);
    border-width: 3px;
    border-radius: 4px;
    padding: 0;
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.10s;
}
.slot-frame:hover {
    background-color: rgb(32, 46, 84);
    border-color: rgb(201, 151, 59);
}
.slot-frame:active {
    background-color: rgb(14, 20, 46);
}
.slot-frame.ready {
    background-color: rgb(28, 40, 72);
    border-color: rgb(201, 151, 59);
}

/* Counter-rotate inner content so icon/label stay upright */
.slot-inner {
    rotate: -45deg;
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.slot-frame-icon {
    position: absolute;
    top: 5px; left: 5px; right: 5px; bottom: 5px;
    -unity-background-scale-mode: scale-to-fit;
}
.slot-empty-label {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 22px;
    color: rgb(50, 68, 110);
    -unity-text-align: middle-center;
}

/* Skill name below the diamond — "——" when empty, skill name when equipped */
.slot-name-label {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 12px;
    color: rgb(245, 168, 35);
    -unity-text-align: middle-center;
    margin-top: 6px;
    white-space: nowrap;
    overflow: hidden;
    width: 120px;
}
