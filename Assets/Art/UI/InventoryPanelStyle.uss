/* =================================================================
   SUNOD - Skill equip screen (UI V2, 2026-11-07)
   Sheet / cards / buttons from SunodTheme.tss (sn-scrim, sn-panel, sn-card,
   sn-btn). Kind colours (RIASEC) on rings + strips are set in code from
   vc_UITheme.Riasec; Lv badges are theme sn-badge (silver Lv2, gold Lv3).
   Motion: InventoryPanelUIToolkit.cs (vc_UIAnim).
   ================================================================= */

/* ---------- SCRIM + SHEET ---------- */
.overlay {
    display: none;
}
.panel-root {
    width: 90%;
    max-width: 1040px;
    height: 96%;
    max-height: 900px;
    padding: 0;
}
.panel-inner {
    flex-grow: 1;
    flex-direction: column;
    padding: 10px 20px 16px 20px;
}

/* ---------- TOP BAR: title centred, round × top-right ---------- */
.topbar {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    flex-shrink: 0;
    margin-bottom: 8px;
}
.title-block {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
.panel-title {
    margin: 0;
}
.btn-back {
    margin: 0;
    font-size: 34px;
}
.btn-cheat {
    margin: 0;
    min-width: 72px;
}
.btn-cheat-label {
    font-size: 21px;
    color: var(--sn-ink-muted);
    -unity-text-align: middle-center;
}

.section-divider {
    height: 0;
    margin: 0;
    flex-shrink: 0;
}

/* ---------- EQUIPPED: 6 round kind slots in one row ---------- */
.equipped-section {
    padding: 6px 12px 10px 12px;
    align-items: center;
    margin-bottom: 12px;
    flex-shrink: 0;
}
.equipped-title,
.pane-header {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink-muted);
    letter-spacing: 1px;
}
.equipped-title {
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.slots-grid {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    align-self: stretch;
}
.slots-row {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}
.slot-wrapper {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 156px;
    align-items: center;
    flex-direction: column;
    margin: 0 4px 0 4px;
}

/* kind name above the slot */
.slot-number {
    font-size: 19px;
    color: var(--sn-ink-muted);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    align-self: stretch;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.slot-diamond-container {
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
}

/* round slot: cream disc, kind-coloured ring (ring colour set in code) */
.slot-frame {
    width: 92px;
    height: 92px;
    padding: 0;
    margin: 0;
    background-image: none;
    background-color: var(--sn-cream-lo);
    border-color: var(--sn-brown);
    border-width: 4px;
    border-bottom-width: 7px;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    transition-property: background-color, translate;
    transition-duration: 0.15s;
}
.slot-frame:hover, .slot-frame:focus, .slot-frame:hover:enabled {
    background-color: var(--sn-cream-lo);
}
.slot-frame:active {
    background-color: var(--sn-paper-line);
    translate: 0 3px;
}
/* the slot the picked skill goes in: soft green fill (code also pulses it) */
.slot-frame.ready,
.slot-frame.ready:hover,
.slot-frame.ready:focus {
    background-color: var(--sn-green-hi);
}

.slot-inner {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}
.slot-frame-icon {
    position: absolute;
    top: 14px; left: 14px; right: 14px; bottom: 14px;
    -unity-background-scale-mode: scale-to-fit;
}
.slot-empty-label {
    font-size: 36px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink-muted);
    -unity-text-align: middle-center;
}
/* Lv badge on the slot (built in code) */
.slot-lv {
    position: absolute;
    right: -6px;
    bottom: -4px;
    min-width: 44px;
    height: 28px;
}

.slot-name-label {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    margin-top: 4px;
    align-self: stretch;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------- GATHERED GRID ---------- */
.body {
    flex-grow: 1;
    flex-direction: column;
    min-height: 120px;
    margin-bottom: 12px;
}
.pane-header {
    -unity-text-align: middle-left;
    padding: 0 6px 4px 6px;
    flex-shrink: 0;
}
.cards-scroll {
    flex-grow: 1;
    background-color: var(--sn-cream-lo);
    border-radius: 16px;
    padding: 4px;
}
.cards-scroll #unity-content-container,
.cards-scroll .unity-scroll-view__content-container {
    flex-wrap: wrap;
    flex-direction: row;
    padding: 4px;
    align-content: flex-start;
}

/* skill card: cream tile, kind strip on top, ringed icon disc, name */
.skill-row {
    width: 144px;
    height: 150px;
    margin: 6px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--sn-cream-hi);
    background-image: none;
    border-color: var(--sn-paper-line);
    border-width: 2px;
    border-bottom-width: 5px;
    border-radius: 16px;
    padding: 18px 8px 6px 8px;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.15s;
}
.skill-row.selected {
    background-color: rgb(236, 246, 226);
    border-color: var(--sn-green);
    border-bottom-color: var(--sn-green-dark);
    translate: 0 -4px;
}
/* kind strip (colour set in code) */
.row-strip {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 10px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}

.row-icon-frame {
    width: 72px;
    height: 72px;
    background-color: var(--sn-cream);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 5px;
    border-radius: 999px;
    margin-bottom: 6px;
}
.row-icon {
    position: absolute;
    top: 11px; left: 11px; right: 11px; bottom: 11px;
    -unity-background-scale-mode: scale-to-fit;
}

.row-textblock {
    align-self: stretch;
    align-items: center;
    flex-direction: column;
    justify-content: center;
}
.row-name {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 124px;
}
.row-meta {
    display: none;
}

/* kind letter disc, top-left (letter = the non-colour signal) */
.row-tag {
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 14px;
    left: 8px;
    border-radius: 999px;
    border-width: 2px;
    border-color: var(--sn-cream-hi);
}
.row-tag-letter {
    font-size: 18px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-cream-hi);
    -unity-text-align: middle-center;
    padding: 0;
}
/* Lv badge, top-right */
.row-lv {
    position: absolute;
    top: 14px;
    right: 6px;
    height: 26px;
}

/* RIASEC colours */
.riasec-r { background-color: var(--sn-R); }
.riasec-i { background-color: var(--sn-I); }
.riasec-a { background-color: var(--sn-A); }
.riasec-s { background-color: var(--sn-S); }
.riasec-e { background-color: var(--sn-E); }
.riasec-c { background-color: var(--sn-C); }

/* ---------- DETAIL STRIP ---------- */
.detail-pane {
    height: 136px;
    padding: 10px 16px 10px 16px;
    flex-shrink: 0;
    flex-direction: column;
}

.detail-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}
.detail-empty-title {
    font-size: 26px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    margin-bottom: 2px;
}
.detail-empty-sub {
    font-size: 21px;
    color: var(--sn-ink-muted);
}

.detail-filled {
    flex-grow: 1;
    flex-direction: row;
}
.detail-header {
    flex-direction: row;
    align-items: center;
    width: 44%;
    flex-shrink: 0;
    margin-right: 16px;
}
.detail-icon-frame {
    width: 88px;
    height: 88px;
    background-color: var(--sn-cream);
    border-color: var(--sn-brown);
    border-width: 4px;
    border-bottom-width: 7px;
    border-radius: 999px;
    margin-right: 14px;
    flex-shrink: 0;
}
.detail-icon {
    position: absolute;
    top: 14px; left: 14px; right: 14px; bottom: 14px;
    -unity-background-scale-mode: scale-to-fit;
}
.detail-titlebox {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
}
.detail-name {
    font-size: 28px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
    white-space: normal;
    margin-bottom: 4px;
}
.detail-meta {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}
/* kind chip (colour from riasec-* class) */
.detail-tag {
    flex-direction: row;
    align-items: center;
    padding: 0 12px 0 10px;
    margin-right: 8px;
    min-height: 32px;
    border-radius: 999px;
}
.detail-tag-letter,
.detail-tag-name {
    font-size: 19px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-cream-hi);
    padding: 0;
}
.detail-tag-letter {
    margin-right: 6px;
}
.detail-hint {
    font-size: 19px;
    color: var(--sn-green-dark);
}

.detail-body-row {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    border-left-width: 2px;
    border-color: var(--sn-paper-line);
    padding-left: 16px;
}
.detail-desc-block {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    justify-content: center;
}
.detail-action-block {
    display: none;
}
.detail-section-label {
    font-size: 19px;
    color: var(--sn-ink-muted);
}
.detail-desc,
.detail-action {
    font-size: 22px;
    color: var(--sn-ink);
    white-space: normal;
    overflow: hidden;
    padding: 0;
}
