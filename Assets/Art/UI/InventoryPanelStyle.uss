/* =================================================================
   SUNOD — Skill Equip Screen (cozy / compact)
   Square Sprout Lands palette drawn in USS + SkillSlotUIKit cards.
   Outline #645552 · rim #AA7959 · highlight #F3E5C2 · fill #E8CFA6
   shadow #C49A6C · track #8C7369 · accent #C0D470
   ================================================================= */

/* ---------- BACKDROP ---------- */
.overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(30, 20, 12, 0.7);
    align-items: center;
    justify-content: center;
}

/* ---------- OUTER FRAME ---------- */
.panel-root {
    width: 90%;
    max-width: 1040px;
    height: 90%;
    max-height: 900px;
    background-color: rgb(232, 207, 166);
    border-radius: 0;
    border-left-width: 4px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 8px;
    border-left-color: rgb(170, 121, 89);
    border-top-color: rgb(170, 121, 89);
    border-right-color: rgb(170, 121, 89);
    border-bottom-color: rgb(100, 85, 82);
    padding: 0;
}

.panel-inner {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 14px 18px 16px 18px;
}

/* ---------- TOP BAR ---------- */
.topbar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    flex-shrink: 0;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 0;
    margin-bottom: 10px;
}

.btn-back,
.btn-cheat {
    background-image: none;
    background-color: rgb(243, 229, 194);
    border-radius: 0;
    border-left-width: 3px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 6px;
    border-left-color: rgb(170, 121, 89);
    border-top-color: rgb(170, 121, 89);
    border-right-color: rgb(170, 121, 89);
    border-bottom-color: rgb(100, 85, 82);
    padding: 6px 18px;
    min-width: 96px;
    height: 48px;
    margin: 0;
    justify-content: center;
}
.btn-back:hover, .btn-back:focus,
.btn-cheat:hover, .btn-cheat:focus {
    background-color: rgb(250, 240, 214);
}
.btn-back:active, .btn-cheat:active {
    background-color: rgb(196, 154, 108);
    border-bottom-width: 3px;
    translate: 0 3px;
}
.btn-back-label,
.btn-cheat-label {
    font-size: 16px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
}

.title-block {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
.panel-title {
    font-size: 28px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
    letter-spacing: 3px;
}
.panel-sub {
    font-size: 14px;
    color: rgb(140, 115, 105);
    -unity-text-align: middle-center;
}

.section-divider {
    height: 0;
    margin: 0;
    flex-shrink: 0;
}

/* ---------- EQUIPPED STRIP (all 6 in one row) ---------- */
.equipped-section {
    background-color: rgb(243, 229, 194);
    border-radius: 0;
    border-width: 3px;
    border-color: rgb(196, 154, 108);
    padding: 8px 10px 10px 10px;
    align-items: center;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.equipped-title {
    font-size: 14px;
    color: rgb(140, 115, 105);
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    margin-bottom: 4px;
}

.slots-grid {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}
.slots-row {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin: 0;
}

.slot-wrapper {
    align-items: center;
    flex-direction: column;
    width: 128px;
    margin-left: 6px;
    margin-right: 6px;
}

/* category name, small tag above the card */
.slot-number {
    font-size: 13px;
    color: rgb(100, 85, 82);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    width: 124px;
    padding: 0;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    white-space: nowrap;
    overflow: hidden;
}

.slot-diamond-container {
    width: 104px;
    height: 104px;
    align-items: center;
    justify-content: center;
}

.slot-frame {
    rotate: 0deg;
    width: 104px;
    height: 104px;
    padding: 0;
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_normal.png");
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5px;
    border-width: 0;
    border-radius: 0;
    align-items: center;
    justify-content: center;
}
.slot-frame:hover {
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_hover.png");
}
.slot-frame:active {
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_pressed.png");
}
.slot-frame.ready {
    background-color: rgba(0,0,0,0);
    -unity-background-image-tint-color: rgb(210, 235, 150);
}

.slot-inner {
    rotate: 0deg;
    position: absolute;
    top: 14px; left: 14px; right: 14px; bottom: 14px;
    align-items: center;
    justify-content: center;
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/icon_ring.png");
    -unity-background-scale-mode: scale-to-fit;
}
.slot-frame-icon {
    position: absolute;
    top: 12px; left: 12px; right: 12px; bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
}
.slot-empty-label {
    font-size: 32px;
    color: rgb(140, 115, 105);
    -unity-text-align: middle-center;
}

.slot-name-label {
    font-size: 15px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
    margin-top: 4px;
    white-space: nowrap;
    overflow: hidden;
    width: 124px;
}

/* ---------- GATHERED SKILLS ---------- */
.body {
    flex-grow: 1;
    flex-direction: column;
    min-height: 200px;
    margin-bottom: 10px;
}

.pane-header {
    font-size: 14px;
    color: rgb(140, 115, 105);
    background-color: rgba(0,0,0,0);
    -unity-text-align: middle-left;
    padding: 0 4px 6px 4px;
    letter-spacing: 3px;
    border-width: 0;
    flex-shrink: 0;
}

.cards-scroll {
    flex-grow: 1;
    padding: 4px;
    background-color: rgb(214, 186, 145);
    border-width: 3px;
    border-color: rgb(196, 154, 108);
}

.cards-scroll #unity-content-container,
.cards-scroll .unity-scroll-view__content-container {
    flex-wrap: wrap;
    flex-direction: row;
    padding: 4px;
    align-content: flex-start;
}

.skill-row {
    width: 132px;
    height: 132px;
    margin: 5px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_normal.png");
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5px;
    border-width: 0;
    border-radius: 0;
    padding: 12px 8px 8px 8px;
}
.skill-row:hover {
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_hover.png");
}
.skill-row.selected {
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_pressed.png");
    -unity-background-image-tint-color: rgb(210, 235, 150);
    border-width: 0;
}

.row-icon-frame {
    width: 72px;
    height: 72px;
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/icon_ring.png");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
    margin-bottom: 4px;
}
.row-icon {
    position: absolute;
    top: 12px; left: 12px; right: 12px; bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.row-textblock {
    align-items: center;
    flex-direction: column;
    justify-content: center;
}
.row-name {
    font-size: 15px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
}
.row-meta {
    display: none;
}

/* RIASEC corner badge */
.row-tag {
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 8px;
    right: 8px;
    border-radius: 0;
    border-width: 2px;
    border-color: rgb(100, 85, 82);
}
.row-tag-letter {
    font-size: 13px;
    color: white;
    -unity-text-align: middle-center;
}

/* RIASEC colours (T3) */
.riasec-r { background-color: rgb(217, 58, 74); }
.riasec-i { background-color: rgb(240, 138, 36); }
.riasec-a { background-color: rgb(142, 79, 214); }
.riasec-s { background-color: rgb(47, 163, 90); }
.riasec-e { background-color: rgb(47, 111, 214); }
.riasec-c { background-color: rgb(34, 179, 196); }

/* ---------- DETAIL PANE ---------- */
.detail-pane {
    background-color: rgb(243, 229, 194);
    border-radius: 0;
    border-width: 3px;
    border-color: rgb(196, 154, 108);
    padding: 10px 14px;
    height: 170px;
    flex-shrink: 0;
    flex-direction: column;
}

.detail-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}
.detail-empty-title {
    font-size: 18px;
    color: rgb(140, 115, 105);
    letter-spacing: 2px;
    margin-bottom: 4px;
}
.detail-empty-sub {
    font-size: 14px;
    color: rgb(160, 135, 120);
}

.detail-filled {
    flex-grow: 1;
    flex-direction: column;
}
.detail-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}
.detail-icon-frame {
    width: 56px;
    height: 56px;
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/icon_ring.png");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
    margin-right: 12px;
    flex-shrink: 0;
}
.detail-icon {
    position: absolute;
    top: 9px; left: 9px; right: 9px; bottom: 9px;
    -unity-background-scale-mode: scale-to-fit;
}
.detail-titlebox {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}
.detail-name {
    font-size: 22px;
    color: rgb(72, 52, 34);
    letter-spacing: 1px;
    white-space: normal;
    margin-bottom: 4px;
}
.detail-meta {
    flex-direction: row;
    align-items: center;
}
.detail-tag {
    flex-direction: row;
    align-items: center;
    padding: 2px 8px;
    margin-right: 8px;
    border-radius: 0;
}
.detail-tag-letter {
    font-size: 14px;
    color: white;
    margin-right: 4px;
}
.detail-tag-name {
    font-size: 13px;
    color: white;
}
.detail-level {
    font-size: 14px;
    color: rgb(100, 85, 82);
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/level_badge.png");
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.4px;
    border-width: 0;
    padding: 3px 12px;
}
.detail-divider {
    height: 2px;
    background-color: rgb(196, 154, 108);
    margin-bottom: 6px;
}
.detail-body-row {
    flex-direction: row;
    flex-grow: 1;
}
.detail-desc-block {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    margin-right: 12px;
}
.detail-action-block {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
}
.detail-section-label {
    font-size: 12px;
    color: rgb(140, 115, 105);
    letter-spacing: 2px;
    margin-bottom: 2px;
}
.detail-desc,
.detail-action {
    font-size: 15px;
    color: rgb(72, 52, 34);
    white-space: normal;
    overflow: hidden;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 0;
    flex-grow: 1;
}
.detail-hint {
    font-size: 13px;
    color: rgb(90, 120, 40);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    border-width: 0;
    padding-top: 4px;
}
