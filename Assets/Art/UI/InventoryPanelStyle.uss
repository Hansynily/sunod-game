/* =================================================================
   SUNOD - Skills (inventory), reworked 2026-11-07: classic RPG inventory.
   Bag grid (left) + details card (right) + Equipped hotbar (bottom).
   Classic art (sunken slots, wood hotbar) comes from vc_ClassicSkin;
   these rules are the layout + the Modern look.
   Panel is 720 units tall (1280x720 reference, match height).
   ================================================================= */

.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.panel-root {
    width: 92%;
    max-width: 1180px;
    height: 94%;
    padding: 12px 20px 16px 20px;
}
.panel-inner {
    flex-grow: 1;
    flex-direction: column;
}

/* ---------- header ---------- */
.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    margin-bottom: 8px;
}
.title-block { flex-grow: 1; align-items: center; }
.panel-title { font-size: 38px; }
.btn-cheat { min-width: 96px; margin: 0; }
.btn-cheat-label { font-size: 20px; color: var(--sn-ink-muted); }
.btn-back { margin: 0; font-size: 30px; }

/* ---------- bag + details ---------- */
.inv-main {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}
.inv-bag {
    flex-grow: 1.7;
    flex-basis: 0;
    margin-right: 12px;
    padding: 8px 12px 8px 12px;
    min-height: 0;
}
.pane-header, .equipped-title {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink-muted);
    margin-bottom: 4px;
}
.cards-scroll { flex-grow: 1; min-height: 0; }
.cards-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

/* one Bag tile */
.skill-tile {
    width: 104px;
    margin: 4px 6px 8px 0;
    align-items: center;
}
.tile-frame {
    width: 88px;
    height: 88px;
    align-items: center;
    justify-content: center;
    background-color: var(--sn-cream-lo);
    border-color: var(--sn-paper-line);
    border-width: 3px;
    border-radius: 12px;
}
.skill-tile.selected .tile-frame {
    border-color: var(--sn-green-dark);
    background-color: rgb(220, 240, 208);
}
.tile-icon {
    width: 54px;
    height: 54px;
    -unity-background-scale-mode: scale-to-fit;
}
.tile-letter {
    position: absolute;
    left: 6px;
    top: 2px;
    font-size: 19px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    text-shadow: 1px 1px 0 rgb(255, 252, 242);
}
.tile-lv {
    position: absolute;
    right: -6px;
    bottom: -6px;
    font-size: 15px;
    height: 24px;
}
.tile-name {
    margin-top: 4px;
    font-size: 17px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    -unity-text-align: upper-center;
    white-space: normal;
    width: 104px;
}

/* details */
.detail-pane {
    flex-grow: 1;
    flex-basis: 0;
    padding: 12px 16px 12px 16px;
    min-height: 0;
}
.detail-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
.detail-empty-title { font-size: 28px; -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf"); }
.detail-empty-sub { font-size: 20px; color: var(--sn-ink-muted); margin-top: 6px; }
.detail-filled { flex-grow: 1; display: none; }
.detail-header { flex-direction: row; align-items: center; margin-bottom: 10px; }
.detail-icon-frame {
    width: 84px;
    height: 84px;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    flex-shrink: 0;
    background-color: var(--sn-cream-lo);
    border-color: var(--sn-paper-line);
    border-width: 3px;
    border-radius: 12px;
}
.detail-icon { width: 56px; height: 56px; -unity-background-scale-mode: scale-to-fit; }
.detail-titlebox { flex-shrink: 1; }
.detail-name {
    font-size: 30px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    white-space: normal;
}
.detail-tag { flex-direction: row; align-items: center; margin-top: 4px; }
.detail-tag-letter {
    width: 30px;
    height: 30px;
    font-size: 18px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    -unity-text-align: middle-center;
    color: var(--sn-cream-hi);
    background-color: var(--sn-brown);
    border-radius: 6px;
    margin-right: 8px;
}
.detail-tag.riasec-r .detail-tag-letter { background-color: var(--sn-R); }
.detail-tag.riasec-i .detail-tag-letter { background-color: var(--sn-I); }
.detail-tag.riasec-a .detail-tag-letter { background-color: var(--sn-A); }
.detail-tag.riasec-s .detail-tag-letter { background-color: var(--sn-S); }
.detail-tag.riasec-e .detail-tag-letter { background-color: var(--sn-E); }
.detail-tag.riasec-c .detail-tag-letter { background-color: var(--sn-C); }
.detail-tag-name { font-size: 20px; color: var(--sn-ink-muted); }
.detail-body-row { flex-grow: 1; }
.detail-desc { font-size: 22px; white-space: normal; }
.detail-action-block { display: none; }   /* only repeated the skill name */
.detail-hint {
    font-size: 19px;
    color: var(--sn-gold-dark);
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    margin-top: 6px;
}

/* ---------- Equipped hotbar ---------- */
.equipped-section {
    margin-top: 10px;
    padding: 8px 14px 6px 14px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    background-color: rgb(139, 98, 66);
    border-color: rgb(94, 64, 44);
    border-width: 3px;
    border-bottom-width: 6px;
    border-radius: 14px;
}
.equipped-section .equipped-title {
    color: var(--sn-cream-hi);
    margin: 0 12px 0 4px;
    white-space: nowrap;
    flex-shrink: 0;
}
.slots-grid { flex-grow: 1; }
.slots-row { flex-direction: row; justify-content: space-around; }
.slot-wrapper { align-items: center; }
.slot-diamond-container { width: 84px; height: 84px; }
.slot-frame {
    width: 84px;
    height: 84px;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--sn-cream-lo);
    border-color: rgb(94, 64, 44);
    border-width: 3px;
    border-radius: 12px;
}
.slot-frame:hover:enabled, .slot-frame:focus { background-color: var(--sn-cream); }
.slot-frame.ready {
    border-color: var(--sn-gold-dark);
    background-color: rgb(255, 236, 178);
}
.slot-inner { width: 100%; height: 100%; align-items: center; justify-content: center; }
.slot-frame-icon { width: 52px; height: 52px; -unity-background-scale-mode: scale-to-fit; }
.slot-empty-label { display: none; }
.slot-number {
    position: absolute;
    left: 6px;
    top: 2px;
    font-size: 19px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    text-shadow: 1px 1px 0 rgb(255, 252, 242);
}
.slot-lv {
    position: absolute;
    right: -6px;
    bottom: -6px;
    font-size: 15px;
    height: 24px;
}
.slot-name-label {
    margin-top: 4px;
    font-size: 16px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-cream-hi);
    -unity-text-align: upper-center;
    width: 100px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
