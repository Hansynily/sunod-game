<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="QuestPanelStyle.uss" />

    <!-- UI V2 quest card (top-left): title, divider, current objective with a checkbox. -->
    <ui:VisualElement name="quest-root" class="quest-root" picking-mode="Ignore">

        <ui:VisualElement name="quest-panel" class="quest-panel sn-panel">

            <!-- Header row: counter + title + expand chevron (the whole row toggles the list) -->
            <ui:VisualElement name="quest-header" class="quest-header">
                <ui:VisualElement name="quest-header-text" class="quest-header-text" picking-mode="Ignore">
                    <ui:Label name="quest-counter" text="Quest" class="quest-counter sn-caption" picking-mode="Ignore" />
                    <ui:Label name="quest-title" text="" class="quest-title sn-bold" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="quest-expand-btn" class="quest-expand-btn sn-btn sn-btn--icon-sm" text="">
                    <ui:VisualElement name="quest-chevron" class="quest-chevron" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement name="quest-divider" class="quest-divider sn-divider" picking-mode="Ignore" />

            <!-- Current active objective (always visible): checkbox + text -->
            <ui:VisualElement name="quest-current-row" class="quest-current-row" picking-mode="Ignore">
                <ui:Label name="quest-arrow" text="" class="quest-arrow sn-check" picking-mode="Ignore" />
                <ui:Label name="quest-active-label" text="" class="quest-active-label sn-body" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Expanded objectives list (hidden by default) -->
            <ui:VisualElement name="quest-objectives-list" class="quest-objectives-list" />

            <!-- Feedback toast (hidden by default) -->
            <ui:Label name="quest-feedback" text="" class="quest-feedback" picking-mode="Ignore" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
