/* =================================================================
   SUNOD - Cutscene chrome (UI V2, 2026-11-07)
   Story box = theme sn-panel (cream card, brown outline, thick bottom
   edge); Skip = sn-btn--small. Stage art + timing live in vc_CutscenePlayer.
   ================================================================= */

.cutscene-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(20, 14, 10);
    overflow: hidden;
}

/* Fixed 16:9 cut art. Size is set in code (vc_CutscenePlayer.LayoutStage) so it can be
   scaled-to-fit and centered on any screen ratio. */
.stage {
    position: relative;
    flex-shrink: 0;   /* cover mode: the stage may be bigger than the screen */
    /* layers that slide in (floodwater, rain sheets) stay inside the 16:9 frame */
    overflow: hidden;
}

.fade-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(20, 14, 10);
    opacity: 0;
}

/* ---------- STORY BOX ---------- */
.dialog-box {
    position: absolute;
    left: 48px;
    right: 48px;
    bottom: 32px;
    height: 28%;
    padding: 20px 64px 20px 32px;
    flex-direction: column;
    justify-content: center;
    background-color: rgba(253, 248, 236, 0.97);   /* --sn-cream-hi, a touch see-through */
}

.dialog-text {
    font-size: 30px;
    color: var(--sn-ink);
    white-space: normal;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* "tap to go on": a gold chevron drawn from two borders, bobbed in code (translate) */
.next-indicator {
    position: absolute;
    right: 28px;
    bottom: 22px;
    width: 20px;
    height: 20px;
    padding: 0;
    font-size: 1px;
    color: rgba(0, 0, 0, 0);
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-color: var(--sn-gold-dark);
    rotate: 45deg;
}

.hidden {
    display: none;
}

/* ---------- SKIP ---------- */
.btn-skip {
    position: absolute;
    top: 24px;
    right: 24px;
    margin: 0;
    min-width: 120px;
}
