/* =================================================================
   SUNOD — Intro Cutscene (T24)
   Everything visual besides the stage art comes from the shared
   Sprout Lands theme (SunodTheme.tss, set on this panel's PanelSettings).
   ================================================================= */

.cutscene-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(0, 0, 0);
    overflow: hidden;
}

/* Fixed 16:9 cut art. Size is set in code (vc_CutscenePlayer.LayoutStage) so it can be
   scaled-to-fit and centered on any screen ratio - USS alone can't express "fit inside
   parent, preserve 16:9" reliably across UI Toolkit versions. */
.stage {
    position: relative;
}

.fade-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

/* ---------- DIALOG (Sprout Lands frame, same as the rest of the game) ---------- */
.dialog-box {
    position: absolute;
    left: 48px;
    right: 48px;
    bottom: 48px;
    height: 28%;
    padding: 28px 36px;
    -unity-slice-scale: 2px;
    flex-direction: column;
    justify-content: center;
}

.dialog-text {
    font-size: 28px;
    color: rgb(72, 52, 34);
    white-space: normal;
    flex-grow: 1;
}

.next-indicator {
    position: absolute;
    right: 24px;
    bottom: 16px;
    font-size: 28px;
    color: rgb(72, 52, 34);
}

.hidden {
    display: none;
}

.btn-skip {
    position: absolute;
    top: 32px;
    right: 32px;
    min-width: 0;
    padding: 10px 28px;
}

.btn-skip-label {
    font-size: 20px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
}
