/* =================================================================
   SUNOD — Intro Cutscene (T24)
   Everything visual besides the stage art comes from the shared
   Sprout Lands theme (SunodTheme.tss, set on this panel's PanelSettings).
   ================================================================= */

.cutscene-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(0, 0, 0);
    overflow: hidden;
}

/* Fixed 16:9 cut art. Size is set in code (vc_CutscenePlayer.LayoutStage) so it can be
   scaled-to-fit and centered on any screen ratio - USS alone can't express "fit inside
   parent, preserve 16:9" reliably across UI Toolkit versions. */
.stage {
    position: relative;
}

.fade-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

/* ---------- DIALOG (flat square panel - same look as the Main Menu buttons,
   not the speech-bubble sl_dialog frame) ---------- */
.dialog-box {
    position: absolute;
    left: 48px;
    right: 48px;
    bottom: 48px;
    height: 28%;
    padding: 28px 36px;
    flex-direction: column;
    justify-content: center;
    background-color: rgb(232, 207, 166);
    border-radius: 0;
    border-left-width: 4px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 8px;
    border-left-color: rgb(170, 121, 89);
    border-top-color: rgb(170, 121, 89);
    border-right-color: rgb(170, 121, 89);
    border-bottom-color: rgb(100, 85, 82);
}

/* Mixed-case pixel font for story text (the Sprout Lands UI font is caps-only). */
.dialog-text {
    -unity-font-definition: url("/Assets/Art/Fonts/DotGothic16/DotGothic16-Regular.ttf");
    font-size: 32px;
    color: rgb(60, 54, 66);
    white-space: normal;
    letter-spacing: 1px;
    word-spacing: 4px;
    -unity-paragraph-spacing: 8px;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.next-indicator {
    position: absolute;
    right: 24px;
    bottom: 16px;
    font-size: 28px;
    color: rgb(60, 54, 66);
}

.hidden {
    display: none;
}

.btn-skip {
    position: absolute;
    top: 32px;
    right: 32px;
    min-width: 0;
    padding: 10px 28px;
}

.btn-skip-label {
    font-size: 20px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-center;
}
