/* =====================================================================
   Main menu - UI V2 (2026-11-07). Tokens + sn-* components come from
   SunodTheme.tss (spec: Assets/Art/UI/UI_V2.md). This file is layout plus the
   menu-specific pieces (tiles, player card, progress sheet, settings rows).
   Panel space is 1280x720 (match height), landscape phones.
   Icons: white glyphs in Art/MenuReference/icons, tinted per button variant.
   ===================================================================== */

/* ============================
   Root - animated sky is drawn behind everything by vc_MainMenuBackground
   ============================ */
.root-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    background-color: rgb(143, 199, 232);
    overflow: hidden;
}

.menu-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.menu-hills {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 32%;
    background-image: url("/Assets/Art/UI/Menu/menu_hills.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ============================
   Intro: vc_MainMenuBackground plays each intro-item in with vc_UIAnim.
   Until then they are invisible (no layout change, so nothing jumps).
   ============================ */
.intro-hidden {
    opacity: 0;
}

/* ============================
   Logo (top-centre). Same look as the login screen. MainMenuUIToolkit floats it.
   ============================ */
.left-panel {
    width: 100%;
    flex-direction: column;
    align-items: center;
    padding-top: 40px;
}
.brand-area {
    align-items: center;
}
.brand-banner {
    padding: 0 40px 0 40px;
    align-items: center;
    justify-content: center;
}
.brand-title {
    font-size: 112px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: rgb(244, 196, 80);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(94, 64, 44);
    text-shadow: 0 8px 0 rgb(94, 64, 44);
    -unity-text-align: middle-center;
    letter-spacing: 14px;
    padding: 0;
    margin: 0;
}

/* ============================
   Menu tiles - a row of big rounded buttons standing on the hills.
   Base look = sn-btn (cream); New Game / Continue swap sn-btn--primary in code,
   Go Back uses sn-btn--gold.
   ============================ */
.menu-panel {
    position: absolute;
    bottom: 22%;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.menu-panel .menu-btn {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 224px;
    min-width: 224px;
    height: 164px;
    margin: 0 10px 0 10px;
    padding: 14px 12px 12px 12px;
    border-radius: 32px;
    border-bottom-width: 9px;
}
.menu-panel .menu-btn:active:enabled {
    border-bottom-width: 4px;
}

/* round icon well inside each tile (like the reference skill bubbles) */
.btn-icon-well {
    width: 76px;
    height: 76px;
    margin-bottom: 8px;
    border-radius: 999px;
    background-color: var(--sn-cream-lo);
    border-color: var(--sn-paper-line);
    border-width: 2px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.btn-icon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--sn-ink);
}
.btn-label {
    font-size: 28px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* green (primary) tile */
.sn-btn--primary .btn-icon-well {
    background-color: var(--sn-green-dark);
    border-color: rgb(120, 186, 126);
}
.sn-btn--primary .btn-icon { -unity-background-image-tint-color: var(--sn-cream-hi); }
.sn-btn--primary .btn-label { color: var(--sn-cream-hi); }

/* gold (Go Back) tile */
.sn-btn--gold .btn-icon-well {
    background-color: rgb(255, 228, 150);
    border-color: var(--sn-gold-dark);
}
.sn-btn--gold .btn-icon { -unity-background-image-tint-color: var(--sn-ink); }
.sn-btn--gold .btn-label { color: var(--sn-ink); }

.icon-continue { background-image: url("/Assets/Art/MenuReference/icons/icon_continue.png"); }
.icon-newgame  { background-image: url("/Assets/Art/MenuReference/icons/icon_new_game.png"); }
.icon-tutorial { background-image: url("/Assets/Art/MenuReference/icons/icon_tutorial.png"); }
.icon-stats    { background-image: url("/Assets/Art/MenuReference/icons/icon_progress.png"); }
.icon-goback   { background-image: url("/Assets/Art/UI/Loop/icon_goback.png"); }

/* ============================
   Corner buttons (settings bottom-left, logout bottom-right)
   ============================ */
.root-container .corner-btn {
    position: absolute;
    bottom: 32px;
    margin: 0;
}
.btn-settings {
    left: 32px;
}
.root-container .btn-logout {
    right: 32px;
    padding: 6px 28px 6px 22px;
}
.corner-icon {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--sn-ink);
}
.btn-logout .corner-icon {
    width: 36px;
    height: 36px;
}
.btn-logout-label {
    font-size: 26px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    margin: 0 0 0 10px;
    padding: 0;
}

.icon-settings { background-image: url("/Assets/Art/MenuReference/icons/icon_settings.png"); }
.icon-logout   { background-image: url("/Assets/Art/MenuReference/icons/icon_logout.png"); }

/* ============================
   Player card (top-right): round avatar, "Edit" tag, greeting chip.
   The whole right-panel is the tap target (vc_UIAnim.Press in code).
   ============================ */
.right-panel {
    position: absolute;
    top: 28px;
    right: 32px;
    flex-direction: column;
    align-items: center;
}
.player-card-wrap {
    width: 132px;
    height: 132px;
}
.player-card {
    width: 132px;
    height: 132px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 14px;
    background-color: var(--sn-cream);
    background-image: none;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 7px;
    border-radius: 999px;
}
.player-card-image {
    width: 100%;
    height: 100%;
    background-image: url("/Assets/Art/UI/Menu/avatar_boy.png");
    -unity-background-scale-mode: scale-to-fit;
}
/* follows the character panel (vc_PlayerOptions.UseGirlAvatar) */
.player-card-image--girl {
    background-image: url("/Assets/Art/UI/Menu/avatar_girl.png");
}
.player-card-edit {
    position: absolute;
    right: -6px;
    bottom: 2px;
    font-size: 19px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    padding: 2px 10px 4px 10px;
    background-color: var(--sn-gold);
    background-image: none;
    border-color: var(--sn-gold-dark);
    border-width: 2px;
    border-bottom-width: 4px;
    border-radius: 999px;
}
.username-label {
    font-size: 22px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    margin-top: 10px;
    padding: 6px 18px 8px 18px;
    max-width: 260px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    background-color: var(--sn-cream);
    background-image: none;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 5px;
    border-radius: 999px;
}

/* ============================
   Shared sheet pieces (all overlays are sn-scrim + sn-panel sn-sheet)
   ============================ */
.overlay-root,
.progress-page {
    display: none;
    padding: 24px;
}

.panel-header {
    justify-content: center;
    min-height: 72px;
    flex-shrink: 0;
}
.header-text {
    flex-grow: 1;
    margin: 0 72px 0 72px;
}
/* round close "×" (top-right of every sheet header) */
.panel-header .btn-close {
    position: absolute;
    top: -6px;
    right: -10px;
    margin: 0;
    font-size: 36px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
}

.overlay-root .confirm-box {
    width: 70%;
    max-width: 600px;
    padding: 24px 28px 20px 28px;
    align-items: center;
}
.confirm-title {
    margin-bottom: 12px;
}
.confirm-body {
    font-size: 26px;
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 520px;
    margin-bottom: 20px;
}
/* dialog buttons: secondary/cancel left, main action right */
.confirm-button-row {
    flex-direction: row;
    justify-content: center;
    align-self: stretch;
}

.confirm-button-row .action-btn {
    min-width: 200px;
    margin: 0 8px 0 8px;
}
.action-btn-label {
    font-size: 28px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.sn-btn--primary .action-btn-label,
.sn-btn--danger .action-btn-label { color: var(--sn-cream-hi); }
.sn-btn--ghost .action-btn-label { color: var(--sn-ink-muted); }

/* ============================
   My Progress sheet
   ============================ */
.progress-page .progress-page-inner {
    width: 86%;
    max-width: 1000px;
    max-height: 100%;
    padding: 16px 28px 20px 28px;
    align-items: stretch;
}
/* everything under the header scrolls (current run + all past playthroughs) */
.progress-scroll {
    flex-shrink: 1;
    flex-grow: 1;
}
.progress-scroll #unity-content-container {
    padding-right: 16px;
}
.history-heading {
    font-size: 24px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink-muted);
    margin: 8px 0 8px 4px;
}
.stats-content {
    display: flex;
}
.empty-state-label {
    font-size: 24px;
    color: var(--sn-ink-muted);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 16px 8px 16px 8px;
}

/* status notes: a coloured pill + words, never colour alone */
.run-complete-note,
.provisional-note {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    align-self: center;
    padding: 6px 18px 8px 18px;
    margin: 0 0 12px 0;
    border-width: 2px;
    border-bottom-width: 4px;
    border-radius: 999px;
}
.run-complete-note {
    color: var(--sn-green-dark);
    background-color: var(--sn-green-hi);
    border-color: var(--sn-green);
}
.provisional-note {
    color: var(--sn-ink);
    background-color: rgb(255, 236, 178);
    border-color: var(--sn-gold-dark);
}

/* career hero card */
.stats-content .career-section {
    align-items: center;
    padding: 14px 20px 16px 20px;
    margin-bottom: 12px;
}
.recommended-label {
    font-size: 21px;
    color: var(--sn-ink-muted);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}
.career-name {
    font-size: 36px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 4px;
}
.riasec-note {
    font-size: 21px;
    color: var(--sn-ink-muted);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* four stat tiles in a row */
.stat-grid {
    flex-direction: row;
    margin: 0 -6px 0 -6px;
}
.stat-grid .stat-tile {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 6px 0 6px;
    padding: 12px 8px 12px 8px;
    align-items: center;
    justify-content: center;
}
.stat-grid .stat-tile--gold {
    border-color: var(--sn-gold-dark);
    background-color: rgb(255, 244, 212);
}
.stat-value {
    font-size: 40px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.stat-code {
    color: var(--sn-green-dark);
    letter-spacing: 4px;
}
.stat-gold {
    color: var(--sn-gold-dark);
}
.stat-label {
    font-size: 21px;
    color: var(--sn-ink-muted);
    -unity-text-align: middle-center;
    margin-top: 2px;
}
.stat-source-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 10px;
}
.stat-source-label {
    font-size: 21px;
    color: var(--sn-ink-muted);
    margin-right: 8px;
}
.stat-source-value {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
}

.divider {
    height: 2px;
    flex-shrink: 0;
    background-color: var(--sn-paper-line);
    margin: 16px 0 8px 0;
}

/* past playthroughs (built in code: history-card sn-card) */
.history-list {
    flex-direction: column;
}
.progress-scroll .history-card {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 12px 12px;
    margin-bottom: 8px;
}
.history-index {
    width: 56px;
    height: 56px;
    margin-right: 14px;
    flex-shrink: 0;
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-cream-hi);
    -unity-text-align: middle-center;
    background-color: var(--sn-brown);
    background-image: none;
    border-color: var(--sn-brown-dark);
    border-width: 2px;
    border-bottom-width: 4px;
    border-radius: 999px;
}
.history-body {
    flex-grow: 1;
    flex-shrink: 1;
}
.history-career {
    font-size: 26px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    white-space: normal;
}
.history-sub {
    font-size: 21px;
    color: var(--sn-ink-muted);
    white-space: normal;
    margin-top: 2px;
}
.history-code {
    font-size: 26px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-green-dark);
    letter-spacing: 3px;
    margin-left: 12px;
    padding: 4px 14px 6px 14px;
    flex-shrink: 0;
    background-color: var(--sn-green-hi);
    border-color: var(--sn-green);
    border-width: 2px;
    border-radius: 999px;
}

.error-note {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-red);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 8px;
}

/* ── Loops (MainMenuUIToolkit.Loops): the loops on My Progress ── */
.loops-section {
    flex-direction: column;
}
.loop-tags {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}
.loop-tag-lead {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink-muted);
    margin: 0 8px 8px 4px;
}
/* violet = "remembered / carried over" (vc_UITheme.Violet) */
.loop-tag {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: rgb(76, 50, 140);
    background-color: rgb(232, 224, 255);
    border-color: rgb(150, 110, 255);
    border-width: 2px;
    border-bottom-width: 4px;
    border-radius: 999px;
    padding: 4px 14px 6px 14px;
    margin: 0 8px 8px 0;
}

/* ============================
   Settings / character / privacy sheets
   ============================ */
.overlay-root .settings-box {
    width: 80%;
    max-width: 860px;
    max-height: 100%;
    padding: 16px 32px 20px 32px;
    align-items: stretch;
}
.settings-title {
    margin-bottom: 12px;
}

/* one row = label on the left, control on the right */
.settings-row {
    flex-direction: row;
    align-items: center;
    min-height: 84px;
    margin-bottom: 8px;
    flex-shrink: 0;
}
.settings-label {
    width: 200px;
    flex-shrink: 0;
    font-size: 26px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    margin: 0;
}
.settings-slider {
    flex-grow: 1;
    min-height: 64px;
    margin: 0 12px 0 12px;
}
.settings-slider #unity-drag-container {
    min-height: 64px;
}

/* two-option choice (English / Filipino, Old / New, Boy / Girl). The chosen one gets a
   light-green fill, green outline and bold label (state never shown by colour alone). */
.settings-choice-row {
    flex-direction: row;
    flex-grow: 1;
}
.root-container .settings-choice-btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px 0 6px;
    font-size: 26px;
    -unity-text-align: middle-center;
}
.root-container .settings-choice-btn--on,
.root-container .settings-choice-btn--on:hover:enabled,
.root-container .settings-choice-btn--on:focus {
    background-color: var(--sn-green-hi);
    border-color: var(--sn-green-dark);
    color: var(--sn-green-dark);
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
}
.settings-survey-link {
    flex-grow: 1;
}

/* character sheet */
.overlay-root .settings-box.character-box {
    max-width: 600px;
    align-items: center;
}
.character-stage {
    width: 184px;
    height: 184px;
    padding: 22px;
    margin-bottom: 12px;
    background-color: var(--sn-cream-hi);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 7px;
    border-radius: 999px;
    overflow: hidden;
}
.character-preview {
    flex-grow: 1;
    background-image: url("/Assets/Art/UI/Menu/avatar_boy.png");
    -unity-background-scale-mode: scale-to-fit;
}
.character-preview--girl {
    background-image: url("/Assets/Art/UI/Menu/avatar_girl.png");
}
.character-name {
    font-size: 30px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}
.character-choice-row {
    flex-direction: row;
    align-self: stretch;
    margin-bottom: 16px;
}
.settings-choice-btn.character-choice-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.character-choice-icon {
    width: 52px;
    height: 52px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}
.character-choice-icon--boy { background-image: url("/Assets/Art/UI/Menu/avatar_boy.png"); }
.character-choice-icon--girl { background-image: url("/Assets/Art/UI/Menu/avatar_girl.png"); }
.character-choice-label {
    font-size: 26px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
}
.settings-choice-btn--on .character-choice-label {
    color: var(--sn-green-dark);
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
}

/* privacy notice (first visit per account) */
.overlay-root .privacy-box {
    max-width: 820px;
    width: 84%;
}
.privacy-box .privacy-scroll {
    max-height: 300px;
    flex-shrink: 1;
    margin-bottom: 12px;
    padding: 10px 8px 10px 16px;
}
.privacy-text {
    font-size: 22px;
    color: var(--sn-ink);
    white-space: normal;
    max-width: 700px;
    -unity-text-align: upper-left;
}
.privacy-check {
    margin: 0 0 4px 0;
    align-items: center;
    min-height: 64px;
}
.privacy-check .unity-toggle__input {
    flex-shrink: 0;
    align-items: center;
}
.privacy-check .unity-toggle__text,
.privacy-check .unity-label {
    font-size: 22px;
    color: var(--sn-ink);
    white-space: normal;
    flex-shrink: 1;
    margin-left: 12px;
}
.confirm-button-row .privacy-btn {
    margin: 8px 8px 0 8px;
}
