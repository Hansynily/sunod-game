/* ============================
   Root
   ============================ */
.root-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    background-image: url("../Background/PlainA.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* ============================
   Logout Button (top-right)
   ============================ */
.btn-logout {
    position: absolute;
    top: 36px;
    right: 36px;
    background-color: rgba(22, 32, 58, 0.9);
    border-color: rgb(201, 151, 59);
    border-width: 3px;
    border-radius: 15px;
    padding: 21px 36px;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.btn-logout:hover {
    background-color: rgb(45, 62, 100);
}
.btn-logout-label {
    font-size: 27px;
    color: white;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
}

/* ============================
   Screen Wrapper
   ============================ */
.screen-wrapper {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

/* ============================
   Brand Area
   ============================ */
.brand-area {
    align-items: center;
    margin-bottom: 30px;
}
.brand-title {
    font-size: 126px;
    color: rgb(245, 168, 35);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
    letter-spacing: 9px;
}
.brand-divider {
    font-size: 30px;
    color: rgb(201, 151, 59);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
    margin-top: 6px;
}

/* ============================
   Menu Panel Card
   ============================ */
.menu-panel {
    width: 88%;
    max-width: 780px;
    background-color: rgba(14, 20, 42, 0.95);
    border-color: rgb(201, 151, 59);
    border-width: 4px;
    border-radius: 24px;
    padding: 54px 60px;
    align-items: stretch;
}

/* ============================
   Menu Buttons
   ============================ */
.menu-btn {
    align-items: center;
    justify-content: center;
    height: 108px;
    border-color: rgb(201, 151, 59);
    border-width: 3px;
    border-radius: 18px;
    margin-bottom: 24px;
    padding: 0 30px;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.btn-label {
    font-size: 39px;
    color: white;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
}

.btn-tutorial {
    background-color: rgb(38, 54, 88);
}
.btn-tutorial:hover {
    background-color: rgb(52, 72, 112);
}

.btn-play {
    background-color: rgb(55, 115, 42);
}
.btn-play:hover {
    background-color: rgb(68, 142, 52);
}

.btn-settings {
    background-color: rgb(38, 54, 88);
    margin-bottom: 0;
}
.btn-settings:hover {
    background-color: rgb(52, 72, 112);
}
