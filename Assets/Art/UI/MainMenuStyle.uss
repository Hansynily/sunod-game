/* ============================
   Root
   ============================ */
.root-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    background-image: url("../Background/PlainA.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* ============================
   Logout Button (top-right, matches LoginRegister)
   ============================ */
.btn-logout {
    position: absolute;
    top: 24px;
    right: 24px;
    background-color: rgba(22, 32, 58, 0.9);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 10px;
    padding: 14px 24px;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.btn-logout:hover {
    background-color: rgb(45, 62, 100);
}
.btn-logout-label {
    font-size: 18px;
    color: white;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
}

/* ============================
   Screen Wrapper (same pattern as LoginRegister)
   ============================ */
.screen-wrapper {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

/* ============================
   Brand Area (copied from LoginRegister)
   ============================ */
.brand-area {
    align-items: center;
    margin-bottom: 20px;
}
.brand-title {
    font-size: 84px;
    color: rgb(245, 168, 35);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
    letter-spacing: 6px;
}
.brand-divider {
    font-size: 20px;
    color: rgb(201, 151, 59);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* ============================
   Menu Panel Card (mobile-friendly)
   ============================ */
.menu-panel {
    width: 88%;
    max-width: 520px;
    background-color: rgba(14, 20, 42, 0.95);
    border-color: rgb(201, 151, 59);
    border-width: 3px;
    border-radius: 16px;
    padding: 36px 40px;
    align-items: stretch;
}

/* ============================
   Menu Buttons (shared)
   ============================ */
.menu-btn {
    align-items: center;
    justify-content: center;
    height: 72px;
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 12px;
    margin-bottom: 16px;
    padding: 0 20px;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.btn-label {
    font-size: 26px;
    color: white;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
}

.btn-tutorial {
    background-color: rgb(38, 54, 88);
}
.btn-tutorial:hover {
    background-color: rgb(52, 72, 112);
}

.btn-play {
    background-color: rgb(55, 115, 42);
}
.btn-play:hover {
    background-color: rgb(68, 142, 52);
}

.btn-settings {
    background-color: rgb(38, 54, 88);
    margin-bottom: 0;
}
.btn-settings:hover {
    background-color: rgb(52, 72, 112);
}

