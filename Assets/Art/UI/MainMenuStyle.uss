/* ============================
   Root - animated sky is drawn behind everything by vc_MainMenuBackground
   ============================ */
.root-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    background-color: rgb(47, 111, 176);
    overflow: hidden;
}

.menu-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.menu-hills {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 32%;
    background-image: url("/Assets/Art/UI/Menu/menu_hills.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ============================
   Square pixel buttons (Sprout Lands palette, drawn in USS, no sprite)
   ============================ */
.wood-btn,
.primary-btn {
    background-image: none;
    background-color: rgb(232, 207, 166);
    border-radius: 0;
    border-left-width: 4px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 8px;
    border-left-color: rgb(170, 121, 89);
    border-top-color: rgb(170, 121, 89);
    border-right-color: rgb(170, 121, 89);
    border-bottom-color: rgb(100, 85, 82);
    margin: 0;
}
.primary-btn {
    background-color: rgb(192, 212, 112);
}
.wood-btn:hover, .wood-btn:focus { background-color: rgb(243, 229, 194); }
.primary-btn:hover, .primary-btn:focus { background-color: rgb(210, 226, 140); }
.wood-btn:active {
    background-color: rgb(196, 154, 108);
    border-bottom-width: 4px;
    translate: 0 4px;
}
.primary-btn:active {
    background-color: rgb(160, 184, 90);
    border-bottom-width: 4px;
    translate: 0 4px;
}
.wood-btn:disabled, .primary-btn:disabled {
    background-color: rgb(180, 168, 160);
    border-left-color: rgb(140, 115, 105);
    border-top-color: rgb(140, 115, 105);
    border-right-color: rgb(140, 115, 105);
    border-bottom-color: rgb(100, 85, 82);
    opacity: 1;
}

/* ============================
   Corner buttons (settings bottom-left, logout bottom-right)
   ============================ */
.corner-btn {
    position: absolute;
    bottom: 32px;
    width: 104px;
    min-width: 104px;
    max-width: 104px;
    height: 104px;
    min-height: 104px;
    max-height: 104px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
}
.btn-settings {
    left: 32px;
}
.btn-logout {
    right: 32px;
    width: 104px;
    flex-direction: column;
}
.corner-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(72, 52, 34);
}
.btn-logout .corner-icon {
    width: 40px;
    height: 40px;
}
.btn-logout-label {
    font-size: 14px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.icon-settings { background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Icons/All Icons.png#icon_gear"); }
.icon-logout { background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Icons/All Icons.png#icon_cross"); }

/* ============================
   Brand Area (top-center title banner)
   ============================ */
.left-panel {
    width: 100%;
    height: auto;
    flex-direction: column;
    align-items: center;
    padding-top: 72px;
}
.brand-area {
    align-items: center;
}
.brand-banner {
    padding: 28px 88px;
    align-items: center;
    justify-content: center;
}
.brand-title {
    font-size: 84px;
    color: rgb(90, 62, 38);
    -unity-text-align: middle-center;
    letter-spacing: 10px;
}

/* ============================
   Menu Panel - big row of buttons standing on the hills
   ============================ */
.menu-panel {
    position: absolute;
    bottom: 26%;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.menu-btn {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 272px;
    height: 132px;
    margin-left: 14px;
    margin-right: 14px;
    padding: 10px 12px;
}
.btn-icon {
    width: 52px;
    height: 52px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(72, 52, 34);
}
.btn-label {
    font-size: 28px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
}
.primary-btn .btn-icon { -unity-background-image-tint-color: rgb(40, 80, 30); }
.primary-btn .btn-label { color: rgb(40, 80, 30); }

.menu-btn:disabled .btn-icon { -unity-background-image-tint-color: rgb(150, 130, 120); }
.menu-btn:disabled .btn-label { color: rgb(150, 130, 120); }

.icon-continue { background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Sprite sheet for Basic Pack.png#icon_play_arrow"); }
.icon-newgame { background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Icons/All Icons.png#icon_star"); }
.icon-tutorial { background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Icons/All Icons.png#icon_question"); }
.icon-stats { background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Icons/All Icons.png#icon_trophy"); }

/* ============================
   Right panel - player avatar + greeting, top-right
   ============================ */
.right-panel {
    position: absolute;
    top: 32px;
    right: 32px;
    width: 200px;
    flex-direction: column;
    align-items: center;
}
.player-card {
    width: 168px;
    height: 168px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 18px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Setting menu.png#sl_panel_wood");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 2px;
}
.player-card-image {
    width: 100%;
    height: 100%;
    background-image: url("/Assets/Art/UI/Menu/sunod_avatar.png");
    -unity-background-scale-mode: scale-to-fit;
}
.username-label {
    font-size: 14px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
    margin-top: 10px;
    padding: 10px 16px;
    min-width: 168px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Sprite sheet for Basic Pack.png#sl_slot");
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}

/* ============================
   Intro: elements fly up from the bottom (vc_MainMenuBackground removes intro-hidden, staggered)
   ============================ */
.intro-item {
    transition-property: translate, opacity;
    transition-duration: 0.6s, 0.45s;
    transition-timing-function: ease-out-back, ease-out;
}
.intro-hidden {
    translate: 0 1200px;
    opacity: 0;
}

/* ============================
   Progress page (full-screen "My Progress")
   ============================ */
.progress-page {
    display: none;
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-image: url("/Assets/Art/UI/Menu/menu_sky_bg.png");
    -unity-background-scale-mode: scale-and-crop;
}
.progress-page-inner {
    width: 80%;
    max-width: 700px;
    max-height: 88%;
    padding: 0 48px 36px 48px;
    align-items: stretch;
}
.progress-page-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 24px;
}
.run-complete-note {
    font-size: 15px;
    color: rgb(120, 210, 130);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: rgba(20, 52, 26, 0.6);
    border-color: rgb(201, 151, 59);
    border-width: 1px;
    border-radius: 8px;
    padding: 8px 14px;
    margin-top: 10px;
    margin-bottom: 6px;
}

/* ============================
   Overlay shell (shared by confirm boxes)
   ============================ */
.overlay-root {
    display: none;
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 8, 20, 0.6);
}

.empty-state-label {
    font-size: 18px;
    color: rgb(245, 240, 230);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 20px 10px;
}

.stats-content {
    display: flex;
}

.provisional-note {
    font-size: 14px;
    color: rgb(80, 60, 20);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: rgba(230, 200, 130, 0.6);
    border-color: rgb(201, 151, 59);
    border-width: 1px;
    border-radius: 8px;
    padding: 8px 14px;
    margin-top: 10px;
    margin-bottom: 14px;
}

.error-note {
    font-size: 14px;
    color: rgb(160, 40, 30);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 10px;
}

/* ============================
   Confirm box
   ============================ */
.confirm-box {
    width: 70%;
    max-width: 520px;
    padding: 32px;
    align-items: center;
}
.confirm-title {
    font-size: 28px;
    color: rgb(245, 240, 230);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}
.confirm-body {
    font-size: 16px;
    color: rgb(225, 218, 205);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
}
.confirm-button-row {
    flex-direction: row;
    justify-content: center;
}
.btn-reset-confirm .btn-label,
.btn-reset-confirm .action-btn-label {
    color: rgb(120, 30, 20);
}

/* ============================
   Shared action-button look
   ============================ */
.action-btn {
    align-items: center;
    justify-content: center;
    height: 64px;
    min-width: 180px;
    padding: 0 28px;
    margin-left: 10px;
    margin-right: 10px;
}
.action-btn-label {
    font-size: 14px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
}

/* Header badge + career/stat rows */
.panel-header {
    align-items: center;
    margin-top: -22px;
    margin-left: 80px;
    margin-right: 80px;
    padding: 12px 24px;
    margin-bottom: 20px;
}
.header-text {
    font-size: 20px;
    color: rgb(90, 62, 38);
    -unity-text-align: middle-center;
}
.career-section {
    align-items: center;
    margin-bottom: 10px;
}
.recommended-label {
    font-size: 15px;
    color: rgb(225, 218, 205);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}
.career-name {
    font-size: 28px;
    color: rgb(245, 210, 130);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 6px;
}
.riasec-note {
    font-size: 14px;
    color: rgb(210, 202, 190);
    -unity-text-align: middle-center;
}
.divider {
    height: 2px;
    background-color: rgb(201, 151, 59);
    opacity: 0.4;
    margin-top: 14px;
    margin-bottom: 14px;
}
.stats-section {
    padding: 0 4px;
}
.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    min-height: 32px;
}
.stat-label {
    font-size: 16px;
    color: rgb(210, 202, 190);
    width: 170px;
}
.stat-value {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(245, 240, 230);
}
.stat-gold {
    color: rgb(245, 200, 60);
}
