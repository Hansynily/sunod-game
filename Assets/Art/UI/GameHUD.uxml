<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GameHUDStyle.uss" />

    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement class="hud-bar" picking-mode="Ignore">

            <!-- Mini inventory preview: tap to open full inventory -->
            <ui:Button name="btn-open-inventory" class="inventory-preview-btn">
                <ui:VisualElement class="preview-grid" picking-mode="Ignore">
                    <ui:VisualElement name="preview-0" class="preview-circle" picking-mode="Ignore" />
                    <ui:VisualElement name="preview-1" class="preview-circle" picking-mode="Ignore" />
                    <ui:VisualElement name="preview-2" class="preview-circle" picking-mode="Ignore" />
                    <ui:VisualElement name="preview-3" class="preview-circle" picking-mode="Ignore" />
                    <ui:VisualElement name="preview-4" class="preview-circle" picking-mode="Ignore" />
                    <ui:VisualElement name="preview-5" class="preview-circle" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:Button>

            <!-- 6 skill slot diamonds, 2 rows x 3 (top: R I A, bottom: S E C) -->
            <ui:VisualElement class="skill-slots-grid" picking-mode="Ignore">

                <ui:VisualElement class="skill-slots-row" picking-mode="Ignore">
                    <ui:VisualElement class="slot-wrapper" picking-mode="Ignore">
                        <ui:Label name="slot-category-0" text="" class="slot-category" picking-mode="Ignore" />
                        <ui:VisualElement class="slot-diamond-container" picking-mode="Ignore">
                            <ui:Button name="slot-btn-0" class="skill-slot-btn">
                                <ui:VisualElement class="slot-inner" picking-mode="Ignore">
                                    <ui:VisualElement name="slot-icon-0" class="slot-icon" picking-mode="Ignore" />
                                    <ui:Label name="slot-empty-0" text="+" class="slot-empty-plus" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Label name="slot-level-0" text="" class="slot-level" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="slot-name-0" text="" class="slot-name" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slot-wrapper" picking-mode="Ignore">
                        <ui:Label name="slot-category-1" text="" class="slot-category" picking-mode="Ignore" />
                        <ui:VisualElement class="slot-diamond-container" picking-mode="Ignore">
                            <ui:Button name="slot-btn-1" class="skill-slot-btn">
                                <ui:VisualElement class="slot-inner" picking-mode="Ignore">
                                    <ui:VisualElement name="slot-icon-1" class="slot-icon" picking-mode="Ignore" />
                                    <ui:Label name="slot-empty-1" text="+" class="slot-empty-plus" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Label name="slot-level-1" text="" class="slot-level" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="slot-name-1" text="" class="slot-name" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slot-wrapper" picking-mode="Ignore">
                        <ui:Label name="slot-category-2" text="" class="slot-category" picking-mode="Ignore" />
                        <ui:VisualElement class="slot-diamond-container" picking-mode="Ignore">
                            <ui:Button name="slot-btn-2" class="skill-slot-btn">
                                <ui:VisualElement class="slot-inner" picking-mode="Ignore">
                                    <ui:VisualElement name="slot-icon-2" class="slot-icon" picking-mode="Ignore" />
                                    <ui:Label name="slot-empty-2" text="+" class="slot-empty-plus" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Label name="slot-level-2" text="" class="slot-level" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="slot-name-2" text="" class="slot-name" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="skill-slots-row" picking-mode="Ignore">
                    <ui:VisualElement class="slot-wrapper" picking-mode="Ignore">
                        <ui:Label name="slot-category-3" text="" class="slot-category" picking-mode="Ignore" />
                        <ui:VisualElement class="slot-diamond-container" picking-mode="Ignore">
                            <ui:Button name="slot-btn-3" class="skill-slot-btn">
                                <ui:VisualElement class="slot-inner" picking-mode="Ignore">
                                    <ui:VisualElement name="slot-icon-3" class="slot-icon" picking-mode="Ignore" />
                                    <ui:Label name="slot-empty-3" text="+" class="slot-empty-plus" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Label name="slot-level-3" text="" class="slot-level" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="slot-name-3" text="" class="slot-name" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slot-wrapper" picking-mode="Ignore">
                        <ui:Label name="slot-category-4" text="" class="slot-category" picking-mode="Ignore" />
                        <ui:VisualElement class="slot-diamond-container" picking-mode="Ignore">
                            <ui:Button name="slot-btn-4" class="skill-slot-btn">
                                <ui:VisualElement class="slot-inner" picking-mode="Ignore">
                                    <ui:VisualElement name="slot-icon-4" class="slot-icon" picking-mode="Ignore" />
                                    <ui:Label name="slot-empty-4" text="+" class="slot-empty-plus" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Label name="slot-level-4" text="" class="slot-level" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="slot-name-4" text="" class="slot-name" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slot-wrapper" picking-mode="Ignore">
                        <ui:Label name="slot-category-5" text="" class="slot-category" picking-mode="Ignore" />
                        <ui:VisualElement class="slot-diamond-container" picking-mode="Ignore">
                            <ui:Button name="slot-btn-5" class="skill-slot-btn">
                                <ui:VisualElement class="slot-inner" picking-mode="Ignore">
                                    <ui:VisualElement name="slot-icon-5" class="slot-icon" picking-mode="Ignore" />
                                    <ui:Label name="slot-empty-5" text="+" class="slot-empty-plus" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:Button>
                            <ui:Label name="slot-level-5" text="" class="slot-level" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="slot-name-5" text="" class="slot-name" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
