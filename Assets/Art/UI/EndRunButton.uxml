<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- UI V2: one gold "next stage" pill, bottom-centre. Look from SunodTheme.tss. -->
    <ui:VisualElement name="end-run-root" picking-mode="Ignore" style="position: absolute; bottom: 48px; left: 0; right: 0; align-items: center;">
        <ui:Button name="end-run-btn" class="sn-btn sn-btn--gold" text="End run" style="min-width: 280px; padding: 6px 40px 6px 40px;" />
    </ui:VisualElement>
</ui:UXML>
