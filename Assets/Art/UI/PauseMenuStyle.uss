/* =================================================================
   SUNOD - Pause Menu (UI V2, 2026-11-07)
   Look comes from SunodTheme.tss (sn-scrim / sn-panel / sn-card / sn-btn).
   This file only lays the screen out. Motion: vc_PauseMenu (vc_UIAnim).
   ================================================================= */

.pause-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ---------- HUD PAUSE BUTTON (round, top-right) ---------- */
.pause-hud-btn {
    position: absolute;
    top: 24px;
    right: 24px;
    margin: 0;
}
.pause-icon {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.pause-icon-bar {
    width: 12px;
    height: 36px;
    margin: 0 5px 0 5px;
    background-color: var(--sn-ink);
    border-radius: 4px;
}

/* ---------- SCRIM ---------- */
.pause-overlay {
    display: none;
}

/* ---------- SHEET ---------- */
.pause-box {
    width: 680px;
    flex-direction: column;
    align-items: stretch;
    padding: 16px 24px 20px 24px;
}

.pause-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 72px;
    margin-bottom: 8px;
}
.pause-title {
    flex-grow: 1;
    margin: 0 72px 0 72px;     /* keeps the title centred past the close button */
}
.pause-close-btn {
    position: absolute;
    top: -4px;
    right: -8px;
    margin: 0;
    font-size: 34px;
}

/* save / timer notice: soft pill under the title */
.pause-notice {
    -unity-text-align: middle-center;
    align-self: center;
    background-color: var(--sn-cream-lo);
    border-radius: 999px;
    padding: 4px 18px 4px 18px;
    margin-bottom: 16px;
    color: var(--sn-ink);
}
.pause-notice--warn {
    background-color: rgb(250, 222, 210);
    color: var(--sn-red-dark);
    border-width: 2px;
    border-color: var(--sn-red);
}

/* ---------- SETTINGS CARD ---------- */
.pause-main-btns {
    flex-direction: column;
    align-items: stretch;
}
.pause-settings {
    flex-direction: column;
    align-items: stretch;
    padding: 8px 20px 8px 20px;
    margin-bottom: 16px;
}
.pause-setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 64px;
    border-bottom-width: 2px;
    border-color: var(--sn-paper-line);
}
.pause-setting-row--last {
    border-bottom-width: 0;
}
.pause-setting-label {
    width: 176px;
    flex-shrink: 0;
    font-size: 26px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-left;
}
.pause-slider {
    flex-grow: 1;
    min-height: 56px;
    margin: 0 12px 0 12px;
    justify-content: center;
}

/* English / Filipino segmented choice */
.pause-choice-row {
    flex-grow: 1;
    flex-direction: row;
    margin: 4px 0 4px 0;
}
.pause-choice-btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px 0 4px;
    color: var(--sn-ink-muted);
    background-color: var(--sn-cream-lo);
    border-color: var(--sn-paper-line);
}
.pause-choice-btn:focus {
    background-color: var(--sn-cream-lo);
}
.pause-choice-btn--on {
    color: var(--sn-cream-hi);
    background-color: var(--sn-green);
    border-color: var(--sn-green-dark);
}
.pause-choice-btn--on:hover:enabled, .pause-choice-btn--on:focus {
    background-color: rgb(96, 172, 106);
}

/* ---------- ACTION ROW (primary on the right) ---------- */
.pause-action-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}
.pause-btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 0 0 16px;
}
.pause-btn-exit {
    flex-grow: 0;
    flex-basis: auto;
    min-width: 180px;
    margin-left: 0;
}

/* ---------- INLINE QUIT CONFIRM ---------- */
.pause-confirm {
    flex-direction: column;
    align-items: stretch;
    display: none;
}
.confirm-body {
    -unity-text-align: middle-center;
    max-width: 600px;
    align-self: center;
    margin: 8px 0 24px 0;
}
.confirm-btn-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}
.confirm-btn-no {
    flex-grow: 0;
    flex-basis: auto;
    min-width: 180px;
    margin-left: 0;
}
