/* =================================================================
   SUNOD — Pause Menu
   Sprout Lands wood/cream palette — matches MainMenu, QuestPanel, InventoryPanel.
   ================================================================= */

.pause-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ---------- HUD PAUSE BUTTON (top-right, always visible) ----------
   Big square button with a drawn pause icon (two bars) - the old "||" text was too small
   to read on a phone. Frame comes from the theme's .sl-button. */
.pause-hud-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 84px;
    height: 84px;
    padding: 0;
    align-items: center;
    justify-content: center;
    transition-property: translate, scale;
    transition-duration: 0.08s;
}
.pause-hud-btn:active {
    translate: 0 2px;
    scale: 0.96 0.96;
}

.pause-icon {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 4px;
}
.pause-icon-bar {
    width: 12px;
    height: 34px;
    margin: 0 5px;
    background-color: rgb(72, 52, 34);
    border-width: 2px;
    border-color: rgb(46, 34, 24);
}
/* ---------- DIMMED OVERLAY ---------- */
.pause-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(20, 14, 8, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}

/* ---------- CENTERED CARD (Sprout Lands wood panel) ---------- */
.pause-box {
    min-width: 380px;
    max-width: 460px;
    background-image: url("/Assets/Art/UI/Panels/panel_wood.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 44px 50px 38px 50px;
    flex-direction: column;
    align-items: stretch;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 2px;
}

/* ---------- PAUSED TITLE ---------- */
.pause-title {
    font-size: 32px;
    color: rgb(255, 245, 225);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(46, 34, 24);
    -unity-text-align: upper-center;
    letter-spacing: 6px;
    margin-bottom: 16px;
}

/* ---------- DIVIDER ---------- */
.pause-divider {
    height: 2px;
    background-color: rgb(70, 50, 30);
    opacity: 0.5;
    margin-bottom: 28px;
    flex-shrink: 0;
}

/* ---------- MAIN BUTTONS CONTAINER ---------- */
.pause-main-btns {
    flex-direction: column;
    align-items: stretch;
}

/* ---------- SHARED BUTTON BASE (Sprout Lands wide button) ---------- */
.pause-btn {
    align-items: center;
    justify-content: center;
    height: 72px;
    background-image: url("/Assets/Art/UI/Panels/button_wide.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    margin-bottom: 18px;
    padding: 0 24px;
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 8;
    -unity-slice-top: 6;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}
.pause-btn:active {
    background-image: url("/Assets/Art/UI/Panels/button_wide_pressed.png");
}

/* Resume — tinted green */
.pause-btn-resume {
    -unity-background-image-tint-color: rgb(200, 240, 190);
    color: rgb(40, 80, 30);
}

/* Exit — neutral wood */
.pause-btn-exit {
    color: rgb(72, 52, 34);
    margin-bottom: 0;
}

/* ---------- EXIT CONFIRM PANEL ---------- */
.pause-confirm {
    flex-direction: column;
    align-items: stretch;
    display: none;
}

.confirm-body {
    font-size: 15px;
    color: rgb(90, 70, 50);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 24px;
}

.confirm-btn-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Yes — tinted red/danger */
.confirm-btn-yes {
    -unity-background-image-tint-color: rgb(235, 165, 150);
    color: rgb(90, 20, 12);
    margin-right: 16px;
    flex-grow: 1;
    margin-bottom: 0;
}

/* No — neutral wood */
.confirm-btn-no {
    color: rgb(72, 52, 34);
    flex-grow: 1;
    margin-bottom: 0;
}

/* Neutralise Unity's default button hover/focus/disabled chrome */
.pause-hud-btn:hover, .pause-hud-btn:focus, .pause-hud-btn:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
.pause-btn:hover, .pause-btn:focus, .pause-btn:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}

/* ---------- SETTINGS (inside the pause card) ---------- */
.pause-settings {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 22px;
}
.pause-setting-label {
    font-size: 21px;
    color: rgb(255, 245, 225);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(46, 34, 24);
    margin-bottom: 6px;
}
.pause-slider {
    margin: 0 4px 18px 4px;
}
.pause-slider #unity-tracker {
    height: 12px;
    margin-top: -6px;
    background-color: rgb(72, 50, 36);
    border-width: 2px;
    border-color: rgb(40, 26, 18);
}
.pause-slider #unity-dragger {
    width: 26px;
    height: 30px;
    margin-top: -15px;
    background-color: rgb(255, 214, 120);
    border-width: 3px;
    border-color: rgb(72, 52, 34);
}
.pause-choice-row {
    flex-direction: row;
}
.pause-choice-btn {
    flex-grow: 1;
    height: 52px;
    margin: 0 4px;
    font-size: 21px;
    color: rgb(72, 52, 34);
    opacity: 0.6;
}
.pause-choice-btn--on {
    opacity: 1;
    -unity-background-image-tint-color: rgb(200, 240, 190);
}