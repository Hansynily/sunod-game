/* =================================================================
   SUNOD — Pause Menu
   Sprout Lands wood/cream palette — matches MainMenu, QuestPanel, InventoryPanel.
   ================================================================= */

.pause-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ---------- HUD PAUSE BUTTON (top-right, always visible) ---------- */
.pause-hud-btn {
    position: absolute;
    top: 24px;
    right: 24px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/buttons/Square Buttons 26x26.png#sl_button");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 14px 22px;
    font-size: 18px;
    color: rgb(72, 52, 34);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}
.pause-hud-btn:active {
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/buttons/Square Buttons 26x26.png#sl_button_pressed");
}

/* ---------- DIMMED OVERLAY ---------- */
.pause-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(20, 14, 8, 0.72);
    align-items: center;
    justify-content: center;
    display: none;
}

/* ---------- CENTERED CARD (Sprout Lands wood panel) ---------- */
.pause-box {
    min-width: 380px;
    max-width: 460px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Setting menu.png#sl_panel_wood");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 44px 50px 38px 50px;
    flex-direction: column;
    align-items: stretch;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 2px;
}

/* ---------- PAUSED TITLE ---------- */
.pause-title {
    font-size: 32px;
    color: rgb(255, 245, 225);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(46, 34, 24);
    -unity-text-align: upper-center;
    letter-spacing: 6px;
    margin-bottom: 16px;
}

/* ---------- DIVIDER ---------- */
.pause-divider {
    height: 2px;
    background-color: rgb(70, 50, 30);
    opacity: 0.5;
    margin-bottom: 28px;
    flex-shrink: 0;
}

/* ---------- MAIN BUTTONS CONTAINER ---------- */
.pause-main-btns {
    flex-direction: column;
    align-items: stretch;
}

/* ---------- SHARED BUTTON BASE (Sprout Lands wide button) ---------- */
.pause-btn {
    align-items: center;
    justify-content: center;
    height: 72px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/UI Big Play Button.png#sl_button_wide");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    margin-bottom: 18px;
    padding: 0 24px;
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}
.pause-btn:active {
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/UI Big Play Button.png#sl_button_wide_pressed");
}

/* Resume — tinted green */
.pause-btn-resume {
    -unity-background-image-tint-color: rgb(200, 240, 190);
    color: rgb(40, 80, 30);
}

/* Exit — neutral wood */
.pause-btn-exit {
    color: rgb(72, 52, 34);
    margin-bottom: 0;
}

/* ---------- EXIT CONFIRM PANEL ---------- */
.pause-confirm {
    flex-direction: column;
    align-items: stretch;
    display: none;
}

.confirm-body {
    font-size: 15px;
    color: rgb(90, 70, 50);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 24px;
}

.confirm-btn-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Yes — tinted red/danger */
.confirm-btn-yes {
    -unity-background-image-tint-color: rgb(235, 165, 150);
    color: rgb(90, 20, 12);
    margin-right: 16px;
    flex-grow: 1;
    margin-bottom: 0;
}

/* No — neutral wood */
.confirm-btn-no {
    color: rgb(72, 52, 34);
    flex-grow: 1;
    margin-bottom: 0;
}

/* Neutralise Unity's default button hover/focus/disabled chrome */
.pause-hud-btn:hover, .pause-hud-btn:focus, .pause-hud-btn:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
.pause-btn:hover, .pause-btn:focus, .pause-btn:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
