/* =================================================================
   SUNOD — Pause Menu
   Navy + gold palette — matches MainMenu, QuestPanel, InventoryPanel.

   Sources referenced:
     btn-logout        → MainMenuStyle.uss  (top-right absolute button)
     inventory-preview-btn → GameHUDStyle.uss (dark HUD button look)
     menu-panel / menu-btn → MainMenuStyle.uss (card + tall buttons)
     overlay           → InventoryPanelStyle.uss (full-screen dim)
   ================================================================= */

/* ---------- FULL-SCREEN ROOT ----------
   Transparent pass-through so closed overlay doesn't eat pointer events.
   picking-mode="Ignore" is set in UXML; this just handles layout. */
.pause-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ---------- HUD PAUSE BUTTON (top-right, always visible) ----------
   Mirrors btn-logout positioning from MainMenuStyle.
   Visual style mirrors inventory-preview-btn from GameHUDStyle. */
.pause-hud-btn {
    position: absolute;
    top: 24px;
    right: 24px;
    background-color: rgba(14, 20, 42, 0.88);
    border-color: rgb(201, 151, 59);
    border-width: 3px;
    border-radius: 12px;
    padding: 14px 22px;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 22px;
    color: rgb(245, 168, 35);
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.12s;
}
.pause-hud-btn:hover  { background-color: rgba(30, 44, 80, 0.95); }
.pause-hud-btn:active { background-color: rgba(10, 14, 34, 0.95); }

/* ---------- DIMMED OVERLAY ----------
   Mirrors .overlay from InventoryPanelStyle.
   Hidden by default — vc_PauseMenu sets display:flex on open. */
.pause-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(4, 8, 20, 0.82);
    align-items: center;
    justify-content: center;
    display: none;
}

/* ---------- CENTERED CARD ----------
   Mirrors .menu-panel from MainMenuStyle:
   dark navy, 4px gold border, 24px radius. */
.pause-box {
    min-width: 380px;
    max-width: 460px;
    background-color: rgba(14, 20, 42, 0.97);
    border-color: rgb(201, 151, 59);
    border-width: 4px;
    border-radius: 24px;
    padding: 44px 50px 38px 50px;
    flex-direction: column;
    align-items: stretch;
}

/* ---------- PAUSED TITLE ---------- */
.pause-title {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 36px;
    color: rgb(245, 168, 35);
    -unity-text-align: upper-center;
    letter-spacing: 10px;
    margin-bottom: 16px;
}

/* ---------- DIVIDER ---------- */
.pause-divider {
    height: 2px;
    background-color: rgb(201, 151, 59);
    opacity: 0.40;
    margin-bottom: 28px;
    flex-shrink: 0;
}

/* ---------- MAIN BUTTONS CONTAINER ---------- */
.pause-main-btns {
    flex-direction: column;
    align-items: stretch;
}

/* ---------- SHARED BUTTON BASE ----------
   Scaled-down version of .menu-btn from MainMenuStyle. */
.pause-btn {
    align-items: center;
    justify-content: center;
    height: 72px;
    border-color: rgb(201, 151, 59);
    border-width: 3px;
    border-radius: 14px;
    margin-bottom: 18px;
    padding: 0 24px;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 22px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.13s;
}

/* Resume — green (matches btn-play from MainMenuStyle) */
.pause-btn-resume {
    background-color: rgb(48, 102, 36);
    color: rgb(220, 255, 210);
}
.pause-btn-resume:hover  { background-color: rgb(62, 132, 46); }
.pause-btn-resume:active { background-color: rgb(34, 76, 26);  }

/* Exit — muted navy (matches btn-tutorial from MainMenuStyle) */
.pause-btn-exit {
    background-color: rgb(38, 54, 88);
    color: rgb(200, 210, 230);
    border-color: rgb(80, 100, 145);
    margin-bottom: 0;
}
.pause-btn-exit:hover  { background-color: rgb(52, 72, 112); }
.pause-btn-exit:active { background-color: rgb(26, 38, 68);  }

/* ---------- EXIT CONFIRM PANEL ---------- */
.pause-confirm {
    flex-direction: column;
    align-items: stretch;
    display: none;
}

.confirm-body {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
    font-size: 17px;
    color: rgb(210, 215, 235);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 24px;
}

.confirm-btn-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Yes — danger red */
.confirm-btn-yes {
    background-color: rgb(148, 40, 28);
    border-color: rgb(220, 80, 60);
    color: rgb(255, 220, 215);
    margin-right: 16px;
    flex-grow: 1;
    margin-bottom: 0;
}
.confirm-btn-yes:hover  { background-color: rgb(180, 52, 36); }
.confirm-btn-yes:active { background-color: rgb(112, 30, 20); }

/* No — muted navy */
.confirm-btn-no {
    background-color: rgb(38, 54, 88);
    border-color: rgb(80, 100, 145);
    color: rgb(200, 210, 230);
    flex-grow: 1;
    margin-bottom: 0;
}
.confirm-btn-no:hover  { background-color: rgb(52, 72, 112); }
.confirm-btn-no:active { background-color: rgb(26, 38, 68);  }
