/* Full screen, transparent, pass-through */
.hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: flex-end;
}

/* Bottom strip — preview + slots grouped right */
.hud-bar {
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 16px 20px;
}

/* ============================
   Inventory Preview Button
   ============================ */
.inventory-preview-btn {
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/buttons/Square Buttons 26x26.png#sl_button");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 20px;
    margin-right: 18px;
    align-self: flex-end;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}
.inventory-preview-btn:active {
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/buttons/Square Buttons 26x26.png#sl_button_pressed");
}

.preview-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 192px;
}

.preview-circle {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: rgba(20, 30, 58, 0.9);
    border-color: rgb(80, 100, 145);
    border-width: 2px;
    margin: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ============================
   Skill Slots Grid — 2 rows x 3 (top: R I A, bottom: S E C)
   ============================ */
.skill-slots-grid {
    flex-direction: column;
    align-items: flex-end;
}

.skill-slots-row {
    flex-direction: row;
    align-items: flex-end;
}
.skill-slots-row:first-child {
    margin-bottom: 6px;
}

/* Skill card: card (icon ring + icon, level badge) -> skill name */
.slot-wrapper {
    flex-direction: column;
    align-items: center;
    margin-left: 10px;
}

/* RIASEC category name removed from the HUD (too busy) */
.slot-category {
    display: none;
}

.slot-diamond-container {
    width: 116px;
    height: 124px;
    align-items: center;
    justify-content: flex-start;
    position: relative;
}

.skill-slot-btn {
    rotate: 0deg;
    width: 116px;
    height: 124px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_normal.png");
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5px;
    border-width: 0;
    border-bottom-width: 5px;
    border-radius: 0;
    align-items: center;
    justify-content: flex-start;
}
.skill-slot-btn:hover {
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_hover.png");
}
.skill-slot-btn:active {
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_pressed.png");
}
.skill-slot-btn:focus {
    background-color: rgba(0,0,0,0);
}
.skill-slot-btn:disabled {
    background-color: rgba(0,0,0,0);
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/skill_card_disabled.png");
    opacity: 1;
}

/* Per-category colour strip along the card bottom (T3, D1 slot order 0=R,1=I,2=A,3=S,4=E,5=C) */
.cat-R { border-color: rgb(217, 58, 74); }
.cat-I { border-color: rgb(240, 138, 36); }
.cat-A { border-color: rgb(142, 79, 214); }
.cat-S { border-color: rgb(47, 163, 90); }
.cat-E { border-color: rgb(47, 111, 214); }
.cat-C { border-color: rgb(34, 179, 196); }

/* Icon ring near the top of the card */
.slot-inner {
    rotate: 0deg;
    position: absolute;
    top: 12px;
    left: 22px;
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/icon_ring.png");
    -unity-background-scale-mode: scale-to-fit;
}

.slot-icon {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

/* "+" shown when slot is empty */
.slot-empty-plus {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: 42px;
    color: rgb(140, 115, 105);
    -unity-text-align: middle-center;
}

/* Level pill at the bottom of the card */
.slot-level {
    position: absolute;
    bottom: 10px;
    left: 26px;
    right: 26px;
    height: 28px;
    font-size: 16px;
    color: rgb(100, 85, 82);
    -unity-text-align: middle-center;
    background-image: url("/Assets/Art/MenuReference/SkillSlotUIKit/backgrounds/level_badge.png");
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.4px;
}

/* Skill name under the card */
.slot-name {
    margin-top: 4px;
    width: 116px;
    font-size: 18px;
    color: rgb(250, 238, 215);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(46, 34, 24);
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    max-height: 48px;
}

/* Neutralise Unity's default button hover/focus/disabled chrome */
.inventory-preview-btn:hover, .inventory-preview-btn:focus, .inventory-preview-btn:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
