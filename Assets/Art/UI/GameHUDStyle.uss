/* Full screen, transparent, pass-through */
.hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: flex-end;
}

/* Bottom strip — preview + slots grouped right */
.hud-bar {
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 16px 20px;
}

/* ============================
   Inventory Preview Button
   ============================ */
.inventory-preview-btn {
    background-color: rgba(14, 20, 42, 0.88);
    border-color: rgb(201, 151, 59);
    border-width: 3px;
    border-radius: 18px;
    padding: 12px;
    margin-right: 18px;
    align-self: flex-end;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.inventory-preview-btn:hover {
    background-color: rgba(30, 44, 80, 0.95);
}

.preview-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 216px;
}

.preview-circle {
    width: 62px;
    height: 62px;
    border-radius: 31px;
    background-color: rgba(20, 30, 58, 0.9);
    border-color: rgb(80, 100, 145);
    border-width: 2px;
    margin: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ============================
   Skill Slots Row
   ============================ */
.skill-slots-row {
    flex-direction: row;
    align-items: flex-end;
}

/* Holds: slot number → diamond container → slot name */
.slot-wrapper {
    flex-direction: column;
    align-items: center;
    margin-left: 10px;
}

/* Slot number above each diamond */
.slot-number {
    font-size: 16px;
    color: rgb(201, 151, 59);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: upper-center;
    margin-bottom: 4px;
}

/* Container sized to hold the diamond's full diagonal: 80 × √2 ≈ 113 → 116px */
.slot-diamond-container {
    width: 116px;
    height: 116px;
    align-items: center;
    justify-content: center;
    position: relative;
}

/* Diamond tile */
.skill-slot-btn {
    rotate: 45deg;
    width: 80px;
    height: 80px;
    overflow: hidden;
    background-color: rgb(10, 16, 34);
    border-color: rgb(180, 145, 55);
    border-width: 2px;
    border-radius: 4px;
    padding: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}
.skill-slot-btn:hover {
    background-color: rgb(25, 38, 72);
    border-color: rgb(245, 200, 80);
}
.skill-slot-btn:active {
    background-color: rgb(40, 60, 100);
    border-color: rgb(255, 225, 110);
}
.skill-slot-btn:disabled {
    opacity: 0.35;
    border-color: rgb(60, 60, 70);
}

/* Counter-rotate so icon and text appear upright */
.slot-inner {
    rotate: -45deg;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.slot-icon {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* "+" shown when slot is empty */
.slot-empty-plus {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: 30px;
    color: rgba(130, 155, 200, 0.55);
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
}

/* Level badge — overlaid at bottom of diamond container */
.slot-level {
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
    font-size: 13px;
    color: rgb(245, 210, 80);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: lower-center;
}

/* Skill name below the diamond */
.slot-name {
    margin-top: 5px;
    width: 116px;
    font-size: 13px;
    color: rgb(240, 215, 140);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    max-height: 40px;
}
