/* Full screen, transparent, pass-through */
.hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: flex-end;
}

/* Bottom strip — preview + slots grouped right */
.hud-bar {
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 16px 24px;
}

/* ============================
   Inventory Preview Button
   ============================ */
.inventory-preview-btn {
    background-color: rgba(18, 26, 48, 0.85);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 14px;
    padding: 10px;
    margin-right: 14px;
    align-self: flex-end;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.inventory-preview-btn:hover {
    background-color: rgba(35, 50, 85, 0.95);
}

.preview-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 196px;
}

.preview-circle {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: rgba(30, 42, 70, 0.9);
    border-color: rgb(100, 120, 160);
    border-width: 2px;
    margin: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ============================
   Skill Slots Row
   ============================ */
.skill-slots-row {
    flex-direction: row;
    align-items: flex-end;
}

/* Wrapper holds diamond + level badge + name */
.slot-wrapper {
    width: 150px;
    height: 172px;
    align-items: center;
    justify-content: center;
    margin-left: 6px;
}

/* Level badge — sits above the diamond */
.slot-level {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    font-size: 14px;
    color: rgb(245, 210, 80);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

/* Diamond tile — rotated 45deg */
.skill-slot-btn {
    rotate: 45deg;
    width: 100px;
    height: 100px;
    overflow: hidden;
    background-color: rgb(15, 22, 42);
    border-color: rgb(180, 145, 55);
    border-width: 3px;
    border-radius: 4px;
    padding: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}
.skill-slot-btn:hover {
    background-color: rgb(30, 45, 80);
    border-color: rgb(255, 210, 90);
}
.skill-slot-btn:active {
    background-color: rgb(45, 68, 115);
    border-color: rgb(255, 230, 120);
}
.skill-slot-btn:disabled {
    opacity: 0.4;
    border-color: rgb(70, 70, 70);
}

/* Counter-rotate content so icon appears upright */
.slot-inner {
    rotate: -45deg;
    position: absolute;
    /* Sized larger than parent so icon fills the full diamond */
    width: 144px;
    height: 144px;
    top: -22px;
    left: -22px;
}

.slot-icon {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* Skill name — sits below the diamond */
.slot-name {
    position: absolute;
    bottom: 4px;
    left: 0;
    right: 0;
    -unity-font: url("../../TextMesh Pro/Fonts/Silkscreen-Bold.ttf");
    font-size: 10px;
    color: rgb(240, 220, 150);
    -unity-text-align: lower-center;
    white-space: normal;
    overflow: hidden;
}
