/* =================================================================
   SUNOD - Results screen (UI V2, 2026-11-07)
   Cards = theme sn-panel / sn-card, buttons = sn-btn (SunodTheme.tss).
   Motion: EndSceneUIToolkit.cs (vc_UIAnim).
   ================================================================= */

/* Root: sky art behind everything */
.root-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    background-image: url("/Assets/Art/UI/Menu/menu_sky_bg.png");
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    padding: 24px 24px 16px 24px;
}

.center-wrapper {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
}

/* ---------- RESULT CARD ---------- */
.result-panel {
    width: 680px;
    max-width: 70%;
    max-height: 100%;
    align-items: stretch;
    padding: 12px 28px 22px 28px;
}

.panel-header {
    align-items: center;
    margin-bottom: 4px;
}
.header-text {
    -unity-text-align: middle-center;
}

.career-section {
    align-items: center;
    margin-bottom: 16px;
}
.recommended-label {
    -unity-text-align: middle-center;
    margin-bottom: 0;
}
/* the big reveal: gold chip with the career name */
.career-name {
    font-size: 44px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: var(--sn-gold);
    border-color: var(--sn-gold-dark);
    border-width: 3px;
    border-bottom-width: 6px;
    border-radius: 999px;
    padding: 4px 32px 4px 32px;
    margin: 8px 0 8px 0;
}
.riasec-note {
    -unity-text-align: middle-center;
}
.partial-note {
    color: var(--sn-red-dark);
    margin-top: 4px;
}

/* ---------- STATS ---------- */
.stats-section {
    padding: 4px 20px 4px 20px;
}
.stat-row {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
    border-bottom-width: 2px;
    border-color: var(--sn-paper-line);
}
.stat-row--last {
    border-bottom-width: 0;
}
.stat-label {
    width: 230px;
    flex-shrink: 0;
    font-size: 24px;
    color: var(--sn-ink-muted);
}
.stat-value {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 26px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-right;
    white-space: normal;
}
.stat-gold {
    color: var(--sn-gold-dark);
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
}

/* ---------- WEBSITE CARD ---------- */
.survey-card {
    width: 320px;
    margin-left: 24px;
    align-items: stretch;
    padding: 12px 20px 16px 20px;
}
.survey-header-text {
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}
.survey-link-btn {
    margin: 0;
    padding: 6px 16px 6px 16px;
}
.survey-link-label {
    font-size: 24px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ---------- ACTIONS (primary on the right) ---------- */
.action-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    max-width: 1024px;
    flex-shrink: 0;
}
.action-btn {
    min-width: 220px;
    margin: 0 0 0 16px;
}
