/* Root */
.root-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    background-image: url("/Assets/Art/UI/Menu/menu_sky_bg.png");
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
}

/* Center */
.center-wrapper {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    width: 100%;
}

/* Panel - the career result card, framed in Sprout Lands wood */
.result-panel {
    width: 85%;
    max-width: 700px;
    background-image: url("/Assets/Art/UI/Panels/panel_wood.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 0 44px 32px 44px;
    align-items: stretch;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 1px;
}

/* Survey card - same wood frame as the result panel, sits to its right */
.survey-card {
    width: 360px;
    margin-left: 24px;
    background-image: url("/Assets/Art/UI/Panels/panel_wood.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 0 28px 28px 28px;
    align-items: center;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 1px;
}
.survey-note {
    font-size: 14px;
    color: rgb(90, 70, 50);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 10px;
}
/* Dark brown pixel frame, then a plain white square so the code always scans */
.survey-qr-frame {
    width: 268px;
    height: 268px;
    padding: 10px;
    margin-bottom: 14px;
    background-color: rgb(255, 255, 255);
    border-width: 4px;
    border-color: rgb(72, 52, 34);
    border-radius: 0;
}
.survey-qr {
    flex-grow: 1;
    background-image: url("/Assets/Art/UI/Menu/survey_qr.png");
    -unity-background-scale-mode: scale-to-fit;
}
.survey-link-btn {
    height: 64px;
    min-width: 0;
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    padding: 0 12px;
}
.survey-link-label {
    font-size: 14px;
}

/* Header Badge */
.panel-header {
    align-items: center;
    align-self: center;
    background-image: none;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgb(210, 150, 64);
    margin-top: 28px;
    margin-bottom: 24px;
    padding: 0 18px 6px 18px;
}
.header-text {
    font-size: 20px;
    color: rgb(90, 62, 38);
    -unity-text-align: middle-center;
}

/* Career Section */
.career-section {
    align-items: center;
    margin-bottom: 12px;
}
.recommended-label {
    font-size: 14px;
    color: rgb(90, 70, 50);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}
.career-name {
    font-size: 42px;
    color: rgb(180, 100, 30);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}
.riasec-note {
    font-size: 14px;
    color: rgb(90, 70, 50);
    -unity-text-align: middle-center;
}

/* Divider */
.divider {
    height: 2px;
    background-color: rgb(150, 105, 60);
    opacity: 0.5;
    margin-top: 16px;
    margin-bottom: 16px;
}

/* Stats */
.stats-section {
    padding: 0 8px;
}
.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    min-height: 40px;
}
.stat-label {
    font-size: 16px;
    color: rgb(90, 70, 50);
    width: 200px;
}
.stat-value {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(72, 52, 34);
}
.stat-gold {
    color: rgb(180, 100, 30);
}

/* Action Buttons */
.action-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding-bottom: 36px;
    width: 100%;
}
.action-btn {
    align-items: center;
    justify-content: center;
    height: 80px;
    min-width: 200px;
    background-image: url("/Assets/Art/UI/Panels/button_wide.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 0 32px;
    margin-left: 12px;
    margin-right: 12px;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 8;
    -unity-slice-top: 6;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}
.action-btn:active {
    background-image: url("/Assets/Art/UI/Panels/button_wide_pressed.png");
}
.action-btn-label {
    font-size: 18px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
}

.btn-play-again {
    -unity-background-image-tint-color: rgb(200, 240, 190);
}

.btn-main-menu {
}

/* Neutralise Unity's default button hover/focus/disabled chrome */
.action-btn:hover, .action-btn:focus, .action-btn:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
