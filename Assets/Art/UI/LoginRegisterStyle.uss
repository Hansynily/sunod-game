/* ============================
   Shared Utility
   ============================ */
.hidden {
    display: none;
}

/* ============================
   Root
   ============================ */
.root-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(8, 12, 30);
    flex-direction: column;
}

/* ============================
   Screen Wrapper (full screen, centers content)
   ============================ */
.screen-wrapper {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* ============================
   Brand Area (title above card)
   ============================ */
.brand-area {
    align-items: center;
    margin-bottom: 20px;
}
.brand-title {
    font-size: 84px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
    letter-spacing: 6px;
}
.brand-divider {
    font-size: 20px;
    color: rgb(201, 151, 59);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* ============================
   Card (login)
   ============================ */
.card {
    width: 560px;
    background-color: rgb(14, 20, 42);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 14px;
    padding: 40px 48px;
    align-items: stretch;
}

/* Card wide (register) */
.card-wide {
    width: 860px;
}

/* ============================
   Input Row (icon + field)
   ============================ */
.input-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(6, 10, 24);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 8px;
    margin-bottom: 14px;
    padding: 4px 12px;
    height: 56px;
}
.input-icon {
    font-size: 22px;
    color: rgb(201, 151, 59);
    width: 36px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

/* ============================
   Text Fields
   ============================ */
.input-field {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.input-field .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
}
.input-field .unity-base-field__input {
    background-color: rgb(6, 10, 24);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 8px;
    padding: 0 14px;
    color: white;
    font-size: 17px;
    height: 50px;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
}
.input-field:focus .unity-base-field__input {
    border-color: rgb(245, 195, 80);
}

/* Override when input-field is inside input-row (no extra border/bg) */
.input-row .input-field .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    font-size: 18px;
    height: 44px;
    color: white;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
}

/* Standalone input-field (register form, not in input-row) */
.form-row .input-field .unity-base-field__input {
    background-color: rgb(6, 10, 24);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 8px;
    padding: 0 14px;
    color: white;
    font-size: 16px;
    height: 58px;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
}

/* Dropdown styling (general) */
.input-field .unity-dropdown-field__input {
    background-color: rgb(6, 10, 24);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 8px;
    padding: 0 12px;
    color: rgb(180, 180, 180);
    font-size: 16px;
    height: 50px;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
}

/* Dropdown inside form-row matches text field height */
.form-row .input-field .unity-dropdown-field__input {
    height: 58px;
}

/* ============================
   Placeholder Text
   ============================ */
.is-placeholder .unity-base-field__input {
    color: rgba(160, 160, 160, 0.55);
}

/* ============================
   Error / Loading Labels
   ============================ */
.error-label {
    color: rgb(255, 100, 100);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    white-space: normal;
}
.loading-label {
    color: rgb(201, 151, 59);
    font-size: 15px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

/* ============================
   Primary Button (gold)
   ============================ */
.btn-primary {
    height: 64px;
    background-color: rgb(230, 170, 30);
    border-color: rgb(180, 120, 10);
    border-width: 2px;
    border-radius: 10px;
    margin-top: 8px;
    margin-bottom: 12px;
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.btn-primary:hover {
    background-color: rgb(255, 195, 50);
}
.btn-primary-label {
    font-size: 22px;
    color: rgb(20, 15, 5);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
}

/* ============================
   Secondary Button (dark + gold border)
   ============================ */
.btn-secondary {
    height: 52px;
    background-color: rgb(20, 28, 52);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.btn-secondary:hover {
    background-color: rgb(35, 48, 80);
}
.btn-secondary-label {
    font-size: 16px;
    color: rgb(201, 151, 59);
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    -unity-text-align: middle-center;
}

/* ============================
   Half-width buttons (for form rows)
   ============================ */
.btn-half {
    flex-grow: 1;
    flex-shrink: 1;
}

/* ============================
   Register Form Rows
   ============================ */
.form-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}
.form-row .input-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: 7px;
    margin-right: 7px;
    height: 58px;
}
.form-row .date-picker {
    margin-left: 7px;
    margin-right: 7px;
}
.form-btn-row {
    margin-top: 8px;
}
.form-btn-row .btn-half {
    margin-left: 7px;
    margin-right: 7px;
}

/* ============================
   Date Picker
   ============================ */
.date-picker {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    background-color: rgb(6, 10, 24);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 8px;
    padding: 0 10px;
    height: 58px;
}
.date-picker-label {
    font-size: 10px;
    color: rgb(201, 151, 59);
    -unity-text-align: middle-left;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    width: 58px;
    flex-shrink: 0;
    margin-right: 6px;
    white-space: nowrap;
}
.date-picker-dropdowns {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}
.dp-segment {
    flex-grow: 0;
    flex-shrink: 0;
    width: 48px;
    margin-right: 5px;
}
.dp-segment .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
}
.dp-year {
    flex-grow: 1;
    flex-shrink: 1;
    width: 0;
    min-width: 80px;
    margin-right: 0;
}

.dp-segment .unity-dropdown-field__input {
    background-color: rgb(12, 18, 40);
    border-color: rgb(100, 80, 30);
    border-width: 1px;
    border-radius: 6px;
    color: white;
    font-size: 13px;
    height: 40px;
    padding: 0 6px;
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
    flex-grow: 1;
    min-width: 0;
}

/* ============================
   Backend Overlay
   ============================ */
.overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}
.card-backend {
    width: 520px;
    background-color: rgb(14, 20, 42);
    border-color: rgb(201, 151, 59);
    border-width: 2px;
    border-radius: 14px;
    padding: 28px 36px;
    align-items: stretch;
}
.backend-title {
    font-size: 22px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}
.backend-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}
.backend-section-label {
    font-size: 16px;
    color: rgb(201, 151, 59);
    -unity-font-style: bold;
    margin-bottom: 8px;
}
.backend-status {
    font-size: 13px;
    color: rgb(150, 200, 150);
    flex-grow: 1;
    -unity-text-align: middle-right;
    white-space: normal;
}
.backend-preset-row {
    flex-direction: row;
    margin-bottom: 18px;
}
.backend-preset-row .btn-preset {
    margin-right: 12px;
}
.btn-preset {
    flex-grow: 1;
    height: 44px;
    background-color: rgb(28, 38, 68);
    border-color: rgb(100, 80, 40);
    border-width: 2px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}
.btn-preset-active {
    background-color: rgb(55, 80, 130);
    border-color: rgb(201, 151, 59);
}
.btn-preset > .unity-label {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
}
.backend-url-row {
    margin-bottom: 18px;
}
.input-url {
    width: 100%;
}
.backend-footer-row {
    flex-direction: row;
    margin-bottom: 14px;
}
.backend-footer-row .btn-half {
    margin-left: 7px;
    margin-right: 7px;
}
.backend-help {
    font-size: 12px;
    color: rgb(130, 145, 170);
    -unity-text-align: middle-center;
    white-space: normal;
}
.btn-close {
    position: absolute;
    top: 16px;
    left: 16px;
    height: 36px;
    background-color: rgb(28, 38, 68);
    border-color: rgb(100, 80, 40);
    border-width: 2px;
    border-radius: 6px;
    padding: 0 14px;
    align-items: center;
    justify-content: center;
}
.btn-close-label {
    font-size: 14px;
    color: rgb(200, 200, 200);
}

/* ============================
   Dev Backend Button
   ============================ */
.btn-dev {
    position: absolute;
    bottom: 16px;
    left: 16px;
    height: 32px;
    background-color: rgba(20, 28, 52, 0.85);
    border-color: rgb(80, 60, 30);
    border-width: 1px;
    border-radius: 6px;
    padding: 0 12px;
    align-items: center;
    justify-content: center;
}
.btn-dev-label {
    font-size: 13px;
    color: rgb(150, 130, 80);
}
