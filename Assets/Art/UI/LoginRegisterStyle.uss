/* =====================================================================
   Login / Register - UI V2 (2026-11-07). Tokens + sn-* components come from
   SunodTheme.tss (see Assets/Art/UI/UI_V2.md). Only layout and the bits Unity's
   default theme fights (text fields, dropdowns, tabs) are styled here.
   Rules that must out-rank Unity's default :hover/:focus selectors are prefixed
   with .root-container.
   Panel space is 1280x720 (match height), landscape phones.
   ===================================================================== */

.hidden {
    display: none;
}

/* ============================
   Root + backdrop (same world art as MainMenu)
   ============================ */
.root-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    background-color: rgb(143, 199, 232);
    background-image: url("/Assets/Art/UI/Menu/menu_sky_bg.png");
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

/* vc_MainMenuBackground (if ever added to this UIDocument) inserts its animated sky with this class */
.menu-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.login-hills {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 32%;
    background-image: url("/Assets/Art/UI/Menu/menu_hills.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ============================
   Screen wrapper: logo pinned at the same spot on both panels (so the
   Login <-> Register crossfade keeps it still), card under it.
   ============================ */
.screen-wrapper {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 24px 24px 24px 24px;
}

/* ============================
   SUNOD logo (same look as the main menu title)
   ============================ */
.brand-area {
    align-items: center;
    margin-bottom: 16px;
    flex-shrink: 0;
}
.brand-banner {
    padding: 0 32px 0 32px;
    align-items: center;
    justify-content: center;
}
.brand-title {
    font-size: 88px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-gold);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(94, 64, 44);
    text-shadow: 0 6px 0 rgb(94, 64, 44);
    -unity-text-align: middle-center;
    letter-spacing: 12px;
    padding: 0;
    margin: 0;
}

/* ============================
   Auth card (sn-panel) with a segmented Login | Register switch on top
   ============================ */
.screen-wrapper .auth-box {
    width: 92%;
    max-width: 680px;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
    padding: 16px 32px 20px 32px;
}
.screen-wrapper .auth-box--wide {
    max-width: 1180px;
}

/* segmented control: a sunken pill track, the current tab is a raised cream pill */
.auth-tabs {
    flex-direction: row;
    align-self: center;
    width: 100%;
    max-width: 520px;
    padding: 6px;
    margin-bottom: 16px;
    background-color: var(--sn-cream-lo);
    border-color: var(--sn-paper-line);
    border-width: 2px;
    border-radius: 999px;
}

.root-container .auth-tab {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 72px;
    height: 72px;
    margin: 0;
    padding: 0 24px 0 24px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 999px;
}
.root-container .auth-tab--active {
    background-color: var(--sn-cream-hi);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 6px;
}
.auth-tab-label {
    font-size: 28px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.auth-tab--inactive .auth-tab-label {
    color: var(--sn-ink-muted);
}

/* the switch tab is a Button: no Unity chrome, soft hover */
.root-container .auth-tab--inactive:hover,
.root-container .auth-tab--inactive:focus,
.root-container .auth-tab--inactive:checked {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.root-container .auth-tab--inactive:hover:enabled {
    background-color: rgba(139, 98, 66, 0.08);
}
.root-container .auth-tab--inactive:active:enabled {
    background-color: rgba(139, 98, 66, 0.14);
}
.root-container .auth-tab--inactive:disabled {
    opacity: 0.5;
}

/* ============================
   Card content
   ============================ */
.card {
    padding: 0 8px 0 8px;
    align-items: stretch;
    flex-shrink: 0;
}

/* ============================
   Field groups + labels
   ============================ */
.field-group {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 12px;
}
.field-label {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink-muted);
    -unity-text-align: middle-left;
    white-space: nowrap;
    margin: 0 0 4px 12px;
    padding: 0;
}

/* Register: three columns per row */
.form-row {
    flex-direction: row;
    align-items: flex-start;
    margin-left: -8px;
    margin-right: -8px;
}
.form-cell {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 8px;
    margin-right: 8px;
}

/* ============================
   Inputs (TextField + DropdownField): cream-hi well, brown outline, green on focus
   ============================ */
.root-container .lr-field {
    margin: 0;
    padding: 0;
    min-height: 0;
    flex-grow: 0;
    flex-shrink: 0;
    --unity-cursor-color: var(--sn-ink);
    --unity-selection-color: rgba(84, 158, 94, 0.35);
}
.root-container .lr-field .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
}

.root-container .lr-field > .unity-base-text-field__input,
.root-container .lr-field > .unity-base-popup-field__input {
    height: 84px;
    min-height: 84px;
    margin: 0;
    padding: 0 20px 0 20px;
    background-color: var(--sn-cream-hi);
    background-image: none;
    border-radius: 20px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 5px;
    border-left-color: var(--sn-brown);
    border-right-color: var(--sn-brown);
    border-top-color: var(--sn-brown);
    border-bottom-color: var(--sn-brown);
    color: var(--sn-ink);
    font-size: 26px;
    -unity-text-align: middle-left;
    justify-content: center;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}
.root-container .lr-field > .unity-base-popup-field__input {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.root-container .lr-field .unity-text-element,
.root-container .lr-field .unity-base-popup-field__text {
    color: var(--sn-ink);
    font-size: 26px;
    -unity-text-align: middle-left;
}
.root-container .lr-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--sn-brown);
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

/* Kill Unity's grey hover / active chrome */
.root-container .lr-field:hover:enabled > .unity-base-text-field__input,
.root-container .lr-field:hover:enabled > .unity-base-popup-field__input,
.root-container .lr-field > .unity-base-popup-field__input:hover:enabled,
.root-container .lr-field > .unity-base-popup-field__input:active:enabled,
.root-container .lr-field > .unity-base-popup-field__input:checked {
    background-color: var(--sn-cream-hi);
    border-left-color: var(--sn-brown);
    border-right-color: var(--sn-brown);
    border-top-color: var(--sn-brown);
    border-bottom-color: var(--sn-brown);
}
/* focus = green outline */
.root-container .lr-field:focus:enabled > .unity-base-text-field__input,
.root-container .lr-field:focus:enabled > .unity-base-popup-field__input,
.root-container .lr-field:focus > .unity-base-text-field__input,
.root-container .lr-field:focus > .unity-base-popup-field__input {
    background-color: rgb(255, 252, 244);
    border-left-color: var(--sn-green);
    border-right-color: var(--sn-green);
    border-top-color: var(--sn-green);
    border-bottom-color: var(--sn-green-dark);
}
.root-container .lr-field:disabled > .unity-base-text-field__input,
.root-container .lr-field:disabled > .unity-base-popup-field__input {
    opacity: 0.6;
}

/* Placeholder state (LoginRegisterUIToolkit toggles .is-placeholder on the TextField) */
.root-container .lr-field.is-placeholder > .unity-base-text-field__input,
.root-container .lr-field.is-placeholder .unity-text-element {
    color: var(--sn-ink-muted);
}

/* ============================
   Birthdate picker (3 dropdowns in a row)
   ============================ */
.date-picker-dropdowns {
    flex-direction: row;
    align-items: stretch;
}
.root-container .dp-segment {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 8px;
}
.root-container .dp-year {
    flex-grow: 1.5;
    margin-right: 0;
}
.root-container .dp-segment > .unity-base-popup-field__input {
    padding: 0 10px 0 14px;
    min-width: 0;
}
.root-container .dp-segment .unity-base-popup-field__text {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

/* ============================
   Error / loading / notice text
   ============================ */
.error-label {
    color: var(--sn-red);
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 640px;
    align-self: center;
    margin: 0 8px 8px 8px;
}
/* a good-news message in the error slot (e.g. account created) */
.error-label.error-label--ok {
    color: var(--sn-green-dark);
}
.loading-label {
    color: var(--sn-ink-muted);
    font-size: 21px;
    -unity-text-align: middle-center;
    align-self: center;
    margin: 0 0 8px 0;
}

/* ============================
   Action buttons (sn-btn from the theme)
   ============================ */
.action-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}
.root-container .lr-action-btn {
    min-width: 320px;
    margin: 0 8px 0 8px;
}
.root-container .lr-action-btn--small {
    min-width: 200px;
}
.lr-action-label {
    font-size: 28px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.sn-btn--primary .lr-action-label {
    color: var(--sn-cream-hi);
}
.sn-btn--ghost .lr-action-label {
    color: var(--sn-ink-muted);
}

/* ============================
   Backend settings sheet (dev only)
   ============================ */
.overlay .card-backend {
    width: 90%;
    max-width: 760px;
    padding: 16px 28px 20px 28px;
}
.backend-header {
    justify-content: center;
    min-height: 72px;
}
.backend-title {
    flex-grow: 1;
}
.root-container .btn-close {
    position: absolute;
    top: -4px;
    right: -8px;
    margin: 0;
    font-size: 36px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
}
.backend-status {
    font-size: 21px;
    color: var(--sn-ink-muted);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 8px 8px 8px;
}
.backend-preset-row {
    flex-direction: row;
    margin: 0 -4px 12px -4px;
}
.root-container .btn-preset {
    flex-grow: 1;
    flex-basis: 0;
    margin: 4px;
}
.btn-preset > .unity-label {
    font-size: 22px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink-muted);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
/* the chosen preset: light green fill + green outline + dark label (not only colour: weight too) */
.root-container .btn-preset-active,
.root-container .btn-preset-active:hover:enabled,
.root-container .btn-preset-active:focus {
    background-color: var(--sn-green-hi);
    border-color: var(--sn-green-dark);
}
.btn-preset-active > .unity-label {
    color: var(--sn-green-dark);
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
}
.backend-footer-row {
    justify-content: flex-end;
    margin-top: 4px;
}
.root-container .input-url > .unity-base-text-field__input,
.root-container .input-url .unity-text-element {
    font-size: 22px;
}

/* ============================
   Dev button (small round gear, bottom-left, unobtrusive)
   ============================ */
.root-container .btn-dev {
    position: absolute;
    bottom: 24px;
    left: 24px;
    margin: 0;
    opacity: 0.8;
}
.root-container .btn-dev:hover:enabled {
    opacity: 1;
}
.btn-dev-icon {
    width: 36px;
    height: 36px;
    background-image: url("/Assets/Art/MenuReference/icons/icon_settings.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--sn-ink);
}
