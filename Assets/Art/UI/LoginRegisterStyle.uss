/* ============================
   Shared Utility
   ============================ */
.hidden {
    display: none;
}

/* ============================
   Root
   ============================ */
.root-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(8, 12, 30);
    flex-direction: column;
}

/* ============================
   Screen Wrapper (full screen, centers content)
   ============================ */
.screen-wrapper {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* ============================
   Brand Area (title above card)
   ============================ */
.brand-area {
    align-items: center;
    margin-bottom: 30px;
}
.brand-title {
    font-size: 84px;
    color: rgb(90, 62, 38);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(250, 245, 235);
    -unity-text-align: middle-center;
    letter-spacing: 6px;
}
.brand-divider {
    font-size: 28px;
    color: rgb(160, 120, 70);
    -unity-text-align: middle-center;
    margin-top: 6px;
}

/* ============================
   Card (login) - cream Sprout Lands panel, 9-sliced
   ============================ */
.card {
    width: 840px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Sprite sheet for Basic Pack.png#sl_slot");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 60px 72px;
    align-items: stretch;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}

/* Card wide (register) */
.card-wide {
    width: 1290px;
}

/* ============================
   Input Row (icon + field)
   ============================ */
.input-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(40, 30, 22);
    border-color: rgb(150, 105, 60);
    border-width: 3px;
    border-radius: 12px;
    margin-bottom: 21px;
    padding: 6px 18px;
    height: 84px;
}
.input-icon {
    font-size: 33px;
    color: rgb(201, 151, 59);
    width: 54px;
    -unity-text-align: middle-center;
    margin-right: 12px;
}

/* ============================
   Text Fields
   ============================ */
.input-field {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.input-field .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
}
.input-field .unity-base-field__input {
    background-color: rgb(40, 30, 22);
    border-color: rgb(150, 105, 60);
    border-width: 3px;
    border-radius: 12px;
    padding: 0 21px;
    color: rgb(238, 226, 205);
    font-size: 26px;
    height: 75px;
}
.input-field:focus .unity-base-field__input {
    border-color: rgb(245, 195, 80);
}

/* Override when input-field is inside input-row (no extra border/bg) */
.input-row .input-field .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    font-size: 27px;
    height: 66px;
    color: rgb(238, 226, 205);
}

/* Standalone input-field (register form, not in input-row) */
.form-row .input-field .unity-base-field__input {
    background-color: rgb(40, 30, 22);
    border-color: rgb(150, 105, 60);
    border-width: 3px;
    border-radius: 12px;
    padding: 0 21px;
    color: rgb(238, 226, 205);
    font-size: 24px;
    height: 87px;
}

/* Dropdown styling (general) */
.input-field .unity-dropdown-field__input {
    background-color: rgb(40, 30, 22);
    border-color: rgb(150, 105, 60);
    border-width: 3px;
    border-radius: 12px;
    padding: 0 18px;
    color: rgb(180, 180, 180);
    font-size: 24px;
    height: 75px;
}

/* Dropdown inside form-row matches text field height */
.form-row .input-field .unity-dropdown-field__input {
    height: 87px;
}

/* ============================
   Placeholder Text
   ============================ */
.input-field.is-placeholder .unity-base-field__input,
.input-row .is-placeholder .unity-base-field__input,
.form-row .is-placeholder .unity-base-field__input {
    color: rgba(160, 160, 160, 0.55);
}

/* ============================
   Error / Loading Labels
   ============================ */
.error-label {
    color: rgb(255, 100, 100);
    font-size: 21px;
    -unity-text-align: middle-center;
    margin-bottom: 15px;
    white-space: normal;
}
.loading-label {
    color: rgb(201, 151, 59);
    font-size: 22px;
    -unity-text-align: middle-center;
    margin-bottom: 15px;
}

/* ============================
   Primary Button (gold)
   ============================ */
.btn-primary {
    height: 96px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/UI Big Play Button.png#sl_button_wide");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    margin-top: 12px;
    margin-bottom: 18px;
    align-items: center;
    justify-content: center;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}
.btn-primary:active {
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/UI Big Play Button.png#sl_button_wide_pressed");
}
.btn-primary-label {
    font-size: 28px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
}

/* ============================
   Secondary Button (Sprout Lands square button, wide)
   ============================ */
.btn-secondary {
    height: 78px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/UI Big Play Button.png#sl_button_wide");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}
.btn-secondary:active {
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/UI Big Play Button.png#sl_button_wide_pressed");
}
.btn-secondary-label {
    font-size: 20px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
}

/* ============================
   Half-width buttons (for form rows)
   ============================ */
.btn-half {
    flex-grow: 1;
    flex-shrink: 1;
}

/* ============================
   Register Form Rows
   ============================ */
.form-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 21px;
}
.form-row .input-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: 10px;
    margin-right: 10px;
    height: 87px;
}
.form-row .date-picker {
    margin-left: 10px;
    margin-right: 10px;
}
.form-btn-row {
    margin-top: 12px;
}
.form-btn-row .btn-half {
    margin-left: 10px;
    margin-right: 10px;
}

/* ============================
   Date Picker
   ============================ */
/* Birthdate group — transparent, fills its half-cell like a normal field */
.date-picker {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(0, 0, 0, 0);
}
.date-picker-label {
    font-size: 18px;
    color: rgb(201, 151, 59);
    -unity-text-align: middle-left;
    white-space: nowrap;
    margin-bottom: 8px;
    margin-left: 4px;
}
.date-picker-dropdowns {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
}

/* Each segment fills the row evenly (no bunching) */
.dp-segment {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 10px;
}
.dp-segment .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
}
.dp-year {
    flex-grow: 1.4;
    margin-right: 0;
}

/* Style each dropdown like a real input field */
.dp-segment .unity-base-field__input,
.dp-segment .unity-dropdown-field__input,
.dp-segment .unity-popup-field__input {
    background-color: rgb(40, 30, 22);
    border-color: rgb(150, 105, 60);
    border-width: 3px;
    border-radius: 12px;
    height: 87px;
    padding: 0 12px;
    flex-grow: 1;
    min-width: 0;
}

/* The selected value text inside the dropdown */
.dp-segment .unity-base-popup-field__text,
.dp-segment .unity-text-element {
    color: rgb(238, 226, 205);
    font-size: 22px;
    -unity-text-align: middle-center;
}

/* ============================
   Backend Overlay
   ============================ */
.overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}
.card-backend {
    width: 780px;
    background-color: rgb(14, 20, 42);
    border-color: rgb(150, 105, 60);
    border-width: 3px;
    border-radius: 21px;
    padding: 42px 54px;
    align-items: stretch;
}
.backend-title {
    font-size: 33px;
    color: rgb(238, 226, 205);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 30px;
}
.backend-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}
.backend-section-label {
    font-size: 24px;
    color: rgb(201, 151, 59);
    -unity-font-style: bold;
    margin-bottom: 12px;
}
.backend-status {
    font-size: 19px;
    color: rgb(150, 200, 150);
    flex-grow: 1;
    -unity-text-align: middle-right;
    white-space: normal;
}
.backend-preset-row {
    flex-direction: row;
    margin-bottom: 27px;
}
.backend-preset-row .btn-preset {
    margin-right: 18px;
}
.btn-preset {
    flex-grow: 1;
    height: 66px;
    background-color: rgb(28, 38, 68);
    border-color: rgb(100, 80, 40);
    border-width: 3px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
}
.btn-preset-active {
    background-color: rgb(55, 80, 130);
    border-color: rgb(150, 105, 60);
}
.btn-preset > .unity-label {
    color: rgb(238, 226, 205);
    font-size: 24px;
    -unity-font-style: bold;
}
.backend-url-row {
    margin-bottom: 27px;
}
.input-url {
    width: 100%;
}
.backend-footer-row {
    flex-direction: row;
    margin-bottom: 21px;
}
.backend-footer-row .btn-half {
    margin-left: 10px;
    margin-right: 10px;
}
.backend-help {
    font-size: 18px;
    color: rgb(130, 145, 170);
    -unity-text-align: middle-center;
    white-space: normal;
}
.btn-close {
    position: absolute;
    top: 24px;
    left: 24px;
    height: 54px;
    background-color: rgb(28, 38, 68);
    border-color: rgb(100, 80, 40);
    border-width: 3px;
    border-radius: 9px;
    padding: 0 21px;
    align-items: center;
    justify-content: center;
}
.btn-close-label {
    font-size: 21px;
    color: rgb(200, 200, 200);
}

/* ============================
   Dev Backend Button
   ============================ */
.btn-dev {
    position: absolute;
    bottom: 24px;
    left: 24px;
    height: 48px;
    background-color: rgba(20, 28, 52, 0.85);
    border-color: rgb(80, 60, 30);
    border-width: 1px;
    border-radius: 9px;
    padding: 0 18px;
    align-items: center;
    justify-content: center;
}
.btn-dev-label {
    font-size: 19px;
    color: rgb(150, 130, 80);
}

/* Neutralise Unity's default button hover/focus/disabled chrome */
.btn-primary:hover, .btn-primary:focus, .btn-primary:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
.btn-secondary:hover, .btn-secondary:focus, .btn-secondary:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
