/* =====================================================================
   Login / Register - Sprout Lands look, matches MainMenu + SunodTheme.tss
   (sl-panel-cream / sl-panel-wood / sl-button / sl-button-wide come from the theme)
   Font steps: 14 / 21 / 28 / 42 (84 for the SUNOD title, same as the menu).
   Palette: ink rgb(72,52,34), soft ink rgb(150,116,82), wood rgb(90,62,38),
            field rgb(253,246,228), field border rgb(122,86,58), error rgb(160,40,30).
   Most rules are prefixed with .root-container so they out-rank Unity's default
   theme selectors (e.g. .unity-base-text-field:hover:enabled > ...).
   ===================================================================== */

.hidden {
    display: none;
}

/* ============================
   Root + backdrop (same assets as MainMenu)
   ============================ */
.root-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    background-color: rgb(47, 111, 176);
    background-image: url("/Assets/Art/UI/Menu/menu_sky_bg.png");
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

/* vc_MainMenuBackground (if ever added to this UIDocument) inserts its animated sky with this class */
.menu-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.login-hills {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 32%;
    background-image: url("/Assets/Art/UI/Menu/menu_hills.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ============================
   Screen wrapper (full screen, centred column)
   ============================ */
.screen-wrapper {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
}

/* ============================
   SUNOD banner (copy of the main menu's brand-banner)
   ============================ */
.brand-area {
    align-items: center;
    margin-bottom: 28px;
    flex-shrink: 0;
}
.brand-banner {
    padding: 20px 80px;
    align-items: center;
    justify-content: center;
}
.brand-title {
    font-size: 84px;
    color: rgb(90, 62, 38);
    -unity-text-align: middle-center;
    letter-spacing: 10px;
}

/* ============================
   Auth box = wood tabs + cream card
   ============================ */
.auth-box {
    width: 90%;
    max-width: 760px;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
}
.auth-box--wide {
    max-width: 1180px;
}

.auth-tabs {
    flex-direction: row;
    align-items: flex-end;
    padding-left: 28px;
    margin-bottom: -8px;   /* tabs tuck under the card's top edge */
}

/* Shared tab shape (applies to both the static active tab and the switch Button) */
.root-container .auth-tab {
    height: 64px;
    min-width: 200px;
    margin: 0 8px 0 0;
    padding: 0 28px 8px 28px;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}
.root-container .auth-tab--active {
    height: 72px;
}
.root-container .auth-tab--inactive {
    -unity-background-image-tint-color: rgb(196, 172, 150);
}
.auth-tab-label {
    font-size: 28px;
    color: rgb(90, 62, 38);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.auth-tab--inactive .auth-tab-label {
    color: rgb(120, 92, 66);
}

/* Neutralise Unity button chrome on the switch tab */
.root-container .auth-tab:hover,
.root-container .auth-tab:hover:enabled,
.root-container .auth-tab:focus,
.root-container .auth-tab:focus:enabled,
.root-container .auth-tab:active,
.root-container .auth-tab:active:enabled,
.root-container .auth-tab:checked,
.root-container .auth-tab:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.root-container .auth-tab--inactive:hover:enabled {
    -unity-background-image-tint-color: rgb(236, 220, 204);
}
.root-container .auth-tab--inactive:active:enabled {
    translate: 0 3px;
}
.root-container .auth-tab--inactive:disabled {
    opacity: 0.6;
}

/* ============================
   Card (cream framed panel)
   ============================ */
.card {
    padding: 36px 48px 28px 48px;
    align-items: stretch;
    flex-shrink: 0;
}

/* ============================
   Field groups + labels
   ============================ */
.field-group {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 18px;
}
.field-label {
    font-size: 22px;
    color: rgb(150, 116, 82);
    -unity-text-align: middle-left;
    white-space: nowrap;
    margin: 0 0 6px 4px;
    padding: 0;
}

/* Register: two columns per row */
.form-row {
    flex-direction: row;
    align-items: flex-start;
}
.form-cell {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 10px;
    margin-right: 10px;
}

/* ============================
   Inputs (TextField + DropdownField) - cream field, dark-brown inset border
   ============================ */
.root-container .lr-field {
    margin: 0;
    padding: 0;
    min-height: 0;
    flex-grow: 0;
    flex-shrink: 0;
    --unity-cursor-color: rgb(60, 54, 66);
    --unity-selection-color: rgba(201, 151, 59, 0.45);
}
.root-container .lr-field .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
}

/* Text input box + dropdown box share one look */
.root-container .lr-field > .unity-base-text-field__input,
.root-container .lr-field > .unity-base-popup-field__input {
    height: 64px;
    min-height: 64px;
    margin: 0;
    padding: 0 16px;
    background-color: rgb(253, 246, 228);
    background-image: none;
    border-radius: 0;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 5px;    /* thicker top = inset shadow */
    border-bottom-width: 3px;
    border-left-color: rgb(122, 86, 58);
    border-right-color: rgb(122, 86, 58);
    border-top-color: rgb(122, 86, 58);
    border-bottom-color: rgb(122, 86, 58);
    color: rgb(60, 54, 66);
    font-size: 28px;
    -unity-text-align: middle-left;
    justify-content: center;
}
.root-container .lr-field > .unity-base-popup-field__input {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.root-container .lr-field .unity-text-element,
.root-container .lr-field .unity-base-popup-field__text {
    color: rgb(60, 54, 66);
    font-size: 28px;
    -unity-text-align: middle-left;
}
.root-container .lr-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(60, 54, 66);
}

/* Kill Unity's grey hover / focus / active chrome; focus gets a gold border instead */
.root-container .lr-field:hover:enabled > .unity-base-text-field__input,
.root-container .lr-field:hover:enabled > .unity-base-popup-field__input,
.root-container .lr-field > .unity-base-popup-field__input:hover:enabled,
.root-container .lr-field > .unity-base-popup-field__input:active:enabled,
.root-container .lr-field > .unity-base-popup-field__input:checked {
    background-color: rgb(253, 246, 228);
    border-left-color: rgb(122, 86, 58);
    border-right-color: rgb(122, 86, 58);
    border-top-color: rgb(122, 86, 58);
    border-bottom-color: rgb(122, 86, 58);
}
.root-container .lr-field:focus:enabled > .unity-base-text-field__input,
.root-container .lr-field:focus:enabled > .unity-base-popup-field__input,
.root-container .lr-field:focus > .unity-base-text-field__input,
.root-container .lr-field:focus > .unity-base-popup-field__input {
    background-color: rgb(255, 251, 240);
    border-left-color: rgb(201, 151, 59);
    border-right-color: rgb(201, 151, 59);
    border-top-color: rgb(201, 151, 59);
    border-bottom-color: rgb(201, 151, 59);
}
.root-container .lr-field:disabled > .unity-base-text-field__input,
.root-container .lr-field:disabled > .unity-base-popup-field__input {
    opacity: 0.6;
}

/* Placeholder state (LoginRegisterUIToolkit toggles .is-placeholder on the TextField) */
.root-container .lr-field.is-placeholder > .unity-base-text-field__input,
.root-container .lr-field.is-placeholder .unity-text-element {
    color: rgb(170, 138, 104);
}

/* ============================
   Birthdate picker (3 dropdowns in a row)
   ============================ */
.date-picker-dropdowns {
    flex-direction: row;
    align-items: stretch;
}
.root-container .dp-segment {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 10px;
}
.root-container .dp-year {
    flex-grow: 1.5;
    margin-right: 0;
}
.root-container .dp-segment > .unity-base-popup-field__input {
    padding: 0 8px 0 12px;
    min-width: 0;
}
.root-container .dp-segment .unity-base-popup-field__text {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

/* ============================
   Error / loading text
   ============================ */
.error-label {
    color: rgb(160, 40, 30);
    font-size: 22px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 10px 10px 10px;
}
.loading-label {
    color: rgb(120, 92, 66);
    font-size: 22px;
    -unity-text-align: middle-center;
    margin: 0 0 10px 0;
}

/* ============================
   Action buttons (sl-button-wide sprite from the theme)
   ============================ */
.action-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}
.root-container .lr-action-btn {
    height: 72px;
    min-width: 300px;
    margin: 0 10px;
    padding: 0 32px;
    align-items: center;
    justify-content: center;
}
.root-container .lr-action-btn--small {
    height: 64px;
    min-width: 200px;
}
.lr-action-label {
    font-size: 28px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* Neutralise Unity button chrome on every sl-button here (theme does it at lower specificity) */
.root-container .sl-button:hover,
.root-container .sl-button:hover:enabled,
.root-container .sl-button:focus,
.root-container .sl-button:focus:enabled,
.root-container .sl-button:active:enabled,
.root-container .sl-button:checked,
.root-container .sl-button:disabled,
.root-container .sl-button-wide:hover,
.root-container .sl-button-wide:hover:enabled,
.root-container .sl-button-wide:focus,
.root-container .sl-button-wide:focus:enabled,
.root-container .sl-button-wide:active:enabled,
.root-container .sl-button-wide:checked,
.root-container .sl-button-wide:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.root-container .sl-button-wide:active:enabled,
.root-container .sl-button:active:enabled {
    translate: 0 2px;
}

/* ============================
   Backend settings overlay (dev only)
   ============================ */
.overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(4, 8, 20, 0.6);
    align-items: center;
    justify-content: center;
    padding: 16px;
}
.card-backend {
    width: 90%;
    max-width: 820px;
    padding: 0 40px 28px 40px;
}
.backend-header {
    align-self: center;
    margin-top: -22px;
    margin-bottom: 20px;
    padding: 10px 40px;
    align-items: center;
}
.backend-title {
    font-size: 28px;
    color: rgb(90, 62, 38);
    -unity-text-align: middle-center;
}
.root-container .btn-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 56px;
    height: 56px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.btn-close-icon {
    width: 28px;
    height: 28px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Icons/All Icons.png#icon_cross");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(60, 54, 66);
}
.backend-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}
.backend-status {
    font-size: 22px;
    color: rgb(120, 92, 66);
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-right;
    white-space: normal;
    margin-left: 16px;
}
.backend-preset-row {
    flex-direction: row;
    margin-bottom: 18px;
}
.root-container .btn-preset {
    flex-grow: 1;
    flex-basis: 0;
    height: 56px;
    margin: 0 6px;
    padding: 0;
    align-items: center;
    justify-content: center;
    -unity-background-image-tint-color: rgb(205, 190, 175);
}
.root-container .btn-preset-active {
    -unity-background-image-tint-color: rgb(192, 212, 112);
}
.btn-preset > .unity-label {
    font-size: 22px;
    color: rgb(120, 92, 66);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.btn-preset-active > .unity-label {
    color: rgb(40, 80, 30);
}
.backend-footer-row {
    margin-bottom: 14px;
}
.backend-help {
    font-size: 22px;
    color: rgb(150, 116, 82);
    -unity-text-align: middle-center;
    white-space: normal;
}
.root-container .input-url > .unity-base-text-field__input {
    font-size: 22px;
}
.root-container .input-url .unity-text-element {
    font-size: 22px;
}

/* ============================
   Dev button (small, bottom-left, unobtrusive)
   ============================ */
.root-container .btn-dev {
    position: absolute;
    bottom: 20px;
    left: 20px;
    width: 72px;
    height: 72px;
    margin: 0;
    padding: 6px 0 10px 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0.75;
}
.root-container .btn-dev:hover:enabled {
    opacity: 1;
}
.btn-dev-icon {
    width: 28px;
    height: 28px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Icons/All Icons.png#icon_gear");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(60, 54, 66);
}
.btn-dev-label {
    font-size: 22px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
