/* =================================================================
   SUNOD - town/run HUD (vc_RunProgressUI) + quest board (vc_QuestBoard)
   UI V2 (2026-11-07): built on the sn-* components from SunodTheme.tss.
   This file only lays things out and adds the few HUD-specific bits;
   colours come from the theme tokens. Motion is vc_UIAnim (C#).

   Panel units: PanelSettings is 1280x720, match height, so the screen is
   always 720 units tall. Top-right layout (right edge in, top down):
     pause (GameHUD/pause menu)  96 round, top 24, right 24   (assumed)
     day dial (.rp-ring)          96 round, top 24, right 136  + "Day N" chip under it
     zoom -/+ (.rp-zoom-row)      2 x 84 round, top 30, right 248
     right column (.rp-side)      top 152, right 24, max width ~300, ends by y ~404
   The radial skill menu owns the bottom-right ~293x293 (440 at 1080p),
   the joystick the bottom-left ~240x240; nothing here goes there.
   ================================================================= */

.rp-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.rp-hidden { display: none; }

/* full-width row that centres its child: used instead of left:50% + translate,
   so vc_UIAnim (which animates translate) never knocks things off-centre */
.rp-center-row {
    position: absolute;
    left: 0; right: 0;
    flex-direction: column;
    align-items: center;
}

/* ---------- button bits shared by every pill ---------- */
.sn-btn__label {
    font-size: 28px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    -unity-text-align: middle-left;
    color: var(--sn-ink);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}
.sn-btn .sn-btn__label { margin-left: 10px; }
.sn-btn .rp-label--solo { margin-left: 0; }
.sn-btn .rp-label--before { margin-left: 0; margin-right: 10px; }
.sn-btn--night .sn-btn__label,
.sn-btn--primary .sn-btn__label,
.sn-btn--danger .sn-btn__label { color: var(--sn-cream-hi); }
.sn-btn--gold .sn-btn__label { color: var(--sn-ink); }

/* icon slot: .sn-btn__icon holds a drawn glyph (.rp-glyph). To drop in art later, give
   .rp-icon--<key> a background-image and hide its glyph, e.g.
   .rp-icon--sleep { background-image: url("/Assets/Art/UI/Icons/sleep.png"); }
   .rp-icon--sleep .rp-glyph { display: none; }
   keys: home, sleep, talk, journal, next, energy */
.rp-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
}
.rp-glyph {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ---------- day dial (top-right, left of pause; tap = life stages) ---------- */
.rp-ring {
    position: absolute;
    top: 24px;
    right: 136px;
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
}
.rp-ring-stage {
    font-size: 28px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.rp-ring-chiprow {
    position: absolute;
    left: -24px; right: -24px;
    bottom: -22px;
    align-items: center;
}
.sn-chip.rp-ring-day {
    min-height: 40px;
    padding: 2px 14px 2px 14px;
    font-size: 22px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ---------- zoom -/+ (top bar, left of the dial) ---------- */
.rp-zoom-row {
    position: absolute;
    top: 30px;
    right: 248px;
    flex-direction: row;
}
.sn-btn.rp-zoom-btn {
    width: 84px;
    height: 84px;
    min-width: 84px;
    min-height: 84px;
    padding: 0;
    margin: 0 0 0 12px;
    border-radius: 999px;
    font-size: 40px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
}

/* ---------- right column: Back to town / Sleep / Talk + Journal / energy ---------- */
.rp-side {
    position: absolute;
    top: 152px;
    right: 24px;
    flex-direction: column;
    align-items: flex-end;
}
.sn-btn.rp-side-btn {
    min-width: 232px;
    height: 84px;
    margin: 0 0 16px 0;
    padding: 0 28px 0 22px;
    justify-content: flex-start;
}
.rp-action-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 16px;
}
.sn-btn.rp-talk-btn {
    min-width: 176px;
    margin: 0 16px 0 0;
}
.sn-btn.rp-journal-btn {
    width: 84px;
    height: 84px;
    min-width: 84px;
    min-height: 84px;
    margin: 0;
    padding: 0;
    border-radius: 999px;
}
.rp-journal-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    min-width: 32px;
    height: 32px;
    font-size: 20px;
    border-radius: 999px;
}

/* energy pill: a row of bolts (or "bolt n/max" when there are too many) */
.sn-chip.rp-energy {
    min-height: 52px;
    padding: 4px 14px 4px 12px;
}
.rp-energy-pip {
    width: 30px;
    height: 34px;
    margin: 0 2px 0 2px;
    flex-shrink: 0;
}
.rp-energy-label {
    font-size: 24px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    margin: 0 0 0 6px;
    padding: 0;
}

/* ---------- life-stage banner (opened from the dial) ---------- */
.rp-banner-row { top: 16px; }
.sn-panel.rp-banner {
    width: 900px;
    max-width: 72%;
    padding: 16px 24px 22px 24px;
    flex-direction: column;
    align-items: stretch;
}
.rp-banner-title { -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf"); }
.sn-header.rp-banner-header { justify-content: space-between; }
.sn-chip.rp-banner-day {
    font-size: 22px;
    min-height: 44px;
    white-space: nowrap;
}

.rp-stages {
    flex-direction: row;
    align-items: stretch;
}
.rp-stage-arrow {
    font-size: 28px;
    color: var(--sn-paper-line);
    -unity-text-align: middle-center;
    width: 24px;
    flex-shrink: 0;
}
.sn-card.rp-stage {
    flex-grow: 1;
    flex-basis: 0;
    padding: 10px 12px 12px 12px;
}
.sn-card.rp-stage--current {
    border-color: var(--sn-gold-dark);
    background-color: rgb(255, 242, 206);
}
.rp-stage--future { opacity: 0.6; }

.rp-stage-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.rp-stage-badge {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    flex-shrink: 0;
    font-size: 22px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-cream-hi);
    -unity-text-align: middle-center;
    background-color: var(--sn-ink-muted);
    border-radius: 999px;
    border-width: 2px;
    border-color: var(--sn-brown-dark);
}
.rp-stage--current .rp-stage-badge { background-color: var(--sn-gold-dark); }
.rp-stage--done .rp-stage-badge { background-color: var(--sn-green); border-color: var(--sn-green-dark); }
.rp-stage-badge .rp-glyph { left: 6px; top: 6px; right: 6px; bottom: 6px; }
.rp-stage-name {
    font-size: 22px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    white-space: nowrap;
    flex-shrink: 1;
}

/* segmented bar: one segment per quest, lit in that quest's RIASEC colour */
.rp-stage-bar {
    flex-direction: row;
    height: 18px;
    padding: 2px;
    background-color: var(--sn-cream-lo);
    border-width: 2px;
    border-color: var(--sn-brown);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 8px;
}
.rp-seg {
    flex-grow: 1;
    margin: 0 1px;
    border-radius: 3px;
    background-color: var(--sn-paper-line);
}
.rp-stage--done .rp-seg { background-color: var(--sn-green-hi); }
.rp-seg--R { background-color: var(--sn-R); }
.rp-seg--I { background-color: var(--sn-I); }
.rp-seg--A { background-color: var(--sn-A); }
.rp-seg--S { background-color: var(--sn-S); }
.rp-seg--E { background-color: var(--sn-E); }
.rp-seg--C { background-color: var(--sn-C); }
.rp-stage-count { font-size: 21px; }

/* the disaster at the end of the road */
.rp-storm {
    width: 48px;
    margin-left: 10px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--sn-night);
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: rgb(56, 58, 120);
    border-radius: 16px;
}
.rp-storm--near {
    background-color: var(--sn-red);
    border-color: var(--sn-red-dark);
}
.rp-storm-label {
    font-size: 30px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-cream-hi);
    -unity-text-align: middle-center;
}

.sn-btn.rp-partial-btn {
    align-self: center;
    margin: 16px 0 0 0;
}

/* ---------- day summary ---------- */
.sn-panel.rp-card {
    width: 560px;
    padding: 22px 32px 22px 32px;
    align-items: center;
}
.rp-card-title { margin-bottom: 8px; }
.rp-card-body {
    max-width: 480px;
    margin-bottom: 12px;
}
.rp-chart-caption { margin-bottom: 0; }
.rp-chart {
    width: 210px;
    height: 190px;
    margin-bottom: 8px;
}
.rp-chart-label {
    position: absolute;
    width: 20px;
    font-size: 22px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    -unity-text-align: middle-center;
}
.sn-btn.rp-card-btn {
    min-width: 260px;
    margin: 4px 0 0 0;
}

/* ---------- dream overlay (a night scene, so it stays dark) ---------- */
.rp-dream {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(14, 12, 28);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(120, 110, 170);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out-cubic;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 64px;
}
.rp-dream--shown { opacity: 1; }
.rp-dream-title {
    position: absolute;
    top: 56px;
    left: 0; right: 0;
    font-size: 30px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-gold);
    -unity-text-align: middle-center;
}
.rp-dream-text {
    width: 70%;
    max-width: 900px;
    font-size: 30px;
    color: var(--sn-cream-hi);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}
.rp-dream-hint {
    font-size: 21px;
    color: var(--sn-paper-line);
}

/* ---------- "next stage" button (top centre, gold, pulses) ---------- */
.rp-next-row { top: 152px; }
.sn-btn.rp-next-btn {
    min-width: 300px;
    margin: 0;
}

/* ---------- toast (all feedback messages) ---------- */
.rp-toast-row { top: 144px; }
.sn-chip.rp-toast {
    max-width: 640px;
    min-height: 56px;
    padding: 10px 28px 12px 28px;
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- quest done: a sheet at the top, the player can keep exploring ---------- */
.rp-done-scrim {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(46, 30, 20, 0.28);
}
.rp-done-row { top: 104px; }
.sn-panel.rp-done-toast {
    padding: 14px 32px 16px 32px;
    align-items: center;
    min-width: 360px;
}
.rp-done-title {
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-bottom: 6px;
}
.rp-done-stars {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 6px;
}
.rp-star {
    width: 48px;
    height: 48px;
    margin: 0 4px;
}
.rp-done-note {
    -unity-text-align: middle-center;
    max-width: 400px;
}
.rp-done-xp {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-green-dark);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 400px;
    margin-top: 2px;
}

/* ---------- quest timer (stars + draining bar + presses), top centre ---------- */
.rp-timer-row { top: 24px; }
.sn-panel.rp-timer {
    padding: 8px 18px 10px 18px;
    border-radius: 18px;
    align-items: center;
}
.rp-timer-stars {
    flex-direction: row;
    margin-bottom: 6px;
}
.rp-timer-star {
    width: 32px;
    height: 32px;
    margin: 0 3px;
}
.rp-timer-bar {
    width: 210px;
    height: 16px;
    background-color: var(--sn-cream-lo);
    border-width: 2px;
    border-color: var(--sn-brown);
    border-radius: 999px;
    overflow: hidden;
}
.rp-timer-fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 100%;
    background-color: var(--sn-green);
}
.rp-timer-tick {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    margin-left: -1px;
    background-color: rgba(94, 64, 44, 0.6);
}

/* presses left this quest (skill system v2) */
.rp-presses {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 6px;
}
.rp-press-dot {
    width: 16px;
    height: 16px;
    margin: 0 3px;
    border-radius: 999px;
    border-width: 2px;
    border-color: var(--sn-brown-dark);
    background-color: var(--sn-cream-lo);
}
.rp-press-dot--full { background-color: var(--sn-brown); }
.rp-press-dot--last { background-color: var(--sn-red); border-color: var(--sn-red-dark); }

/* ---------- stamp: "Perfect fit!" / "Accepted!" over the room (colour set in code) ---------- */
.rp-stamp {
    font-size: 40px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 6px 24px 8px 24px;
    border-radius: 18px;
}

/* ---------- going to bed: letterbox bars, fade, night backdrop ---------- */
.rp-letterbox {
    position: absolute;
    left: 0; right: 0;
    height: 84px;
    background-color: rgb(20, 14, 12);
    transition-property: translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out-cubic;
}
.rp-letterbox--top { top: 0; translate: 0 -100%; }
.rp-letterbox--bottom { bottom: 0; translate: 0 100%; }
.rp-letterbox--on { translate: 0 0; }

.rp-night {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(14, 12, 28);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(120, 110, 170);
}

.rp-fade {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(12, 8, 8);
    opacity: 0;
}

/* =================================================================
   Quest board + journal (vc_QuestBoard draws into this HUD's root)
   ================================================================= */
.sn-panel.qb-panel {
    width: 84%;
    max-width: 1100px;
    height: 86%;
    padding: 14px 22px 16px 22px;
}
.qb-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.qb-head-spacer { width: 72px; flex-shrink: 0; }
.qb-title { flex-grow: 1; }
.sn-btn.qb-close { margin: 0; }
.qb-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}
.sn-btn.qb-tab { min-width: 176px; margin: 0 8px 0 8px; }
.sn-btn.qb-tab--on {
    background-color: var(--sn-green-hi);
    border-color: var(--sn-green-dark);
}
.qb-list { flex-grow: 1; }
.sn-card.qb-card {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}
.qb-card-text { flex-grow: 1; flex-shrink: 1; }
.qb-name { -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf"); }
.qb-ask { color: var(--sn-ink); }
.sn-badge.qb-rec {
    align-self: flex-start;
    margin-top: 6px;
    padding: 2px 10px 2px 10px;
    font-size: 19px;
}
.sn-btn.qb-act {
    min-width: 160px;
    flex-shrink: 0;
    margin: 0 0 0 16px;
}
.qb-note { margin: 8px 0 8px 0; }
.qb-footer { margin-top: 8px; }
