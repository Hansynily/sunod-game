/* =================================================================
   SUNOD - Life-stage progress bar, end-of-day summary, dream overlay
   (vc_RunProgressUI builds the tree in code; Sprout Lands look from SunodTheme)
   ================================================================= */

.rp-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ---------- life-stage banner (opened from the corner ring) ---------- */
.rp-banner {
    position: absolute;
    top: 12px;
    left: 50%;
    translate: -50% 0;
    width: 900px;
    max-width: 70%;
    padding: 18px 26px 22px 26px;
    flex-direction: column;
    align-items: stretch;
}

.rp-banner-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}
.rp-banner-title {
    font-size: 28px;
    color: rgb(60, 54, 66);
}
.rp-banner-day {
    font-size: 21px;
    color: rgb(60, 54, 66);
    padding: 6px 14px 9px 14px;
}

/* row of stage cards: [1 Elementary] > [2 High School] > [3 College] [!] */
.rp-stages {
    flex-direction: row;
    align-items: stretch;
}
.rp-stage-arrow {
    font-size: 28px;
    color: rgb(170, 140, 105);
    -unity-text-align: middle-center;
    width: 26px;
    flex-shrink: 0;
}

.rp-stage {
    flex-grow: 1;
    flex-basis: 0;
    padding: 10px 12px 12px 12px;
    border-width: 3px;
    border-color: rgb(196, 162, 120);
    background-color: rgb(244, 228, 196);
    transition-property: opacity, scale;
    transition-duration: 0.3s;
}
.rp-stage--current {
    border-color: rgb(214, 132, 40);
    background-color: rgb(255, 238, 200);
}
.rp-stage--future {
    opacity: 0.6;
}

.rp-stage-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}
.rp-stage-badge {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    flex-shrink: 0;
    font-size: 21px;
    color: rgb(255, 248, 230);
    -unity-text-align: middle-center;
    background-color: rgb(150, 124, 100);
    border-width: 2px;
    border-color: rgb(60, 54, 66);
}
.rp-stage--current .rp-stage-badge { background-color: rgb(230, 150, 50); }
.rp-stage--done .rp-stage-badge { background-color: rgb(96, 170, 84); }
.rp-stage-name {
    font-size: 21px;
    color: rgb(60, 54, 66);
    white-space: nowrap;
    flex-shrink: 1;
}

/* segmented bar: one flush segment per quest */
.rp-stage-bar {
    flex-direction: row;
    height: 16px;
    padding: 2px;
    background-color: rgb(60, 54, 66);
    margin-bottom: 8px;
}
.rp-seg {
    flex-grow: 1;
    margin: 0 1px;
    background-color: rgb(120, 98, 82);
}
.rp-stage--done .rp-seg { background-color: rgb(150, 190, 120); }
.rp-seg--R { background-color: rgb(217, 58, 74); }
.rp-seg--I { background-color: rgb(240, 138, 36); }
.rp-seg--A { background-color: rgb(142, 79, 214); }
.rp-seg--S { background-color: rgb(47, 163, 90); }
.rp-seg--E { background-color: rgb(47, 111, 214); }
.rp-seg--C { background-color: rgb(34, 179, 196); }

.rp-stage-count {
    font-size: 14px;
    color: rgb(110, 84, 58);
}

/* the disaster at the end of the road */
.rp-storm {
    width: 46px;
    margin-left: 10px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(70, 60, 110);
    border-width: 3px;
    border-color: rgb(30, 24, 50);
}
.rp-storm--near {
    background-color: rgb(170, 50, 60);
}
.rp-storm-label {
    font-size: 28px;
    color: rgb(255, 248, 230);
    -unity-text-align: middle-center;
}

/* life-stage name chip under the corner ring */
.rp-ring-name {
    position: absolute;
    top: 74px;
    font-size: 14px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 4px 10px 6px 10px;
}

/* ---------- day summary card ---------- */
.rp-dim {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(10, 8, 20, 0.55);
    align-items: center;
    justify-content: center;
}

.rp-card {
    width: 560px;
    padding: 28px 34px 26px 34px;
    align-items: center;
}

.rp-card-title {
    font-size: 28px;
    color: rgb(60, 54, 66);
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.rp-card-body {
    font-size: 21px;
    color: rgb(60, 54, 66);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.rp-card-btn {
    min-width: 200px;
    height: 52px;
    padding: 0 22px;
}
.rp-card-btn-label {
    font-size: 21px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-center;
}

/* ---------- dream overlay ---------- */
.rp-dream {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(6, 6, 16);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(120, 110, 170);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.8s;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 70px;
}
.rp-dream--shown { opacity: 1; }

.rp-dream-title {
    position: absolute;
    top: 60px;
    left: 0; right: 0;
    font-size: 28px;
    color: rgb(200, 190, 255);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(10, 8, 20);
}

.rp-dream-text {
    width: 70%;
    font-size: 30px;
    color: rgb(240, 236, 255);
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/Art/Fonts/DotGothic16/DotGothic16-Regular.ttf");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(10, 8, 20);
    margin-bottom: 18px;
}

.rp-dream-hint {
    font-size: 14px;
    color: rgb(170, 160, 210);
}

.rp-hidden { display: none; }

/* ---------- "next stage" button (nothing left to do in this town) ---------- */
.rp-next-btn {
    position: absolute;
    top: 150px;
    left: 50%;
    translate: -50% 0;
    height: 56px;
    min-width: 300px;
    padding: 0 28px;
}

/* lightning bolt inside the energy chip */
.rp-energy-icon {
    width: 21px;
    height: 27px;
    margin-right: 8px;
    flex-shrink: 0;
    background-image: url("/Assets/Art/UI/Panels/icon_energy.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- side controls: energy, Sleep, zoom, quest "Not for me" ---------- */
.rp-side {
    position: absolute;
    top: 130px;
    right: 24px;
    flex-direction: column;
    align-items: flex-end;
}

.rp-energy {
    flex-direction: row;
    align-items: center;
    padding: 8px 18px 12px 14px;
    margin-bottom: 10px;
}
.rp-energy-label {
    font-size: 21px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.rp-side-btn {
    min-width: 170px;
    height: 52px;
    padding: 0 18px;
    margin-bottom: 10px;
}

.rp-zoom-row {
    flex-direction: row;
}

.rp-zoom-btn {
    width: 56px;
    height: 52px;
    margin-left: 8px;
}
/* at the zoom limit: greyed out so it's clear why nothing happens */
.rp-zoom-btn:disabled {
    opacity: 0.45;
}

/* ---------- progress ring (top-right, left of the pause button) ---------- */
.rp-ring {
    position: absolute;
    top: 20px;
    right: 120px;
    width: 84px;
    height: 84px;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.12s;
}
.rp-ring:active { scale: 0.94 0.94; }
.rp-ring-stage {
    font-size: 28px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-center;
    margin-top: 6px;
}
.rp-ring-day {
    font-size: 14px;
    color: rgb(130, 98, 70);
    -unity-text-align: middle-center;
    margin-top: -4px;
}

.rp-partial-btn {
    align-self: center;
    min-width: 300px;
    height: 52px;
    margin-top: 12px;
    padding: 0 20px;
}

/* ---------- toast (all feedback messages) ---------- */
.rp-toast {
    position: absolute;
    top: 118px;
    left: 50%;
    translate: -50% 0;
    max-width: 640px;
    padding: 14px 30px 20px 30px;
    font-size: 21px;
    color: rgb(60, 54, 66);
    white-space: normal;
    -unity-text-align: middle-center;
    opacity: 1;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}
.rp-toast--hidden {
    opacity: 0;
    translate: -50% -14px;
}

/* ---------- live RIASEC chart (day summary) ---------- */
.rp-chart-caption {
    font-size: 14px;
    color: rgb(130, 98, 70);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}
.rp-chart {
    width: 230px;
    height: 210px;
    margin-bottom: 16px;
}
.rp-chart-label {
    position: absolute;
    width: 20px;
    font-size: 21px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 40, 52);
}

/* ---------- quest-done panel ---------- */
.rp-done-card {
    width: 520px;
    padding-top: 30px;
}
.rp-done-ribbon {
    align-self: center;
    margin-bottom: 10px;
}
.rp-done-title {
    font-size: 28px;
    color: rgb(60, 54, 66);
    -unity-text-outline-width: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}
.rp-done-name {
    font-size: 28px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 14px;
}
.rp-done-stars {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
}
.rp-star {
    width: 56px;
    height: 56px;
    margin: 0 4px;
    background-image: url("/Assets/Art/UI/Panels/star_empty.png");
    -unity-background-scale-mode: scale-to-fit;
    scale: 0 0;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}
.rp-star--full {
    background-image: url("/Assets/Art/UI/Panels/star_full.png");
}
.rp-star--shown {
    scale: 1 1;
    opacity: 1;
}
.rp-done-note {
    font-size: 21px;
    color: rgb(168, 92, 30);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

/* ---------- juice: panels pop in, buttons squash on press ---------- */
.rp-card, .rp-banner {
    transition-property: scale, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}
.rp-pop-start {
    scale: 0.85 0.85;
    opacity: 0;
}
.rp-card-btn, .rp-side-btn, .rp-zoom-btn, .rp-next-btn, .rp-partial-btn {
    transition-property: scale, translate;
    transition-duration: 0.08s;
}
.rp-card-btn:active, .rp-side-btn:active, .rp-zoom-btn:active, .rp-next-btn:active, .rp-partial-btn:active {
    scale: 0.95 0.95;
    translate: 0 2px;
}
/* the next-stage button is centred with translate -50%; keep that while pressed, otherwise the
   button jumps half its width sideways, the release lands outside it and the click is lost */
.rp-next-btn:active, .rp-next-btn.sl-button-wide:active {
    translate: -50% 2px;
}
.rp-zoom-btn .rp-card-btn-label {
    font-size: 28px;
}

/* ---------- "do this now" glow (Sleep when the day is used up, next-stage button) ---------- */
.rp-glow {
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}
.rp-glow--hi {
    scale: 1.06 1.06;
    -unity-background-image-tint-color: rgb(255, 236, 160);
}
.rp-glow--hi .rp-card-btn-label {
    color: rgb(120, 60, 10);
}
