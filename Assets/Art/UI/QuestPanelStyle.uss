/* Quest panel sits top-left, transparent pass-through root */
.quest-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 30px;
}

/* Main panel card - Sprout Lands wood frame, 9-sliced */
.quest-panel {
    background-image: none;
    background-color: rgb(232, 207, 166);
    border-radius: 0;
    border-left-width: 4px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 8px;
    border-left-color: rgb(170, 121, 89);
    border-top-color: rgb(170, 121, 89);
    border-right-color: rgb(170, 121, 89);
    border-bottom-color: rgb(100, 85, 82);
    padding: 22px 28px 24px 28px;
    min-width: 450px;
    width: 580px;
    max-width: 580px;
}

/* Header: text block + chevron button */
.quest-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.quest-header-text {
    flex-direction: column;
    flex-grow: 1;
}

.quest-counter {
    font-size: 18px;
    color: rgb(90, 62, 38);
    -unity-text-align: upper-left;
}

.quest-title {
    font-size: 24px;
    color: rgb(60, 42, 26);
    -unity-text-align: upper-left;
    white-space: normal;
}

/* Chevron toggle button - small Sprout Lands square button */
.quest-expand-btn {
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/buttons/Square Buttons 26x26.png#sl_button");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: rgb(72, 52, 34);
    font-size: 20px;
    margin-left: 18px;
    padding: 4px 8px;
    align-self: flex-start;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}
.quest-expand-btn:active {
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/buttons/Square Buttons 26x26.png#sl_button_pressed");
}

/* Active objective row (always shown) */
.quest-current-row {
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    margin-top: 6px;
}

.quest-arrow {
    color: rgb(180, 100, 30);
    font-size: 22px;
    margin-right: 14px;
    margin-top: 2px;
}

.quest-active-label {
    font-size: 20px;
    color: rgb(60, 42, 26);
    white-space: normal;
    flex-shrink: 1;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
}

/* Divider between current row and expanded list */
.quest-divider {
    height: 1px;
    background-color: rgba(120, 85, 50, 0.4);
    margin-top: 12px;
    margin-bottom: 8px;
}

/* Expanded objectives list */
.quest-objectives-list {
    flex-direction: column;
    margin-top: 12px;
    display: none;
}

/* One row per objective */
.quest-obj-row {
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    margin-bottom: 8px;
}

/* Check/bullet icon */
.quest-obj-check {
    font-size: 20px;
    color: rgb(70, 140, 55);
    margin-right: 14px;
    margin-top: 2px;
    width: 30px;
    -unity-text-align: upper-left;
}

.quest-obj-check--pending {
    color: rgb(150, 105, 60);
}

/* Objective label text */
.quest-obj-text {
    font-size: 20px;
    color: rgb(80, 62, 46);
    white-space: normal;
    flex-shrink: 1;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
}

.quest-obj-text--done {
    color: rgb(140, 125, 110);
}

/* Feedback toast at bottom of panel */
.quest-feedback {
    font-size: 16px;
    color: rgb(180, 90, 30);
    white-space: normal;
    flex-shrink: 1;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    margin-top: 14px;
    display: none;
}

/* Neutralise Unity's default button hover/focus/disabled chrome */
.quest-expand-btn:hover, .quest-expand-btn:focus, .quest-expand-btn:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
