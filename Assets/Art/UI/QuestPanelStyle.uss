/* UI V2 quest card (2026-11-07). Surface, type and buttons come from SunodTheme.tss
   (sn-panel, sn-btn, sn-check, sn-divider, sn-body...). Only layout + quest bits live here.
   Motion is code-driven (vc_QuestHUD -> vc_UIAnim). */

/* transparent pass-through root, card sits top-left */
.quest-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 24px;
}

.quest-panel {
    width: 440px;
    max-width: 440px;
    min-width: 320px;
    padding: 14px 18px 16px 22px;
}

/* header: title block + round chevron; the whole row is the tap target */
.quest-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.quest-header-text {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.quest-counter {
    -unity-text-align: upper-left;
    margin: 0;
    padding: 0;
}

.quest-title {
    font-size: 34px;
    color: var(--sn-ink);
    -unity-text-align: upper-left;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.quest-expand-btn {
    margin: 0 0 0 12px;
    align-self: center;
}

/* chevron drawn with two borders, so no glyph is needed from the pixel font */
.quest-chevron {
    width: 16px;
    height: 16px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: var(--sn-brown);
    rotate: 45deg;
    translate: 0 -3px;
    transition-property: rotate, translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}
.quest-chevron--up {
    rotate: 225deg;
    translate: 0 4px;
}

.quest-divider {
    margin: 10px 0 12px 0;
}

/* current objective: checkbox + text */
.quest-current-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 44px;
}

.quest-arrow {
    margin: 0 14px 0 0;
    padding: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.quest-active-label {
    flex-shrink: 1;
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.quest-active-label--done {
    color: var(--sn-ink-muted);
}

/* tick inside an sn-check, shown when the box is on (two bars, flat) */
.quest-tick {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}
.sn-check--on > .quest-tick {
    display: flex;
}
.quest-tick__a, .quest-tick__b {
    position: absolute;
    height: 4px;
    background-color: var(--sn-cream-hi);
    border-radius: 2px;
}
.quest-tick__a {
    left: 3px;
    top: 15px;
    width: 10px;
    rotate: 45deg;
}
.quest-tick__b {
    left: 8px;
    top: 12px;
    width: 18px;
    rotate: -47deg;
}

/* expanded list */
.quest-objectives-list {
    flex-direction: column;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 2px;
    border-color: var(--sn-paper-line);
    display: none;
}

.quest-obj-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 8px;
}

.quest-obj-check {
    margin: 0 12px 0 0;
    padding: 0;
}

.quest-obj-text {
    font-size: 24px;
    color: var(--sn-ink);
    white-space: normal;
    flex-shrink: 1;
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.quest-obj-text--done {
    color: var(--sn-ink-muted);
    opacity: 0.75;
}

/* feedback toast inside the card (non-town scenes; towns use the HUD toast) */
.quest-feedback {
    font-size: 22px;
    color: var(--sn-ink);
    white-space: normal;
    background-color: var(--sn-cream-hi);
    border-color: var(--sn-gold-dark);
    border-width: 2px;
    border-bottom-width: 4px;
    border-radius: 14px;
    padding: 8px 14px 8px 14px;
    margin-top: 12px;
    display: none;
}
