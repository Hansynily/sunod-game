<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="CutsceneStyle.uss"/>
    <ui:VisualElement name="cutscene-root" class="cutscene-root">

        <ui:VisualElement name="stage" class="stage sn-keep"/>

        <ui:VisualElement name="fade-overlay" class="fade-overlay" picking-mode="Ignore"/>

        <!-- UI V2 story box: cream card along the bottom, tap anywhere on it to advance -->
        <ui:VisualElement name="dialog-box" class="dialog-box sn-panel">
            <ui:Label name="dialog-text" class="dialog-text" text=""/>
            <!-- "tap to go on" chevron, drawn with borders (no glyph needed) -->
            <ui:Label name="next-indicator" class="next-indicator hidden" text="" picking-mode="Ignore"/>
        </ui:VisualElement>

        <ui:Button name="btn-skip" class="btn-skip sn-btn sn-btn--small" text="Skip"/>

    </ui:VisualElement>
</ui:UXML>
