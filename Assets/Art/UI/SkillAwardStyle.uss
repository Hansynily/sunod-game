/* =================================================================
   SUNOD - Skill reward ("Pick a skill"), UI V2 2026-11-07
   Board = sn-panel, claim = sn-btn--gold (SunodTheme.tss).
   Cards are sn-card-like tiles with a RIASEC colour strip on top and a
   round icon disc ringed in the kind colour (colours set in code from
   vc_UITheme.Riasec). Card children + motion: vc_SkillAwardPopup.cs.
   ================================================================= */

.award-root {
    display: none;
}

/* ---------- BOARD ---------- */
.award-box {
    width: 1040px;
    flex-direction: column;
    align-items: center;
    padding: 16px 24px 16px 24px;
}

.award-title {
    margin-bottom: 0;
}
.award-subtitle {
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.award-cards {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    align-self: stretch;
    margin-bottom: 8px;
}

/* ---------- CARD ---------- */
.award-card {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 304px;
    min-height: 320px;
    margin: 8px 8px 8px 8px;
    padding: 0 0 12px 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-image: none;
    background-color: var(--sn-cream-hi);
    border-color: var(--sn-paper-line);
    border-width: 3px;
    border-bottom-width: 6px;
    border-radius: 18px;
    transition-property: translate, border-color, background-color, opacity;
    transition-duration: 0.16s;
    transition-timing-function: ease-out-cubic;
}
.award-card:hover, .award-card:focus, .award-card:hover:enabled {
    background-color: var(--sn-cream-hi);
}
.award-card:active {
    background-color: var(--sn-cream);
}

/* rare: gold frame */
.award-card--rare {
    border-color: var(--sn-gold-dark);
    background-color: rgb(255, 246, 220);
}
.award-card--rare:hover, .award-card--rare:focus, .award-card--rare:hover:enabled {
    background-color: rgb(255, 246, 220);
}

/* picked: lifts with a green rim */
.award-card--selected {
    translate: 0 -10px;
    border-color: var(--sn-green);
    border-bottom-color: var(--sn-green-dark);
    background-color: rgb(236, 246, 226);
}
.award-card--selected:hover, .award-card--selected:focus, .award-card--selected:hover:enabled {
    background-color: rgb(236, 246, 226);
}
.award-card--dimmed {
    opacity: 0.55;
}

/* kind strip across the top (colour set in code; cat-bg-* kept as a fallback) */
.award-cat {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    justify-content: center;
    height: 40px;
    margin-bottom: 14px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}
.award-cat-label {
    font-size: 21px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-cream-hi);
    -unity-text-align: middle-center;
}
.cat-bg-R { background-color: var(--sn-R); }
.cat-bg-I { background-color: var(--sn-I); }
.cat-bg-A { background-color: var(--sn-A); }
.cat-bg-S { background-color: var(--sn-S); }
.cat-bg-E { background-color: var(--sn-E); }
.cat-bg-C { background-color: var(--sn-C); }

/* round icon disc, ringed in the kind colour (border colour set in code) */
.award-icon-frame {
    width: 112px;
    height: 112px;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    background-color: var(--sn-cream);
    border-color: var(--sn-brown);
    border-width: 4px;
    border-bottom-width: 7px;
    border-radius: 999px;
}
.award-icon {
    width: 76px;
    height: 76px;
    -unity-background-scale-mode: scale-to-fit;
}
/* Lv badge on the disc's corner */
.award-lv {
    position: absolute;
    right: -14px;
    bottom: -8px;
    min-width: 48px;
    height: 30px;
}

.award-name {
    font-size: 28px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0 12px 0 12px;
    margin-bottom: 4px;
}
.award-desc {
    font-size: 21px;
    color: var(--sn-ink-muted);
    -unity-text-align: upper-center;
    white-space: normal;
    align-self: stretch;
    flex-grow: 1;
    padding: 0 16px 0 16px;
}

/* what taking it does: new / +XP */
.award-tag {
    font-size: 19px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: var(--sn-cream-lo);
    border-radius: 999px;
    padding: 2px 14px 2px 14px;
    margin: 8px 12px 0 12px;
}
.award-tag--dup {
    color: rgb(98, 62, 170);
    background-color: rgb(234, 224, 250);
}

/* RARE ribbon, top-right corner */
.award-rare {
    position: absolute;
    top: -12px;
    right: -10px;
    font-size: 18px;
    padding: 2px 10px 2px 10px;
    rotate: 8deg;
}

/* ---------- CLAIM ---------- */
.award-confirm {
    min-width: 360px;
    margin-top: 4px;
}

/* ---------- GOLD SHINE (built in code) ---------- */
.award-shine-clip {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
    border-radius: 19px;
}
.award-shine {
    position: absolute;
    top: -80px;
    bottom: -80px;
    left: 0;
    width: 110px;
    background-color: rgba(255, 236, 170, 0.45);
    rotate: 18deg;
    opacity: 0;
}
