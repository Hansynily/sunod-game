@import url("unity-theme://default");

/* =====================================================================================
   SUNOD UI V2 (2026-11-07): soft cozy cards. Cream rounded panels, warm brown outline,
   a thicker bottom edge for depth, green primary actions, gold highlights.
   Font: Pixelify Sans (OFL, Assets/Art/Fonts/PixelifySans).
   Spec + rules: Assets/Art/UI/UI_V2.md. Motion helpers: Scripts/UI/vc_UIAnim.cs.

   Tokens live on :root so every UIDocument (one PanelSettings, this theme) shares them.
   Old sl-* class names are kept as aliases of the new sn-* components (bottom of file).
   ===================================================================================== */

:root {
    /* surfaces */
    --sn-cream: rgb(248, 238, 216);
    --sn-cream-hi: rgb(253, 248, 236);
    --sn-cream-lo: rgb(236, 220, 190);
    --sn-paper-line: rgb(222, 200, 162);
    /* outline + text */
    --sn-brown: rgb(139, 98, 66);
    --sn-brown-dark: rgb(94, 64, 44);
    --sn-ink: rgb(74, 52, 38);
    --sn-ink-muted: rgb(140, 113, 92);
    /* actions */
    --sn-green: rgb(84, 158, 94);
    --sn-green-dark: rgb(46, 108, 60);
    --sn-green-hi: rgb(200, 232, 186);
    --sn-gold: rgb(244, 196, 80);
    --sn-gold-dark: rgb(186, 132, 34);
    --sn-red: rgb(210, 88, 74);
    --sn-red-dark: rgb(146, 50, 42);
    --sn-blue: rgb(84, 140, 212);
    --sn-blue-dark: rgb(44, 88, 150);
    --sn-night: rgb(92, 96, 170);
    /* overlays */
    --sn-scrim: rgba(46, 30, 20, 0.55);
    --sn-shadow: rgba(60, 38, 22, 0.28);
    /* RIASEC */
    --sn-R: rgb(217, 72, 80);
    --sn-I: rgb(236, 140, 46);
    --sn-A: rgb(148, 88, 214);
    --sn-S: rgb(62, 166, 96);
    --sn-E: rgb(58, 118, 214);
    --sn-C: rgb(36, 172, 190);
}

/* ---------- type ---------- */
Label, Button, TextField, DropdownField, Toggle, Slider, SliderInt, TextElement {
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Regular.ttf");
    -unity-font-style: normal;
    letter-spacing: 0.5px;
    word-spacing: 2px;
    -unity-paragraph-spacing: 6px;
    color: var(--sn-ink);
    font-size: 26px;
}
Button, .sn-semibold {
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
}
.sn-bold {
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
}
.sn-medium {
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Medium.ttf");
}

.sn-display  { font-size: 56px; -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf"); color: var(--sn-ink); }
.sn-title    { font-size: 40px; -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf"); color: var(--sn-ink); -unity-text-align: middle-center; white-space: normal; }
.sn-subtitle { font-size: 30px; -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf"); color: var(--sn-ink); white-space: normal; }
.sn-body     { font-size: 26px; color: var(--sn-ink); white-space: normal; }
.sn-caption  { font-size: 21px; color: var(--sn-ink-muted); white-space: normal; }
.sn-center   { -unity-text-align: middle-center; }
.sn-on-dark  { color: var(--sn-cream-hi); }

/* ---------- surfaces ---------- */
.sn-panel {
    background-color: var(--sn-cream);
    background-image: none;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 7px;
    border-radius: 22px;
    padding: 18px 22px 18px 22px;
}
.sn-panel--hi { background-color: var(--sn-cream-hi); }
.sn-panel--dark {
    background-color: rgba(70, 48, 34, 0.92);
    border-color: var(--sn-brown-dark);
}
.sn-panel--dark Label { color: var(--sn-cream-hi); }

.sn-card {
    background-color: var(--sn-cream-hi);
    background-image: none;
    border-color: var(--sn-paper-line);
    border-width: 2px;
    border-bottom-width: 4px;
    border-radius: 16px;
    padding: 12px 16px 12px 16px;
}
.sn-card--selected {
    border-color: var(--sn-green);
    background-color: rgb(236, 246, 226);
}

/* full-screen modal: scrim behind a centred sheet */
.sn-scrim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--sn-scrim);
    align-items: center;
    justify-content: center;
}
.sn-sheet {
    max-width: 92%;
    max-height: 92%;
}

/* header strip on a panel (title row with a divider under it) */
.sn-header {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 2px;
    border-color: var(--sn-paper-line);
    padding-bottom: 10px;
    margin-bottom: 12px;
}
.sn-divider {
    height: 2px;
    background-color: var(--sn-paper-line);
    margin: 10px 0 10px 0;
    flex-shrink: 0;
}

/* ---------- buttons ---------- */
.sn-btn {
    background-color: var(--sn-cream);
    background-image: none;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 7px;
    border-radius: 999px;
    color: var(--sn-ink);
    font-size: 28px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    -unity-text-align: middle-center;
    padding: 6px 28px 6px 28px;
    margin: 8px;
    min-height: 84px;
    min-width: 84px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: scale, translate, border-bottom-width, background-color;
    transition-duration: 0.08s, 0.08s, 0.08s, 0.15s;
    transition-timing-function: ease-out-cubic;
}
.sn-btn:hover:enabled { background-color: var(--sn-cream-hi); }
.sn-btn:active:enabled {
    scale: 0.96 0.96;
    translate: 0 4px;
    border-bottom-width: 3px;
}
.sn-btn:focus { background-color: var(--sn-cream); }
.sn-btn:disabled { opacity: 0.5; }

.sn-btn--primary {
    background-color: var(--sn-green);
    border-color: var(--sn-green-dark);
    color: var(--sn-cream-hi);
}
.sn-btn--primary:hover:enabled, .sn-btn--primary:focus { background-color: rgb(96, 172, 106); }
.sn-btn--gold {
    background-color: var(--sn-gold);
    border-color: var(--sn-gold-dark);
    color: var(--sn-ink);
}
.sn-btn--gold:hover:enabled, .sn-btn--gold:focus { background-color: rgb(250, 208, 104); }
.sn-btn--danger {
    background-color: var(--sn-red);
    border-color: var(--sn-red-dark);
    color: var(--sn-cream-hi);
}
.sn-btn--danger:hover:enabled, .sn-btn--danger:focus { background-color: rgb(222, 104, 90); }
.sn-btn--night {
    background-color: var(--sn-night);
    border-color: rgb(56, 58, 120);
    color: var(--sn-cream-hi);
}
.sn-btn--night:hover:enabled, .sn-btn--night:focus { background-color: rgb(108, 112, 188); }
.sn-btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--sn-ink-muted);
    min-height: 64px;
}
.sn-btn--ghost:hover:enabled, .sn-btn--ghost:focus { background-color: rgba(139, 98, 66, 0.08); }
.sn-btn--ghost:active:enabled { border-bottom-width: 0; }
.sn-btn--small { min-height: 64px; font-size: 22px; padding: 4px 18px 4px 18px; border-bottom-width: 5px; }
.sn-btn--wide { width: 100%; max-width: 560px; }
/* round icon button (pause, close, zoom) */
.sn-btn--icon {
    width: 96px; height: 96px;
    min-width: 96px; min-height: 96px;
    padding: 0;
    border-radius: 999px;
}
.sn-btn--icon-sm {
    width: 72px; height: 72px;
    min-width: 72px; min-height: 72px;
    padding: 0;
    border-radius: 999px;
    border-bottom-width: 5px;
}
.sn-btn__icon {
    width: 44px; height: 44px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}
.sn-btn__label { margin-left: 10px; }

/* attention: a soft gold ring that breathes (class toggled by vc_UIAnim.Pulse or code) */
.sn-attn {
    border-color: var(--sn-gold-dark);
    background-color: rgb(255, 236, 178);
}

/* ---------- small things ---------- */
.sn-chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--sn-cream);
    background-image: none;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 5px;
    border-radius: 999px;
    padding: 4px 16px 4px 16px;
    min-height: 52px;
    font-size: 24px;
}
.sn-badge {
    background-color: var(--sn-green-dark);
    color: var(--sn-cream-hi);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--sn-cream-hi);
    padding: 0 8px 0 8px;
    font-size: 18px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    -unity-text-align: middle-center;
}
.sn-badge--gold { background-color: var(--sn-gold); color: var(--sn-ink); border-color: var(--sn-gold-dark); }
.sn-badge--silver { background-color: rgb(206, 214, 228); color: var(--sn-ink); border-color: rgb(120, 130, 150); }

.sn-progress {
    height: 22px;
    background-color: var(--sn-cream-lo);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-radius: 999px;
    overflow: hidden;
    padding: 0;
}
.sn-progress__fill {
    height: 100%;
    background-color: var(--sn-green);
    border-radius: 999px;
    transition-property: width;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}

.sn-check {
    width: 34px; height: 34px;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-radius: 8px;
    background-color: var(--sn-cream-hi);
    flex-shrink: 0;
}
.sn-check--on { background-color: var(--sn-green); border-color: var(--sn-green-dark); }

/* ---------- motion helpers (USS transitions for show/hide by class) ---------- */
.sn-fade {
    transition-property: opacity, scale, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}
.sn-fade--out { opacity: 0; scale: 0.94 0.94; }

/* ---------- Unity controls, themed ---------- */
TextField, .unity-text-field { min-height: 84px; font-size: 28px; margin: 6px 0 6px 0; }
.unity-base-field__label { color: var(--sn-ink); font-size: 24px; min-width: 0; }
.unity-text-field__input, .unity-base-text-field__input {
    min-height: 76px;
    font-size: 28px;
    padding: 8px 18px 8px 18px;
    background-color: var(--sn-cream-hi);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-radius: 18px;
    color: var(--sn-ink);
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}
.unity-base-text-field:focus > .unity-base-text-field__input,
.unity-text-field:focus .unity-text-field__input {
    border-color: var(--sn-green);
    background-color: rgb(255, 252, 244);
}
.unity-text-element--inner-input-field-component, .unity-text-input { color: var(--sn-ink); }

.unity-toggle { min-height: 64px; }
.unity-toggle__checkmark {
    width: 40px; height: 40px;
    background-color: var(--sn-cream-hi);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-radius: 10px;
    -unity-background-image-tint-color: var(--sn-green-dark);
}
.unity-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark,
.unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--sn-green);
    border-color: var(--sn-green-dark);
    -unity-background-image-tint-color: var(--sn-cream-hi);
}

.unity-base-slider__tracker {
    height: 16px;
    margin-top: -8px;
    background-color: var(--sn-cream-lo);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-radius: 999px;
}
.unity-base-slider__dragger {
    width: 44px; height: 44px;
    min-width: 44px; min-height: 44px;
    margin-top: -22px;
    background-color: var(--sn-green);
    border-color: var(--sn-green-dark);
    border-width: 3px;
    border-bottom-width: 5px;
    border-radius: 999px;
}
.unity-base-slider__dragger-border { display: none; }
.unity-slider__dragger { min-width: 44px; min-height: 44px; }

.unity-scroller--vertical { width: 14px; }
.unity-scroller .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-scroller .unity-base-slider__dragger {
    width: 10px; height: auto; min-width: 10px; min-height: 40px; margin-top: 0;
    background-color: var(--sn-paper-line); border-width: 0; border-radius: 999px;
}
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }

.unity-base-popup-field__input, .unity-popup-field__input {
    background-color: var(--sn-cream-hi);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-radius: 16px;
    min-height: 64px;
    color: var(--sn-ink);
}

/* open dropdown list (drawn on its own layer, so only the theme can style it) */
.unity-base-dropdown__container-outer {
    background-color: var(--sn-cream-hi);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-radius: 16px;
}
.unity-base-dropdown__container-inner { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-base-dropdown__item { min-height: 64px; padding: 0 12px 0 12px; }
.unity-base-dropdown__label { font-size: 26px; color: var(--sn-ink); }
.unity-base-dropdown__item:hover, .unity-base-dropdown__item:checked {
    background-color: var(--sn-green-hi);
}
.unity-base-dropdown__checkmark { -unity-background-image-tint-color: var(--sn-green-dark); }

.unity-button { justify-content: center; }
/* kill the default theme's grey hover/focus chrome on every button */
.unity-button:hover:enabled, .unity-button:focus { -unity-background-image-tint-color: rgb(255, 255, 255); }

/* =====================================================================================
   Legacy aliases: old sl-* markup picks up the V2 look automatically.
   New code uses sn-* directly (see UI_V2.md).
   ===================================================================================== */
.sl-panel-wood, .sl-dialog {
    background-color: var(--sn-cream);
    background-image: none;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 7px;
    border-radius: 22px;
    -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0;
}
.sl-panel-cream, .sl-slot {
    background-color: var(--sn-cream-hi);
    background-image: none;
    border-color: var(--sn-paper-line);
    border-width: 2px;
    border-bottom-width: 4px;
    border-radius: 16px;
    -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0;
}
.sl-panel-dark {
    background-color: rgba(70, 48, 34, 0.92);
    background-image: none;
    border-color: var(--sn-brown-dark);
    border-width: 3px;
    border-bottom-width: 7px;
    border-radius: 22px;
    -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0;
}
.sl-button, .sl-button-wide {
    background-color: var(--sn-cream);
    background-image: none;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 7px;
    border-radius: 999px;
    color: var(--sn-ink);
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0;
    min-height: 84px;
    min-width: 84px;
    transition-property: scale, translate, border-bottom-width, background-color;
    transition-duration: 0.08s, 0.08s, 0.08s, 0.15s;
    transition-timing-function: ease-out-cubic;
}
.sl-button:hover:enabled, .sl-button-wide:hover:enabled { background-color: var(--sn-cream-hi); }
.sl-button:active:enabled, .sl-button-wide:active:enabled {
    background-image: none;
    scale: 0.96 0.96;
    translate: 0 4px;
    border-bottom-width: 3px;
}
.sl-button:focus, .sl-button-wide:focus { background-color: var(--sn-cream); }
.sl-button:disabled, .sl-button-wide:disabled { opacity: 0.5; }
.sl-chip {
    background-color: var(--sn-cream);
    background-image: none;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 5px;
    border-radius: 999px;
    -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0;
}
.sl-bar-bg {
    background-color: var(--sn-cream-lo);
    background-image: none;
    border-color: var(--sn-brown);
    border-width: 3px;
    border-radius: 999px;
    -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0;
}
.sl-icon { -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.sl-text-outline { -unity-text-outline-width: 0; }
.sl-ribbon {
    font-size: 36px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-center;
    white-space: normal;
    align-self: center;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: var(--sn-gold);
    padding: 0 18px 6px 18px;
}
