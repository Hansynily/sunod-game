@import url("unity-theme://default");

/* Panels/buttons: original SUNOD art v2 (Assets/Art/UI/Panels/make_ui_v2.py).
   Font: DotGothic16, the mixed-case pixel font the cutscenes use (the Sprout Lands font was
   caps-only). Letter/word/paragraph spacing keep text from crowding. */
Label, Button, TextField, DropdownField {
    -unity-font-definition: url("/Assets/Art/Fonts/DotGothic16/DotGothic16-Regular.ttf");
    letter-spacing: 1px;
    word-spacing: 4px;
    -unity-paragraph-spacing: 6px;
}

/* ============================
   SUNOD shared panel look (class names kept as sl-* for compatibility).
   Panels, buttons, slots, dialog and bar art are ORIGINAL SUNOD pixel art in
   Assets/Art/UI/Panels/ (generated by make_panels.py, palette matched to the old pack).
   Only the Sprout Lands pixel FONT is still used.
   Reused by MainMenu / Login / Dialog / Pause / EndScene / HUD / Quest / Inventory USS.
   Font sizes stay multiples of 14 (14/28/42/56) so the pixel font stays crisp.
   ============================ */
.sl-panel-wood {
    background-image: url("/Assets/Art/UI/Panels/panel_wood.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 1px;
}

.sl-panel-dark {
    background-image: url("/Assets/Art/UI/Panels/panel_dark.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.sl-panel-cream {
    background-image: url("/Assets/Art/UI/Panels/panel_cream.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.sl-slot {
    background-image: url("/Assets/Art/UI/Panels/slot.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
}

.sl-dialog {
    background-image: url("/Assets/Art/UI/Panels/dialog.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.sl-button {
    background-image: url("/Assets/Art/UI/Panels/button.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    transition-property: background-image, translate, scale;
    transition-duration: 0.05s;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}
.sl-button:active {
    background-image: url("/Assets/Art/UI/Panels/button_pressed.png");
}
.sl-button:disabled {
    -unity-background-image-tint-color: rgb(150, 150, 150);
    opacity: 0.6;
}

.sl-button-wide {
    background-image: url("/Assets/Art/UI/Panels/button_wide.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    transition-property: background-image, translate, scale;
    transition-duration: 0.05s;
    -unity-slice-left: 8;
    -unity-slice-top: 6;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}
.sl-button-wide:active {
    background-image: url("/Assets/Art/UI/Panels/button_wide_pressed.png");
}
.sl-button-wide:disabled {
    -unity-background-image-tint-color: rgb(150, 150, 150);
    opacity: 0.6;
}

.sl-bar-bg {
    background-image: url("/Assets/Art/UI/Panels/bar_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    -unity-slice-left: 3;
    -unity-slice-top: 3;
    -unity-slice-right: 3;
    -unity-slice-bottom: 3;
    -unity-slice-scale: 1px;
}

.sl-icon {
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}
.sl-text-outline {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(46, 34, 24);
}

/* Neutralise Unity's default button hover/focus chrome (the default theme tints the
   image grey on :hover:enabled, which is the "weird hover" - press feedback is enough) */
.sl-button:hover, .sl-button:focus, .sl-button:disabled,
.sl-button:hover:enabled, .sl-button:focus:enabled,
.sl-button-wide:hover, .sl-button-wide:focus, .sl-button-wide:disabled,
.sl-button-wide:hover:enabled, .sl-button-wide:focus:enabled,
.unity-button.sl-button:hover:enabled, .unity-button.sl-button-wide:hover:enabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* small HUD info chip (e.g. "Energy 4/4") */
.sl-chip {
    background-image: url("/Assets/Art/UI/Panels/chip.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    -unity-slice-left: 5;
    -unity-slice-top: 5;
    -unity-slice-right: 5;
    -unity-slice-bottom: 5;
    -unity-slice-scale: 1px;
}


/* ---------- juice: every themed button squashes a little when pressed ---------- */
.sl-button:active, .sl-button-wide:active {
    scale: 0.96 0.96;
    translate: 0 2px;
}

/* gold swallowtail title ribbon (dialog titles, "done" banners, result header) */
.sl-ribbon {
    font-size: 28px;
    color: rgb(72, 52, 34);
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 2px;
    align-self: center;
    background-image: none;
    background-color: rgba(0,0,0,0);
    -unity-text-outline-width: 0;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgb(210, 150, 64);
    padding: 0 18px 6px 18px;
}
