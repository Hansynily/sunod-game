/* =================================================================
   SUNOD - Dialog / speech card (UI V2, 2026-11-07)
   Cream sn-panel card, name tag chip on the top-left edge, body text,
   buttons right-aligned with the primary on the right.
   Scrim colour + motion live in vc_DialogPanel.cs (vc_UIAnim).
   ================================================================= */

/* ---------- ROOT (scrim) ----------
   Hidden by default. Backdrop colour is set in code: clear for
   narration (ShowMessage), dimmed for choices (ShowChoice). */
.dialog-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 24px;
    display: none;
}

/* ---------- CARD ---------- */
.dialog-box {
    min-width: 560px;
    max-width: 820px;
    padding: 36px 28px 16px 28px;
    flex-direction: column;
    align-items: stretch;
    margin-top: 28px;          /* room for the name tag above the card */
}

/* ---------- NAME TAG (title) ---------- */
.dialog-title {
    position: absolute;
    top: -30px;
    left: 24px;
    max-width: 80%;
    background-color: var(--sn-gold);
    border-color: var(--sn-brown);
    border-width: 3px;
    border-bottom-width: 5px;
    border-radius: 999px;
    padding: 2px 22px 2px 22px;
    min-height: 52px;
    font-size: 26px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---------- OPTIONAL ICON ---------- */
.dialog-icon {
    width: 104px;
    height: 104px;
    align-self: center;
    background-color: var(--sn-cream-hi);
    border-color: var(--sn-paper-line);
    border-width: 3px;
    border-bottom-width: 5px;
    border-radius: 999px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 12px;
}

/* ---------- divider (unused, kept for code lookup) ---------- */
.dialog-divider {
    height: 2px;
    background-color: var(--sn-paper-line);
    margin-bottom: 12px;
    flex-shrink: 0;
}

/* ---------- BODY TEXT ---------- */
.dialog-body {
    -unity-text-align: upper-left;
    max-width: 720px;
    margin: 4px 4px 16px 4px;
}
.dialog-body--intro {
    margin-bottom: 12px;
}

/* ---------- ALIGNED LIST (ShowList): badge | name | detail ---------- */
.dialog-list {
    align-self: flex-start;
    margin: 0 4px 16px 4px;
}
.dialog-list-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.dialog-list-badge {
    width: 40px;
    height: 40px;
    margin-right: 16px;
    font-size: 22px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-Bold.ttf");
    color: var(--sn-cream-hi);
    -unity-text-align: middle-center;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: rgba(74, 52, 38, 0.55);
    border-radius: 999px;
    padding: 0;
}
.dialog-list-name {
    width: 200px;
    font-size: 24px;
    -unity-font-definition: url("/Assets/Art/Fonts/PixelifySans/PixelifySans-SemiBold.ttf");
    color: var(--sn-ink);
    -unity-text-align: middle-left;
    padding: 0;
}
.dialog-list-detail {
    font-size: 22px;
    color: var(--sn-ink-muted);
    -unity-text-align: middle-left;
    padding: 0;
}

/* ---------- BUTTON ROW (right-aligned, primary on the right) ---------- */
.dialog-button-row {
    flex-direction: row-reverse;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
}
.dialog-btn {
    min-width: 168px;
    margin: 8px 0 8px 16px;
}
.dialog-confirm-btn {
    margin-right: 0;
}
/* third choice ("Not for me" etc.): quiet ghost button */
.dialog-third-btn {
    min-width: 0;
}
