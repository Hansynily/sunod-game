/* =================================================================
   SUNOD — Dialog / Notice Panel
   Navy + gold palette — matches QuestPanel & InventoryPanel.
   Full-screen overlay root; centered card styled as a board notice.
   ================================================================= */

/* ---------- OVERLAY ROOT ----------
   Hidden by default (display:none). Backdrop colour is set
   in vc_DialogPanel.cs — transparent for ShowMessage, dimmed
   for ShowChoice. Flex centres the card. */
.dialog-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

/* ---------- CENTERED CARD (the "board notice") ---------- */
.dialog-box {
    min-width: 420px;
    max-width: 560px;
    background-color: rgb(14, 20, 42);
    border-color: rgb(201, 151, 59);
    border-width: 4px;
    border-radius: 20px;
    padding: 32px 36px 28px 36px;
    flex-direction: column;
    align-items: stretch;

    /* Layered inner glow — gives the notice-board depth */
    --unity-slice-left: 0;
    --unity-slice-right: 0;
    --unity-slice-top: 0;
    --unity-slice-bottom: 0;
}

/* ---------- OPTIONAL ICON ---------- */
.dialog-icon {
    width: 72px;
    height: 72px;
    align-self: center;
    background-color: rgb(10, 14, 30);
    border-color: rgb(201, 151, 59);
    border-width: 3px;
    border-radius: 6px;
    margin-bottom: 18px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- TITLE ---------- */
.dialog-title {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 26px;
    color: rgb(245, 168, 35);
    -unity-text-align: upper-center;
    white-space: normal;
    letter-spacing: 3px;
    margin-bottom: 14px;
}

/* ---------- TITLE / BODY DIVIDER ---------- */
.dialog-divider {
    height: 2px;
    background-color: rgb(201, 151, 59);
    opacity: 0.40;
    margin-bottom: 18px;
    flex-shrink: 0;
}

/* ---------- BODY TEXT ---------- */
.dialog-body {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Regular.ttf");
    font-size: 18px;
    color: rgb(220, 215, 240);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 28px;
    flex-grow: 1;
}

/* ---------- BUTTON ROW ---------- */
.dialog-button-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

/* ---------- SHARED BUTTON BASE ---------- */
.dialog-btn {
    -unity-font-definition: url("../Fonts/Silkscreen/Silkscreen-Bold.ttf");
    font-size: 14px;
    border-width: 2px;
    border-radius: 8px;
    padding: 10px 28px;
    min-width: 120px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.12s;
}

/* ---------- CONFIRM BUTTON (primary / gold) ---------- */
.dialog-confirm-btn {
    background-color: rgb(120, 80, 14);
    border-color: rgb(245, 168, 35);
    color: rgb(255, 240, 180);
    margin-right: 18px;
}
.dialog-confirm-btn:hover  { background-color: rgb(152, 104, 22); }
.dialog-confirm-btn:active { background-color: rgb(90, 60, 10);   }

/* ---------- CANCEL BUTTON (secondary / muted) ---------- */
.dialog-cancel-btn {
    background-color: rgb(28, 40, 72);
    border-color: rgb(60, 80, 120);
    color: rgb(140, 155, 185);
}
.dialog-cancel-btn:hover  { background-color: rgb(38, 54, 92);  }
.dialog-cancel-btn:active { background-color: rgb(18, 28, 56);  }
