/* =================================================================
   SUNOD — Dialog / Notice Panel
   Sprout Lands speech-bubble card, warm wood/cream palette.
   Full-screen overlay root; centered card styled as a board notice.
   ================================================================= */

/* ---------- OVERLAY ROOT ----------
   Hidden by default (display:none). Backdrop colour is set
   in vc_DialogPanel.cs — transparent for ShowMessage, dimmed
   for ShowChoice. Flex centres the card. */
.dialog-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

/* ---------- CENTERED CARD (Sprout Lands dialog frame, 9-sliced) ---------- */
.dialog-box {
    min-width: 720px;
    max-width: 900px;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Dialouge UI/dialog box.png#sl_dialog");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 48px 56px 44px 68px;
    flex-direction: column;
    align-items: stretch;
    -unity-slice-left: 10;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}

/* ---------- OPTIONAL ICON ---------- */
.dialog-icon {
    width: 96px;
    height: 96px;
    align-self: center;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Sprite sheet for Basic Pack.png#sl_slot");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    margin-bottom: 18px;
    padding: 8px;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}

/* ---------- TITLE (small wood tab on top) ---------- */
.dialog-title {
    font-size: 28px;
    color: rgb(255, 245, 225);
    -unity-text-align: upper-center;
    white-space: normal;
    letter-spacing: 2px;
    margin-bottom: 14px;
    align-self: center;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/Setting menu.png#sl_panel_wood");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 10px 32px;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 2px;
}

/* ---------- TITLE / BODY DIVIDER ---------- */
.dialog-divider {
    height: 2px;
    background-color: rgb(150, 105, 60);
    opacity: 0.40;
    margin-bottom: 18px;
    flex-shrink: 0;
}

/* ---------- BODY TEXT ---------- */
.dialog-body {
    font-size: 24px;
    color: rgb(72, 52, 34);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 28px;
    flex-grow: 1;
}

/* ---------- BUTTON ROW ---------- */
.dialog-button-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

/* ---------- SHARED BUTTON BASE (Sprout Lands square button) ---------- */
.dialog-btn {
    font-size: 22px;
    padding: 18px 40px;
    min-width: 200px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/buttons/Square Buttons 26x26.png#sl_button");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}
.dialog-btn:active {
    background-image: url("/Assets/Art/Packs/Sprout Lands - UI Pack - Basic pack/Sprite sheets/buttons/Square Buttons 26x26.png#sl_button_pressed");
}

/* ---------- CONFIRM BUTTON (primary) ---------- */
.dialog-confirm-btn {
    color: rgb(72, 52, 34);
    margin-right: 18px;
}

/* ---------- CANCEL BUTTON (secondary / muted) ---------- */
.dialog-cancel-btn {
    color: rgb(90, 75, 60);
    -unity-background-image-tint-color: rgb(210, 210, 210);
}

/* Neutralise Unity's default button hover/focus/disabled chrome */
.dialog-btn:hover, .dialog-btn:focus, .dialog-btn:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
