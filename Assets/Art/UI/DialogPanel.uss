/* =================================================================
   SUNOD — Dialog / Notice Panel
   Sprout Lands speech-bubble card, warm wood/cream palette.
   Full-screen overlay root; centered card styled as a board notice.
   ================================================================= */

/* ---------- OVERLAY ROOT ----------
   Hidden by default (display:none). Backdrop colour is set
   in vc_DialogPanel.cs — transparent for ShowMessage, dimmed
   for ShowChoice. Flex centres the card. */
.dialog-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

/* ---------- CENTERED CARD (SUNOD v2 dialog frame, 9-sliced) ---------- */
.dialog-box {
    min-width: 560px;
    max-width: 820px;
    background-image: url("/Assets/Art/UI/Panels/dialog.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 36px 52px 36px 52px;
    flex-direction: column;
    align-items: stretch;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

/* ---------- OPTIONAL ICON ---------- */
.dialog-icon {
    width: 96px;
    height: 96px;
    align-self: center;
    background-image: url("/Assets/Art/UI/Panels/slot.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    margin-bottom: 18px;
    padding: 8px;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
}

/* ---------- TITLE (small wood tab on top) ---------- */
.dialog-title {
    font-size: 28px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 2px;
    align-self: center;
    background-image: none;
    background-color: rgba(0,0,0,0);
    -unity-text-outline-width: 0;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgb(210, 150, 64);
    padding: 0 18px 6px 18px;
    margin-bottom: 16px;
}

/* ---------- TITLE / BODY DIVIDER ---------- */
.dialog-divider {
    height: 2px;
    background-color: rgb(150, 105, 60);
    opacity: 0.40;
    margin-bottom: 18px;
    flex-shrink: 0;
}

/* ---------- BODY TEXT ---------- */
.dialog-body {
    font-size: 24px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 28px;
}
.dialog-body--intro {
    margin-bottom: 14px;
}

/* ---------- ALIGNED LIST (ShowList): badge | name | detail, columns line up ---------- */
.dialog-list {
    align-self: center;
    margin-bottom: 26px;
}
.dialog-list-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.dialog-list-badge {
    width: 34px;
    height: 34px;
    margin-right: 14px;
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(42, 40, 52);
    border-width: 2px;
    border-color: rgb(60, 54, 66);
    padding: 0;
}
.dialog-list-name {
    width: 190px;
    font-size: 22px;
    color: rgb(60, 54, 66);
    -unity-text-align: middle-left;
    padding: 0;
}
.dialog-list-detail {
    font-size: 22px;
    color: rgb(110, 90, 70);
    -unity-text-align: middle-left;
    padding: 0;
}

/* ---------- BUTTON ROW ---------- */
.dialog-button-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

/* ---------- SHARED BUTTON BASE (Sprout Lands square button) ---------- */
.dialog-btn {
    font-size: 22px;
    padding: 18px 40px;
    min-width: 180px;
    margin: 0 9px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    background-image: url("/Assets/Art/UI/Panels/button.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    transition-property: translate;
    transition-duration: 0.05s;
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}
.dialog-btn:active {
    background-image: url("/Assets/Art/UI/Panels/button_pressed.png");
}

/* ---------- CONFIRM BUTTON (primary) ---------- */
.dialog-confirm-btn {
    color: rgb(60, 54, 66);
}

/* ---------- CANCEL BUTTON (secondary / muted) ---------- */
.dialog-cancel-btn {
    color: rgb(90, 75, 60);
    -unity-background-image-tint-color: rgb(210, 210, 210);
}

/* Neutralise Unity's default button hover/focus/disabled chrome */
.dialog-btn:hover, .dialog-btn:focus, .dialog-btn:disabled {
    background-color: rgba(0,0,0,0);
    border-width: 0;
}
