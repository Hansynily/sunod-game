<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="DialogPanel.uss" />

    <!-- UI V2 speech card. Full-screen root (scrim colour set in code: clear for
         narration, dimmed for choices); hidden by default. -->
    <ui:VisualElement name="dialog-root" class="dialog-root">

        <!-- The card -->
        <ui:VisualElement name="dialog-box" class="dialog-box sn-panel">

            <!-- Name tag chip riding the top-left edge (hidden when there's no title) -->
            <ui:Label name="dialog-title" text="" class="dialog-title" picking-mode="Ignore" />

            <!-- Optional skill icon; hidden when no sprite is supplied -->
            <ui:VisualElement name="dialog-icon" class="dialog-icon" />

            <!-- Kept for code that looks it up; hidden by vc_DialogPanel -->
            <ui:VisualElement class="dialog-divider" picking-mode="Ignore" />

            <!-- Body copy -->
            <ui:Label name="dialog-body" text="" class="dialog-body sn-body" picking-mode="Ignore" />

            <!-- Buttons, right-aligned. row-reverse: the first one (confirm, primary) sits on the right -->
            <ui:VisualElement name="dialog-button-row" class="dialog-button-row">
                <ui:Button name="dialog-confirm-btn" class="dialog-btn dialog-confirm-btn sn-btn sn-btn--primary" text="Continue" />
                <ui:Button name="dialog-cancel-btn"  class="dialog-btn dialog-cancel-btn sn-btn"  text="Cancel" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
