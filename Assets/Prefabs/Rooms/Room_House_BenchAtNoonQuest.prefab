  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::vc_QuestRoom
  questLogic: {fileID: 8872449801865654064}
  questId: s8_bench
  questName: The Bench at Noon
  primaryRiasec: S
  questionCode: S8
  objectiveText: Get the three of them through their afternoon.
  questDescription: Three of the old ones have been on the bench since the service
    let out. Each is waiting for something before she can start home, and the heat
    is not helping any of them.
  questHints:
  - Take them one at a time - each needs something different before she can stand.
  - Or walk the three of them down to the road together.
  nextQuestId: 
  lockType: 0
  requiredSkillTag: 
  isExposureEligible: 0
  requiredComboTags: []
  solvableWithTags:
  - heal
  - guide
