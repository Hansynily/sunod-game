  questLogic: {fileID: 8638495008633876683}
  questId: s1_after
  questName: What Comes After
  primaryRiasec: S
  questionCode: S1
  objectiveText: Help Divina work out what comes next.
  questDescription: School ends this week and Divina still has no answer for anyone
    who asks what she will do after. She has been sitting outside the classroom since
    morning.
  questHints:
  - She does not need advice yet - she needs to know what the work actually asks
    of her.
  - Or take her to someone who does it for a living.
  nextQuestId: 
  lockType: 0
  requiredSkillTag: 
  isExposureEligible: 0
  requiredComboTags: []
  solvableWithTags:
  - teach
  - guide
