  questLogic: {fileID: 1532360884636908770}
  questId: c6_till
  questName: Closing the Till
  primaryRiasec: C
  questionCode: C6
  objectiveText: Balance the till before closing.
  questDescription: The canteen is shut and the till still has to be counted. The
    receipts are spiked on the counter, and the total written in the book does not
    match the cash in the drawer.
  questHints:
  - Run the receipts through again - the total in the book is wrong.
  - Or square the cash away once the number is right.
  nextQuestId: 
  lockType: 0
  requiredSkillTag: 
  isExposureEligible: 0
  requiredComboTags: []
  solvableWithTags:
  - inspect
  - direct
