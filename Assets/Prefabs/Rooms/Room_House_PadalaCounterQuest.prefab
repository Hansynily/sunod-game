  questId: c7_padala
  questName: The Padala Counter
  primaryRiasec: C
  questionCode: C7
  objectiveText: Put the customer's money through properly.
  questDescription: Someone is at the counter to send money home. The form is half
    filled in, the amount on it does not match what they handed over, and none of
    it has been logged yet.
  questHints:
  - Read the form back before any money moves.
  - Or get it logged and filed under the right name.
  nextQuestId: 
  lockType: 0
  requiredSkillTag: 
  isExposureEligible: 0
  requiredComboTags: []
  solvableWithTags:
  - inspect
  - direct
