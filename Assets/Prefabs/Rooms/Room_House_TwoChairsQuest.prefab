  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::vc_QuestRoom
  questLogic: {fileID: 3253661566677776379}
  questId: s5_chairs
  questName: Two Chairs
  primaryRiasec: S
  questionCode: S5
  objectiveText: Get the two of them back in the same room.
  questDescription: Aling Rosa has not spoken to her son since the argument over
    the land. He has been sleeping at his cousin's for a week, and she still sets
    his plate out every night.
  questHints:
  - She has carried this a week on her own. Sit with her first.
  - Or go to the cousin's and bring him home - he has been waiting to be asked.
  nextQuestId: 
  lockType: 0
  requiredSkillTag: 
  isExposureEligible: 0
  requiredComboTags: []
  solvableWithTags:
  - heal
  - guide
