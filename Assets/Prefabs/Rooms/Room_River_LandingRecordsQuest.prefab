  questId: c8_landing
  questName: The Landing Book
  primaryRiasec: C
  questionCode: C8
  objectiveText: Get everything on the landing into the book.
  questDescription: Cargo has been coming off the boats all morning and going straight
    back out again, and not one sack of it has been written down.
  questHints:
  - Walk the whole landing - nothing gets recorded from one spot.
  - Or go through what is already stacked and check it against the book.
  nextQuestId: 
  lockType: 0
  requiredSkillTag: 
  isExposureEligible: 0
  requiredComboTags: []
  solvableWithTags:
