  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::vc_QuestRoom
  questLogic: {fileID: 3569463137646428479}
  questId: c2_inventory
  questName: The Stockroom Count
  primaryRiasec: C
  questionCode: C2
  objectiveText: Count what's actually on the shelves.
  questDescription: The stockroom hasn't been counted in months. The tally sheet
    says one thing and the shelves say another, and nobody knows which to believe.
  questHints:
  - Count it shelf by shelf - the back row counts too.
  - Or check the old tally against what's really there.
  nextQuestId: 
  lockType: 0
  requiredSkillTag: 
  isExposureEligible: 0
  requiredComboTags: []
  solvableWithTags:
  - collect
  - inspect
  - direct
