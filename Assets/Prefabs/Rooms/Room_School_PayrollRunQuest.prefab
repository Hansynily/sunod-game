  questId: c1_payroll
  questName: The Payroll Run
  primaryRiasec: C
  questionCode: C1
  objectiveText: Get the month's payroll out.
  questDescription: End of the month and nobody's been paid. The timesheets are still
    in loose piles on the office desk, and not one of them has been checked against
    the hours.
  questHints:
  - The timesheets are scattered across the desk - gather them first.
  - Or go straight to the hours; someone logged them wrong.
  nextQuestId: 
  lockType: 0
  requiredSkillTag: 
  isExposureEligible: 0
  requiredComboTags: []
  solvableWithTags:
  - collect
  - inspect
  - direct
